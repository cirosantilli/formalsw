#!/usr/bin/env python3
"""Bump the minor version, push the branch and tag, and publish to PyPI."""

from pathlib import Path
import re
import shlex
import subprocess
import sys
import tomllib


REPO = Path(__file__).resolve().parent


def run(*command, capture_stdout=False):
    print('+ ' + shlex.join(command), flush=True)
    return subprocess.run(command, cwd=REPO, check=True, text=True,
                          stdout=subprocess.PIPE if capture_stdout else None).stdout


def git_output(*arguments):
    return run('git', *arguments, capture_stdout=True).strip()


def main():
    if len(sys.argv) != 1:
        raise ValueError('usage: ./release')
    # Forbid untracked files.
    #if git_output('status', '--porcelain', '--untracked-files=all'):
    #    raise ValueError('commit or stash working tree changes before releasing')
    branch = git_output('symbolic-ref', '--quiet', '--short', 'HEAD')

    project = REPO / 'pyproject.toml'
    lake = REPO / 'lakefile.toml'
    version = tomllib.loads(project.read_text())['project']['version']
    if not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version):
        raise ValueError(f'expected a major.minor.patch version, got {version!r}')
    if tomllib.loads(lake.read_text())['version'] != version:
        raise ValueError('pyproject.toml and lakefile.toml versions must match')
    major, minor, _ = map(int, version.split('.'))
    new_version = f'{major}.{minor + 1}.0'
    tag = f'v{new_version}'
    if git_output('tag', '--list', tag):
        raise ValueError(f'tag {tag} already exists')

    # Prepare both edits before writing either file; preserve comments and formatting.
    edits = []
    for path in (project, lake):
        text, count = re.subn(
            rf'(?m)^(version\s*=\s*[\"\']){re.escape(version)}([\"\'])',
            lambda match: match[1] + new_version + match[2], path.read_text(),
        )
        if count != 1:
            raise ValueError(f'expected one version assignment in {path.name}')
        edits.append((path, text))
    for path, text in edits:
        path.write_text(text)

    run('git', 'add', '--', 'pyproject.toml', 'lakefile.toml')
    run('git', 'commit', '-m', f'Release {new_version}')
    run('git', 'tag', '-a', tag, '-m', f'Release {new_version}')
    run('git', 'push', '--atomic', 'origin', f'HEAD:refs/heads/{branch}', f'refs/tags/{tag}')
    run(sys.executable, '-m', 'build')
    source = f'dist/formalsw-{new_version}.tar.gz'
    wheel = f'dist/formalsw-{new_version}-py3-none-any.whl'
    run(sys.executable, '-m', 'twine', 'check', '--strict', source, wheel)
    run(sys.executable, 'tests/package_checks', wheel)
    run(sys.executable, '-m', 'twine', 'upload', '--username', '__token__', source, wheel)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f'error: {error}', file=sys.stderr)
        sys.exit(1)

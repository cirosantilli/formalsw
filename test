#!/usr/bin/env python3
"""Run cleanxyz's end-to-end tests."""

from __future__ import annotations

import json
import subprocess
import sys
import textwrap
import time
from dataclasses import dataclass
from pathlib import Path


REPO = Path(__file__).resolve().parent
CLEANXYZ = REPO / "cleanxyz"


@dataclass(frozen=True)
class TestCase:
    """One cleanxyz subprocess-backed test case."""

    name: str
    source: Path
    expected_returncode: int
    expected_output: str | None = None


@dataclass(frozen=True)
class TestResult:
    """The result of one subprocess-backed test."""

    case: TestCase
    passed: bool
    command: list[str]
    returncode: int
    stdout: str
    stderr: str
    elapsed: float


def run_cleanxyz(source: Path) -> subprocess.CompletedProcess[str]:
    """Run cleanxyz on a repo-relative source path."""
    return subprocess.run(
        [str(CLEANXYZ), str(source)],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def run_case(case: TestCase) -> TestResult:
    """Run one test case and compare status plus optional diagnostic text."""
    start = time.perf_counter()
    completed = run_cleanxyz(case.source)
    elapsed = time.perf_counter() - start
    output = completed.stdout + completed.stderr
    passed = completed.returncode == case.expected_returncode
    if case.expected_output is not None:
        passed = passed and case.expected_output in output
    return TestResult(
        case=case,
        passed=passed,
        command=completed.args,
        returncode=completed.returncode,
        stdout=completed.stdout,
        stderr=completed.stderr,
        elapsed=elapsed,
    )


def print_result(result: TestResult) -> None:
    """Print one test result, including diagnostics for failures."""
    status = "PASS" if result.passed else "FAIL"
    print(f"{status} {result.case.source} ({result.elapsed:.2f}s)", flush=True)
    if result.passed:
        return
    print(f"  command: {' '.join(result.command)}")
    print(f"  exit: {result.returncode}")
    print(f"  expected exit: {result.case.expected_returncode}")
    if result.case.expected_output is not None:
        print(f"  expected output: {result.case.expected_output}")
    if result.stdout:
        print("  stdout:")
        print(textwrap.indent(result.stdout.rstrip(), "    "))
    if result.stderr:
        print("  stderr:")
        print(textwrap.indent(result.stderr.rstrip(), "    "))


def main() -> int:
    """Run all tests and return a process exit status."""
    cases = [
        TestCase("range_sum passes", Path("tests/pass/range_sum.py"), 0),
        TestCase("sorts are equivalent with proved costs", Path("tests/pass/sort.py"), 0),
        TestCase("equivalent throws pass", Path("tests/pass/equiv_throw.py"), 0),
        TestCase("Throws can be proved", Path("tests/pass/throws.py"), 0),
        TestCase("annotations restrict comparison inputs", Path("tests/pass/typing.py"), 0),
        TestCase("raw Lean requirement passes", Path("tests/pass/raw_lean.py"), 0),
        TestCase(
            "sorrys are rejected",
            Path("tests/fail/sorry.py"),
            1,
            "declaration uses `sorry`",
        ),
        TestCase(
            "unproven properties are rejected",
            Path("tests/fail/missing_required.py"),
            1,
            "missing proof",
        ),
        TestCase(
            "missing proof files are rejected",
            Path("tests/fail/missing_lean.py"),
            1,
            "missing proof file",
        ),
        TestCase(
            "directories check all Python files",
            Path("tests/fail/dir"),
            1,
            "tests/fail/dir/fail.py",
        ),
    ]
    results = []
    for case in cases:
        print(f"RUN  {case.source}", flush=True)
        result = run_case(case)
        results.append(result)
        print_result(result)

    stub_completed = subprocess.run(
        [str(CLEANXYZ), "--stub", "tests/pass/range_sum.py"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    stub_passed = (
        stub_completed.returncode == 0
        and not stub_completed.stderr
        and 'import «.cleanxyz».tests.pass.«range_sum.py.ast»' in stub_completed.stdout
        and "theorem Tests.Pass.RangeSum.sum_equiv_sumNaive :" in stub_completed.stdout
        and "theorem Tests.Pass.RangeSum.sum_bigO :" in stub_completed.stdout
        and stub_completed.stdout.count("  sorry") == 4
    )
    print(f"{'PASS' if stub_passed else 'FAIL'} Lean proof stub generation", flush=True)

    ast_json_path = REPO / ".cleanxyz/tests/pass/range_sum.py.ast.json"
    ast_bridge_path = REPO / ".cleanxyz/tests/pass/range_sum.py.ast.lean"
    try:
        ast_document = json.loads(ast_json_path.read_text())
        json_ast_passed = (
            ast_document["schema_version"] == 1
            and ast_document["ast"]["type"] == "Module"
            and ast_document["ast"]["body"][1]["type"] == "FunctionDef"
            and "pyast_from_json%" in ast_bridge_path.read_text()
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError, IndexError, TypeError):
        json_ast_passed = False
    print(
        f"{'PASS' if json_ast_passed else 'FAIL'} generated JSON AST import",
        flush=True,
    )
    source_tree_clean = not any((REPO / "tests").rglob("*.olean"))
    print(
        f"{'PASS' if source_tree_clean else 'FAIL'} no Lean objects in source tree",
        flush=True,
    )
    return 0 if (
        all(result.passed for result in results)
        and stub_passed
        and json_ast_passed
        and source_tree_clean
    ) else 1


if __name__ == "__main__":
    sys.exit(main())

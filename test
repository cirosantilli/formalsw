"""Run formalsw's end-to-end tests."""

from __future__ import annotations

import json
import re
import subprocess
import sys
import textwrap
import time
from dataclasses import dataclass
from pathlib import Path


REPO = Path(__file__).resolve().parent
FORMALSW = REPO / "formalsw"


@dataclass(frozen=True)
class TestCase:
    """One formalsw subprocess-backed test case."""

    name: str
    source: Path
    expected_returncode: int
    expected_output: str | tuple[str, ...] | None = None


@dataclass(frozen=True)
class TestResult:
    """The result of one subprocess-backed test."""

    case: TestCase
    passed: bool
    command: list[str]
    returncode: int
    stdout: str
    stderr: str
    elapsed: float


def run_formalsw(source: Path) -> subprocess.CompletedProcess[str]:
    """Run formalsw on a repo-relative source path."""
    return subprocess.run(
        [str(FORMALSW), str(source)],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def run_case(case: TestCase) -> TestResult:
    """Run one test case and compare status plus optional diagnostic text."""
    start = time.perf_counter()
    completed = run_formalsw(case.source)
    elapsed = time.perf_counter() - start
    output = completed.stdout + completed.stderr
    passed = completed.returncode == case.expected_returncode
    if case.expected_output is not None:
        expected = (case.expected_output,) if isinstance(case.expected_output, str) else case.expected_output
        passed = passed and all(fragment in output for fragment in expected)
    return TestResult(
        case=case,
        passed=passed,
        command=completed.args,
        returncode=completed.returncode,
        stdout=completed.stdout,
        stderr=completed.stderr,
        elapsed=elapsed,
    )


def print_result(result: TestResult) -> None:
    """Print one test result, including diagnostics for failures."""
    status = "PASS" if result.passed else "FAIL"
    print(f"{status} {result.case.source} ({result.elapsed:.2f}s)", flush=True)
    if result.passed:
        return
    print(f"  command: {' '.join(result.command)}")
    print(f"  exit: {result.returncode}")
    print(f"  expected exit: {result.case.expected_returncode}")
    if result.case.expected_output is not None:
        print(f"  expected output: {result.case.expected_output}")
    if result.stdout:
        print("  stdout:")
        print(textwrap.indent(result.stdout.rstrip(), "    "))
    if result.stderr:
        print("  stderr:")
        print(textwrap.indent(result.stderr.rstrip(), "    "))



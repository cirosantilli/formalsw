#!/usr/bin/env python3
"""Run cleanxy's end-to-end tests."""

from __future__ import annotations

import json
import subprocess
import sys
import textwrap
import time
from dataclasses import dataclass
from pathlib import Path


REPO = Path(__file__).resolve().parent
CLEANXY = REPO / "cleanxy"


@dataclass(frozen=True)
class TestCase:
    """One cleanxy subprocess-backed test case."""

    name: str
    source: Path
    expected_returncode: int
    expected_output: str | None = None


@dataclass(frozen=True)
class TestResult:
    """The result of one subprocess-backed test."""

    case: TestCase
    passed: bool
    command: list[str]
    returncode: int
    stdout: str
    stderr: str
    elapsed: float


def run_cleanxy(source: Path) -> subprocess.CompletedProcess[str]:
    """Run cleanxy on a repo-relative source path."""
    return subprocess.run(
        [str(CLEANXY), str(source)],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def run_case(case: TestCase) -> TestResult:
    """Run one test case and compare status plus optional diagnostic text."""
    start = time.perf_counter()
    completed = run_cleanxy(case.source)
    elapsed = time.perf_counter() - start
    output = completed.stdout + completed.stderr
    passed = completed.returncode == case.expected_returncode
    if case.expected_output is not None:
        passed = passed and case.expected_output in output
    return TestResult(
        case=case,
        passed=passed,
        command=completed.args,
        returncode=completed.returncode,
        stdout=completed.stdout,
        stderr=completed.stderr,
        elapsed=elapsed,
    )


def print_result(result: TestResult) -> None:
    """Print one test result, including diagnostics for failures."""
    status = "PASS" if result.passed else "FAIL"
    print(f"{status} {result.case.source} ({result.elapsed:.2f}s)", flush=True)
    if result.passed:
        return
    print(f"  command: {' '.join(result.command)}")
    print(f"  exit: {result.returncode}")
    print(f"  expected exit: {result.case.expected_returncode}")
    if result.case.expected_output is not None:
        print(f"  expected output: {result.case.expected_output}")
    if result.stdout:
        print("  stdout:")
        print(textwrap.indent(result.stdout.rstrip(), "    "))
    if result.stderr:
        print("  stderr:")
        print(textwrap.indent(result.stderr.rstrip(), "    "))


def main() -> int:
    """Run all tests and return a process exit status."""
    cases = [
        TestCase("termination and divergence", Path("tests/py/termination.py"), 0),
        TestCase("range_sum passes", Path("tests/py/range_sum.py"), 0),
        TestCase("typed, object, and return sort equivalence", Path("tests/py/sort.py"), 0),
        TestCase("equivalent throws pass", Path("tests/py/equiv_throw.py"), 0),
        TestCase("Throws can be proved", Path("tests/py/throws.py"), 0),
        TestCase("annotations restrict comparison inputs", Path("tests/py/typing.py"), 0),
        TestCase("raw Lean requirement passes", Path("tests/py/raw_lean.py"), 0),
        TestCase(
            "this_function rejects unsupported arity",
            Path("tests/py/fail/this_function_arity.py"),
            1,
            "this_function supports positional arguments without variadics",
        ),
        TestCase(
            "this_function rejects unsupported argument annotations",
            Path("tests/py/fail/this_function_annotation.py"),
            1,
            "this_function supports scalar int/str/bool arguments or one bare list",
        ),
        TestCase(
            "sorrys are rejected",
            Path("tests/py/fail/sorry.py"),
            1,
            "declaration uses `sorry`",
        ),
        TestCase(
            "unproven properties are rejected",
            Path("tests/py/fail/missing_required.py"),
            1,
            "missing proof",
        ),
        TestCase(
            "missing proof files are rejected",
            Path("tests/py/fail/missing_lean.py"),
            1,
            "missing proof file",
        ),
        TestCase(
            "directories check all Python files",
            Path("tests/py/fail/dir"),
            1,
            "tests/py/fail/dir/fail.py",
        ),
    ]
    for builtin_model in sorted(Path("lang/py/builtin/type").glob("*.py")):
        cases.append(TestCase(f"plain-Python builtin model {builtin_model.stem}", builtin_model, 0))
    cases.append(TestCase(
        "plain-Python builtin function model",
        Path("lang/py/builtin/function.py"),
        0,
    ))
    results = []
    for case in cases:
        print(f"RUN  {case.source}", flush=True)
        result = run_case(case)
        results.append(result)
        print_result(result)

    stub_completed = subprocess.run(
        [str(CLEANXY), "--stub", "tests/py/range_sum.py"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    stub_passed = (
        stub_completed.returncode == 0
        and not stub_completed.stderr
        and 'import «.cleanxy».tests.py.«range_sum.py.ast»' in stub_completed.stdout
        and "namespace tests.py.range_sum" in stub_completed.stdout
        and "theorem sum.«Equiv(sum_naive)» :" in stub_completed.stdout
        and "theorem sum.«BigO(1)» :" in stub_completed.stdout
        and "theorem sum.«ReturnType» :" in stub_completed.stdout
        and "theorem sum_naive.«Returns» :" in stub_completed.stdout
        and "theorem sum_naive.«BigO(n)» :" in stub_completed.stdout
        and "end tests.py.range_sum" in stub_completed.stdout
        and stub_completed.stdout.count("  sorry") == 5
    )
    print(f"{'PASS' if stub_passed else 'FAIL'} Lean proof stub generation", flush=True)

    ast_json_path = REPO / ".cleanxy/tests/py/range_sum.py.ast.json"
    ast_bridge_path = REPO / ".cleanxy/tests/py/range_sum.py.ast.lean"
    sort_ast_json_path = REPO / ".cleanxy/tests/py/sort.py.ast.json"
    try:
        ast_document = json.loads(ast_json_path.read_text())
        sort_ast_document = json.loads(sort_ast_json_path.read_text())
        json_ast_passed = (
            ast_document["schema_version"] == 1
            and ast_document["ast"]["type"] == "Module"
            and ast_document["ast"]["body"][1]["type"] == "FunctionDef"
            and "pyast_from_json%" in ast_bridge_path.read_text()
            and any(
                statement.get("type") == "ClassDef"
                and statement.get("name") == "str"
                for statement in sort_ast_document["ast"]["body"]
            )
        )
    except (FileNotFoundError, json.JSONDecodeError, KeyError, IndexError, TypeError):
        json_ast_passed = False
    print(
        f"{'PASS' if json_ast_passed else 'FAIL'} generated JSON AST import",
        flush=True,
    )
    source_tree_clean = not any((REPO / "tests/py").rglob("*.olean"))
    print(
        f"{'PASS' if source_tree_clean else 'FAIL'} no Lean objects in source tree",
        flush=True,
    )
    builtin_coverage = subprocess.run(
        [sys.executable, "tests/py/builtin_coverage"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    builtin_coverage_passed = builtin_coverage.returncode == 0
    print(
        f"{'PASS' if builtin_coverage_passed else 'FAIL'} builtin documentation coverage",
        flush=True,
    )
    if not builtin_coverage_passed:
        if builtin_coverage.stdout:
            print(textwrap.indent(builtin_coverage.stdout.rstrip(), "  "))
        if builtin_coverage.stderr:
            print(textwrap.indent(builtin_coverage.stderr.rstrip(), "  "))
    builtin_models = subprocess.run(
        ["lake", "env", "lean", "tests/py/builtin_models.lean"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    builtin_models_passed = builtin_models.returncode == 0
    print(
        f"{'PASS' if builtin_models_passed else 'FAIL'} builtin model behavior",
        flush=True,
    )
    if not builtin_models_passed:
        output = builtin_models.stdout + builtin_models.stderr
        if output:
            print(textwrap.indent(output.rstrip(), "  "))
    throws_syntax = subprocess.run(
        ["lake", "env", "lean", "-DwarningAsError=true", "tests/py/throws_syntax.lean"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    throws_syntax_passed = throws_syntax.returncode == 0
    print(
        f"{'PASS' if throws_syntax_passed else 'FAIL'} Throws, Returns, and Halts syntax",
        flush=True,
    )
    if not throws_syntax_passed:
        output = throws_syntax.stdout + throws_syntax.stderr
        if output:
            print(textwrap.indent(output.rstrip(), "  "))
    builtin_python_models = subprocess.run(
        [sys.executable, "tests/py/builtin_python_models.py"],
        cwd=REPO,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    builtin_python_models_passed = builtin_python_models.returncode == 0
    print(
        f"{'PASS' if builtin_python_models_passed else 'FAIL'} plain-Python builtin behavior",
        flush=True,
    )
    if not builtin_python_models_passed:
        output = builtin_python_models.stdout + builtin_python_models.stderr
        if output:
            print(textwrap.indent(output.rstrip(), "  "))
    return 0 if (
        all(result.passed for result in results)
        and stub_passed
        and json_ast_passed
        and source_tree_clean
        and builtin_coverage_passed
        and builtin_models_passed
        and throws_syntax_passed
        and builtin_python_models_passed
    ) else 1


if __name__ == "__main__":
    sys.exit(main())

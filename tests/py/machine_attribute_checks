#!/usr/bin/env python3
"""
Check field aliases and method binding before argument-side mutation.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
class Reader:
    def read(self, ignored):
        return self.link

def shadow(reader):
    reader.read = 0
    return 0

def invoke(reader):
    return reader.read(shadow(reader))

def inline(reader):
    shadow(reader)
    return reader.link

def missing_method(reader):
    return reader.absent(shadow(reader))
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation HeapCalls.Framing
namespace MachineAttributeExamples
set_option Elab.async false

def classInfo := (Probe.module.findClass "Reader").getD ("", [])
def args : List Arg := [{name := "self", annotation := none}, {name := "ignored", annotation := none}]
def body : List Stmt := [.return (.attribute (.name "self") "link")]
def shadowArgs : List Arg := [{name := "reader", annotation := none}]
def shadowBody : List Stmt := [.assign [.attribute (.name "reader") "read"] (.constant (.int 0)),
  .return (.constant (.int 0))]
def invokeBody : List Stmt := [.return (.call (.attribute (.name "reader") "read")
  [.call (.name "shadow") [.name "reader"]])]
def afterShadow (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value)) :=
  heap.set address (.instance classInfo.1 "Reader" (Mutable.putField fields "read" (.scalar (.int 0))))

theorem source_class : Probe.module.findClass "Reader" = some classInfo := rfl
theorem source_method : findFunctionIn classInfo.2 "read" = some (args, body) := rfl
theorem source_shadow : findFunctionIn Probe.module.body "shadow" = some (shadowArgs, shadowBody) := rfl
theorem source_invoke : findFunctionIn Probe.module.body "invoke" = some (shadowArgs, invokeBody) := rfl

theorem method_source : ∀ statement ∈ body, StmtWithin 0 statement :=
  findFunctionIn_within 0 classInfo.2 "read" args body
    (findClass_within 0 Probe.module "Reader" classInfo.1 classInfo.2
      (by simp [Probe.module, StmtWithin]) source_class) source_method

theorem method_bound (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "read" = none) :
    bindMethod Probe.module (.ref address) "read" heap = some (.ok (.method (.ref address) args body), heap) := by
  simp [bindMethod, found, instanceClass, source_class, absent, source_method]

theorem method_returns (heap : Mutable.Heap) (address : Nat) (ignored shared : Mutable.Value)
    (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (linked : fields.lookup "link" = some shared) :
    MethodReturns Probe.module (.ref address) args body [ignored] heap shared heap := by
  apply MethodReturns.of_body (completed := [.ref address, ignored]) rfl
  apply BlockReturns.return_value
  apply Evaluates.field (Evaluates.lookup (value := .ref address) (by simp [functionEnv, HeapCalls.argumentEnv, args]))
  simp [getAttribute, found, instanceClass, source_class, linked]

theorem shadow_returns (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields)) :
    ReturnsValue Probe.module "shadow" [.ref address] heap (.scalar (.int 0)) (afterShadow heap address fields) := by
  apply BlockReturns.function source_shadow (completed := [.ref address]) rfl
  apply BlockContinues.returns (body := [shadowBody[0]'(by decide)])
  · apply BlockContinues.setAttribute Evaluates.constant
      (Evaluates.lookup (value := .ref address) (by simp [functionEnv, HeapCalls.argumentEnv, shadowArgs]))
    exact Mutable.writeField_result found (by simp)
  · exact BlockReturns.return_value Evaluates.constant

/-- The argument overwrites read, but the already captured method still returns the linked object. -/
theorem invoke_returns (heap : Mutable.Heap) (address : Nat) (shared : Mutable.Value)
    (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "read" = none) (linked : fields.lookup "link" = some shared) :
    ReturnsValue Probe.module "invoke" [.ref address] heap shared (afterShadow heap address fields) := by
  have reader : functionEnv shadowArgs invokeBody [.ref address] [] "reader" = some (.ref address) := by
    simp [functionEnv, HeapCalls.argumentEnv, shadowArgs]
  have inside : address < heap.length := (List.getElem?_eq_some_iff.mp found).1
  have changed : (afterShadow heap address fields)[address]? =
      some (.instance classInfo.1 "Reader" (Mutable.putField fields "read" (.scalar (.int 0)))) := by
    simp [afterShadow, inside]
  apply BlockReturns.function source_invoke (completed := [.ref address]) rfl
  apply BlockReturns.return_value
  apply Evaluates.method reader (by decide) (method_bound heap address fields found absent)
  · exact .cons (Evaluates.call (.cons (Evaluates.lookup reader) .nil) (shadow_returns heap address fields found)) .nil
  · exact method_returns _ address (.scalar (.int 0)) shared _ changed
      (by simpa only [Mutable.putField_lookup_other fields "read" "link" _ (by decide)] using linked)

/-- Both complete calls retain the same shared result and argument-side mutation. -/
theorem paired_invocations (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (shared : Mutable.Value)
    (fields : List (String × Mutable.Value))
    (found : logical[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "read" = none) (linked : fields.lookup "link" = some shared) :
    let mapped := fields.map fun field => (field.1, relocateValue rename field.2)
    ReturnsValue Probe.module "invoke" [.ref address] logical shared (afterShadow logical address fields) ∧
      ReturnsValue Probe.module "invoke" [.ref (rename address)] physical (relocateValue rename shared)
        (afterShadow physical (rename address) mapped) ∧
      ExecutionLayout (afterShadow logical address fields) (afterShadow physical (rename address) mapped) rename := by
  dsimp only
  have moved := layout.runtime.lookup address _ found
  simp only [relocateObject] at moved
  have otherAbsent := fields_lookup_relocate rename fields "read"
  have otherLinked := fields_lookup_relocate rename fields "link"
  rw [absent] at otherAbsent
  rw [linked] at otherLinked
  have inside : (Mutable.Value.ref address).edge.Within logical.length := (List.getElem?_eq_some_iff.mp found).1
  obtain ⟨other, paired, retained, _, _⟩ := layout.writeField (.ref address) "read" (.scalar (.int 0))
    inside (by trivial) _ _ (Mutable.writeField_result found (by simp))
  have expected := Mutable.writeField_result (value := .scalar (.int 0)) moved (name := "read") (by simp)
  change Mutable.writeField (.ref (rename address)) "read" (.scalar (.int 0)) physical =
    some (.ok (.scalar .none), other) at paired
  have same : afterShadow physical (rename address)
      (fields.map fun field => (field.1, relocateValue rename field.2)) = other := by
    simpa only [expected, Option.map_some, Option.some.injEq, afterShadow] using
      congrArg (Option.map Prod.snd) paired
  rw [← same] at retained
  exact ⟨invoke_returns logical address shared fields found absent linked,
    invoke_returns physical (rename address) (relocateValue rename shared) _ moved otherAbsent otherLinked, retained⟩

/-- The source-method rule derives the other machine step under arbitrary saved callers. -/
theorem paired_binding (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (logicalAnchors physicalAnchors address : Nat)
    (fields : List (String × Mutable.Value)) (expressions : List Expr) (env : HeapCalls.Env)
    (stack : List Frame) (globals : Mutable.Globals)
    (found : logical[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "read" = none) (envInside : EnvWithin logical.length env)
    (stackInside : ∀ frame ∈ stack, FrameWithin logical.length frame)
    (globalsInside : GlobalsWithin logical.length globals) :
    HeapCalls.step Probe.module physicalAnchors
        (relocateState rename physical ⟨.value (.ref address), .methodReceiver "read" expressions env :: stack, logical⟩)
        (relocateGlobals rename globals) =
      relocateStep rename physical physicalAnchors
        (HeapCalls.step Probe.module logicalAnchors
          ⟨.value (.ref address), .methodReceiver "read" expressions env :: stack, logical⟩ globals) ∧
      StepWithin (HeapCalls.step Probe.module logicalAnchors
        ⟨.value (.ref address), .methodReceiver "read" expressions env :: stack, logical⟩ globals) :=
  step_source_methodReceiver_relocates Probe.module logical physical rename layout logicalAnchors physicalAnchors
    (.ref address) "read" args body expressions env stack globals (List.getElem?_eq_some_iff.mp found).1
    envInside stackInside globalsInside method_source
    (method_bound logical address fields found absent)

theorem shadowed_binding (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (stored : Mutable.Value) (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (shadowed : fields.lookup "read" = some stored) :
    bindMethod Probe.module (.ref address) "read" heap = some (.ok .notCallable, heap) := by
  simp [bindMethod, found, instanceClass, source_class, shadowed]

/-- Fields cannot bypass the nominal class-origin check. -/
theorem wrong_origin (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (origin : String) (different : classInfo.1 ≠ origin)
    (found : heap[address]? = some (.instance origin "Reader" fields)) :
    getAttribute Probe.module (.ref address) "link" heap = none ∧
      bindMethod Probe.module (.ref address) "read" heap = none := by
  simp [getAttribute, bindMethod, found, instanceClass, source_class, different, Mutable.unsupported]

theorem reverse_binding (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    bindMethod Probe.module (.ref address) "$formalsw.sort.reverse" heap = some (.ok (.sortReverse address), heap) := by
  simp [bindMethod, found]

theorem inline_returns (heap : Mutable.Heap) (address : Nat) (shared : Mutable.Value)
    (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (linked : fields.lookup "link" = some shared) :
    ReturnsValue Probe.module "inline" [.ref address] heap shared (afterShadow heap address fields) := by
  have bound := (List.getElem?_eq_some_iff.mp found).1
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard
    (Evaluates.call (.cons (Evaluates.lookup rfl) .nil) (shadow_returns heap address fields found))
  apply BlockReturns.return_value
  apply Evaluates.field (Evaluates.lookup rfl)
  simp [getAttribute, afterShadow, bound, instanceClass, source_class,
    Mutable.putField_lookup_other fields "read" "link" _ (by decide), linked]

/-- Method lookup precedes the argument that shadows its name; the captured method still executes. -/
theorem invoke_equiv (heap : Mutable.Heap) (address : Nat) (shared : Mutable.Value)
    (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "read" = none) (linked : fields.lookup "link" = some shared) :
    (IteratorCalls.call Probe.module "invoke" [.ref address] heap).Equiv
      (IteratorCalls.call Probe.module "inline" [.ref address] heap) := by
  have finishes (name : String) (choices : ChoiceSchedule)
      (returned : ReturnsValue Probe.module name [.ref address] heap shared (afterShadow heap address fields)) :
      ((IteratorCalls.call Probe.module name [.ref address] heap).run choices).Finishes
        ⟨.ok shared, [], afterShadow heap address fields, heap.length⟩ := by
    have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returned heap.length []) []
    exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))
  intro leftChoices rightChoices
  exact Mutable.Call.equiv_of_finishes
    (finishes "invoke" leftChoices (invoke_returns heap address shared fields found absent linked))
    (finishes "inline" rightChoices (inline_returns heap address shared fields found linked)) (Or.inl rfl)

/-- A missing method fails during binding, before the argument can shadow read. -/
theorem missing_method_finishes (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (absent : fields.lookup "absent" = none) :
    (HeapCalls.call Probe.module "missing_method" [.ref address] heap).Finishes
      ⟨.error ⟨"AttributeError", []⟩, [], heap, heap.length⟩ := by
  have failed : bindMethod Probe.module (.ref address) "absent" heap =
      some (.error ⟨"AttributeError", []⟩, heap) := by
    have missing : findFunctionIn classInfo.2 "absent" = none := rfl
    simp [bindMethod, found, instanceClass, source_class, absent, missing, Mutable.error]
  change Finishes (step := HeapCalls.step Probe.module heap.length) _ _
  repeat' apply Finishes.next (step := HeapCalls.step Probe.module heap.length) rfl
  exact .done (by simp [HeapCalls.step, HeapCalls.run, failed, HeapCalls.done,
    protectGenerator, Frame.inGenerator, Calls.generatorException])

/-- A shadowing integer is rejected only after the argument has performed its field write. -/
theorem shadowed_call_finishes (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (stored : Int) (found : heap[address]? = some (.instance classInfo.1 "Reader" fields))
    (shadowed : fields.lookup "read" = some (.scalar (.int stored))) :
    (HeapCalls.call Probe.module "invoke" [.ref address] heap).Finishes
      ⟨.error ⟨"TypeError", []⟩, [], afterShadow heap address fields, heap.length⟩ := by
  let env := functionEnv shadowArgs invokeBody [.ref address] []
  have reader : env "reader" = some (.ref address) := rfl
  have bound := shadowed_binding heap address fields (.scalar (.int stored)) found shadowed
  have argument : Evaluates Probe.module env (.call (.name "shadow") [.name "reader"])
      heap (.scalar (.int 0)) (afterShadow heap address fields) :=
    Evaluates.call (.cons (Evaluates.lookup reader) .nil) (shadow_returns heap address fields found)
  change Finishes (step := HeapCalls.step Probe.module heap.length) _ _
  repeat' apply Finishes.next (step := HeapCalls.step Probe.module heap.length) rfl
  apply Finishes.next (following := ⟨.expr (.call (.name "shadow") [.name "reader"]) env,
    [.arguments .notCallable [] [] env], heap⟩)
    (by simp [HeapCalls.step, HeapCalls.run, bound, argumentsState]; rfl)
  exact (argument heap.length [.arguments .notCallable [] [] env]).finishes (.next rfl (.done rfl))

def afterBindingWrite (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (value : Mutable.Value) := heap.set address (.instance classInfo.1 "Reader" (Mutable.putField fields "read" value))

/-- Binding consumes the write's derived invariant, including saved consumers and cyclic field values. -/
theorem write_then_bind (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (fields : List (String × Mutable.Value))
    (replacement : Mutable.Value) (expressions : List Expr) (used : Nat) (choices : ChoiceSchedule)
    (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.instance classInfo.1 "Reader" fields))
    (replacementInside : replacement.edge.Within logical.length)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    ∃ other nextMap,
      (∀ old < logical.length, nextMap old = rename old) ∧
      ExecutionLayout (afterBindingWrite logical address fields replacement) other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.setField "read" replacement) [.ref address], [], logical⟩) =
        .next (relocateState nextMap other
          ⟨.value (.scalar .none), [], afterBindingWrite logical address fields replacement⟩) ∧
      IteratorCalls.Relocation.Preserves (afterBindingWrite logical address fields replacement) other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices
          (.running ⟨⟨.value (.ref address), [.methodReceiver "read" expressions (fun _ => none)],
            afterBindingWrite logical address fields replacement⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length
            (.running ⟨⟨.value (.ref address), [.methodReceiver "read" expressions (fun _ => none)],
              afterBindingWrite logical address fields replacement⟩, used⟩ resumes))) := by
  have addressInside := (List.getElem?_eq_some_iff.mp found).1
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have inside : StateWithin ⟨.operation (.setField "read" replacement) [.ref address], [], logical⟩ := by
    refine ⟨⟨replacementInside, ?_⟩, by simp⟩
    simpa only [List.mem_singleton, forall_eq, Mutable.Value.edge, Graph.Edge.Within] using addressInside
  have written := Mutable.writeField_result (name := "read") (value := replacement) found (by simp)
  have actual : HeapCalls.step Probe.module logical.length
      ⟨.operation (.setField "read" replacement) [.ref address], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], afterBindingWrite logical address fields replacement⟩ := by
    simp [HeapCalls.step, primitive, result, HeapCalls.run, written, afterBindingWrite]
  have preserved := step_setField_preserves Probe.module logical physical rename logical.length physical.length
    (.ref address) replacement "read" [] [] layout inside globalsInside
  rw [actual] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  have bindingInside : StateWithin ⟨.value (.ref address), [.methodReceiver "read" expressions (fun _ => none)],
      afterBindingWrite logical address fields replacement⟩ := by
    refine ⟨Nat.lt_of_lt_of_le addressInside larger, ?_⟩
    simp [FrameWithin, EnvWithin]
  have raw := step_methodReceiver_preserves Probe.module _ other nextMap logical.length physical.length
    (.ref address) "read" expressions (fun _ => none) [] [] retained
    (by simp [Probe.module, StmtWithin]) bindingInside nextGlobals
  have wrapped := SetCalls.Relocation.step_preserves_of_heap Probe.module choices
    ⟨⟨.value (.ref address), [.methodReceiver "read" expressions (fun _ => none)],
      afterBindingWrite logical address fields replacement⟩, used⟩ other nextMap
    logical.length physical.length [] retained bindingInside nextGlobals raw
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_ordinary_preserves Probe.module _ other nextMap
    logical.length physical.length choices resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained
    ⟨bindingInside.1, bindingInside.2,
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ rfl wrapped

/-- A suspended write may target the receiver: method capture itself still cannot change it. -/
theorem binding_keeps_receiver (heap : Mutable.Heap) (receiver anchors : Nat)
    (object : Mutable.Object) (name : String) (expressions : List Expr) (env : HeapCalls.Env)
    (stack : List Frame) (globals : Mutable.Globals) (found : SavedCell receiver object heap) :
    RetainsCell receiver object (HeapCalls.step Probe.module anchors
      ⟨.value (.ref receiver), .methodReceiver name expressions env ::
        .writeAttribute (.ref receiver) "read" [] env :: stack, heap⟩ globals) :=
  step_value_cell Probe.module receiver anchors object heap (.ref receiver) _ globals
    (by simp [FrameSeparate]) found

/-- Preserve a separate object through a write and subsequent method capture, even if capture fails. -/
theorem shadow_then_bind_private (heap : Mutable.Heap) (receiver privateAddress anchors : Nat)
    (fields : List (String × Mutable.Value)) (object : Mutable.Object) (name : String)
    (expressions : List Expr) (env : HeapCalls.Env) (stack : List Frame) (globals : Mutable.Globals)
    (saved : SavedCell privateAddress object heap) (separate : receiver ≠ privateAddress) :
    SavedCell privateAddress object (afterShadow heap receiver fields) ∧
    RetainsCell privateAddress object (HeapCalls.step Probe.module anchors
      ⟨.value (.ref receiver), .methodReceiver name expressions env :: stack,
        afterShadow heap receiver fields⟩ globals) := by
  have retained : SavedCell privateAddress object (afterShadow heap receiver fields) :=
    SavedCell.update privateAddress receiver object separate heap _ saved
  exact ⟨retained, step_value_cell Probe.module privateAddress anchors object _ (.ref receiver) _ globals
    (by simp [FrameSeparate]) retained⟩

/-- Both nested reads in enumerate preserve the source itself, for every signed start. -/
theorem enumerate_keeps_source (heap : Mutable.Heap) (receiver anchors : Nat) (object : Mutable.Object)
    (start : Int) (env : HeapCalls.Env) (stack : List Frame) (globals : Mutable.Globals)
    (saved : SavedCell receiver object heap) :
    RetainsCell receiver object (HeapCalls.step Probe.module anchors
      ⟨.value (.scalar (.int start)), .enumerateStart "index" "item" (.ref receiver) [] [] [] env :: stack,
        heap⟩ globals) :=
  step_value_cell Probe.module receiver anchors object heap (.scalar (.int start)) _ globals
    (by simp [FrameSeparate]) saved

end MachineAttributeExamples

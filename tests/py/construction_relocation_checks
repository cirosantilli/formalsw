end ConstructionRelocationExamples
'''

with project_temporary_directory(prefix="construction-relocation-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    build = namespace["build"]
    first = (False, "x")
    second = tuple(list(first))
    result = build(first, second)
    assert result[0] is result[1]
    assert result[2] is first and result[3] is second
    assert next(iter(result[0])) is first
    result[0].add("later")
    assert "later" in result[1]
    numeric = build(True, 1)
    assert next(iter(numeric[0])) is True
    build_all = namespace["build_all"]
    for source in ([], [True, 1, first, second], (first, second), {first, 3},
                   {first: [], 3: None}, b"aba", bytearray(b"aba"), "aλa"):
        copied = build_all(source)
        assert copied[0] is copied[1] and copied[2] is source
        assert copied[0] is not source and copied[0] == set(source)
        copied[0].add("later")
        assert "later" in copied[1]
    assert next(iter(build_all([True, 1])[0])) is True
    assert next(iter(build_all([first, second])[0])) is first
    for unhashable in ([], ([],)):
        try:
            build(first, unhashable)
        except TypeError:
            assert first == (False, "x")
        else:
            raise AssertionError(unhashable)
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    proof = directory / "Checks.lean"
    proof.write_text("import lang.py.FormalSW.SetFromRelocation\n"
                     + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF)
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(proof)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == 27, checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print("construction relocation: shared source results and partial failures; twenty-seven axiom audits passed")

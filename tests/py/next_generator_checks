        subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)
        print(f'Checked next generator cases {start + 1}..{min(start + 25, len(checks))}', flush=True)

print(f'{len(checks)} next-generator Python comparisons passed, including defaults, aliases and exceptions')

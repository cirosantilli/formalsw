program = ast.parse(source)
checker = SupportChecker(program)
names = [function.name for function in program.body if isinstance(function, ast.FunctionDef)]
for name in names:
    issues = checker.check(name, heap_calls=True)
    assert not issues, (name, issues)
world = {}
exec(source, world)
checks = []


def compare(name, value):
    heap = Heap()
    argument = heap.value(value)
    before = heap.expression()
    anchors = list(heap.objects)
    try:
        result = world[name](value)
        roots = anchors + [result]
        outcome = 'match c.outcome with | .ok _ => true | _ => false'
    except (StopIteration, RuntimeError, ValueError, TypeError) as error:
        args = error.args if type(error) is StopIteration else ()
        exception = f'⟨"{type(error).__name__}", [' + ', '.join(map(constant, args)) + ']⟩'
        roots = anchors
        outcome = f'match c.outcome with | .error e => decide (e = {exception}) | _ => false'
    expected = data(snapshot_roots(roots))
    checks.append('\n'.join([
        f'-- {name}, case {len(checks)}',
        f'example : (match (HeapCalls.call source "{name}" [{argument}] {before}).execution.observe 5000 with',
        f'  | .done (.ok c) => ({outcome}) &&',
        f'      (Graph.observedBool ((Graph.compare c.snapshot ({expected})).observe 5000) == some true)',
        '  | _ => false) = true := by native_decide',
    ]))


variants = names[names.index('first'):names.index('shared')]
for name in variants + ['defaults_scope']:
    for initial in ([], [0], [2, -1, 0], [True, False, 1, 0]):
        compare(name, initial.copy())
for initial in ([None], [False], [''], [b''], [[1], [2]]):
    for name in ('first', 'required', 'default_identity'):
        compare(name, initial.copy())
for initial in ([], [[1], [2]]):
    compare('shared', initial)
cyclic = []
cyclic.append(cyclic)
compare('first', cyclic)
compare('default_identity', cyclic)

for text in (
    'def f(xs: list[int]): return next((x for x in xs), default=0)',
    'def f(xs: list[int]): return next((x for x in xs), 0, 1)',
    'def f(xs: list[int], next: int): return next(x for x in xs)',
    'next = 1\ndef f(xs: list[int]): return next(x for x in xs)',
    'def f(xs: list[int]):\n    g = (x for x in xs)\n    return next(g)',
):
    assert SupportChecker(ast.parse(text)).check('f'), text
probe = ast.parse('def f(n: int): return next((x for x in range(n)), 0)')
assert uses_heap_calls(probe, probe.body[0])
assert not SupportChecker(probe).check('f')

prelude = ['import FormalSW', 'open FormalSW.PyAst', 'set_option maxRecDepth 8192',

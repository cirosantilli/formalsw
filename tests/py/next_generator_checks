def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    if type(value) is bytes:
        return '.bytes [' + ', '.join(map(str, value)) + ']'
    return '.string ' + json.dumps(value, ensure_ascii=False)


def data(value):
    if type(value) is list:
        return '.list [' + ', '.join(map(data, value)) + ']'
    return '.scalar (' + constant(value) + ')'


class Heap:
    def __init__(self):
        self.objects = []
        self.addresses = {}

    def value(self, value):
        if type(value) not in (list, tuple, bytearray):
            return '.scalar (' + constant(value) + ')'
        if id(value) not in self.addresses:
            self.addresses[id(value)] = len(self.objects)
            self.objects.append(value)
            for item in value:
                self.value(item)
        return f'.ref {self.addresses[id(value)]}'

    def expression(self):
        return '[' + ', '.join(
            '.bytearray [' + ', '.join(map(str, value)) + ']' if type(value) is bytearray else
            ('.list' if type(value) is list else '.tuple') + ' [' + ', '.join(map(self.value, value)) + ']'
            for value in self.objects) + ']'



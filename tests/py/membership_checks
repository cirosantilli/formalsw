#!/usr/bin/env python3
"""
Compare sequence membership with Python, including effects, aliases, and errors.
"""
import ast
import itertools
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.call_support import uses_heap_calls
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))
source = """
from dataclasses import dataclass
@dataclass(frozen=True)
class Record:
    value: int

def touch(xs: list[int], n: int) -> int:
    xs.append(n)
    return n

def fail(xs: list[int], n: int) -> int:
    xs.append(n)
    return n // 0
"""
bodies = {
    'literal': 'return n in (4, 6, 9, 11)',
    'literal_not': 'return n not in (4, 6, 9, 11)',
    'empty_tuple': 'return n in ()',
    'empty_list': 'return n not in []',
    'input_list': 'return n in xs',
    'mixed': 'return n in [True, False, 5, None, "x"]',
    'ordered': 'return touch(xs, n) in (touch(xs, n), touch(xs, n + 1))',
    'failed_needle': 'return fail(xs, n) in (touch(xs, n + 1),)',
    'failed_container': 'return touch(xs, n) not in (fail(xs, n + 1),)',
    'not_iterable': 'return touch(xs, n) in touch(xs, n + 1)',
    'none_container': 'return n in None',
    'same_object': 'return xs in [xs]',
    'equal_lists': 'return [n] in [[n]]',
    'equal_tuples': 'pair = (n,)\nreturn pair in [(n,)]',
    'unequal_types': 'return [n] in [(n,)]',
    'buffer_bytes': "return b'a' in [bytearray(b'a')]",
    'bytes_buffer': "return bytearray(b'a') in [b'a']",
    'records': 'a = Record(n)\nb = Record(n)\nreturn a in [b]',
    'short_circuit': 'a = [[n]]\nreturn a in [a, [[n + 1]]]',
    'nested_lists': 'a = [[n]]\nreturn a in [[[n + 1]], a]',
    'skip_container': 'return False and n in fail(xs, n)',
}
bodies['dict_container'] = 'return n in {n: 0}'
bodies['set_container'] = 'return n in set([n])'
bodies['string_container'] = 'return "a" in "abc"'
unsupported = {
    'unknown_equality': 'a = {n: [n]}\nreturn a in [{n: [n + 1]}, a]',
}
for name, body in (bodies | unsupported).items():
    source += f'\ndef {name}(n: int, xs: list[int]) -> bool:\n'
    source += ''.join('    ' + line + '\n' for line in body.splitlines())
world = {}
exec(source, world)

with project_temporary_directory(prefix='membership-') as temporary:
    directory = Path(temporary)
    path = directory / 'source.py'
    path.write_text(source)
    program = api['source_module'](path)
    checker = SupportChecker(program)
    for name in bodies:
        assert not checker.check(name), (name, checker.check(name))
        function = next(node for node in program.body if isinstance(node, ast.FunctionDef) and node.name == name)
        assert uses_heap_calls(program, function)
    equations = []
    for name, initial, n in itertools.product(bodies, ([], [4, 0]), (-1, 0, 1, 4, 6, 9, 11, 12)):
        events = initial.copy()
        try:
            result = world[name](n, events)
            outcome = f'.ok (.scalar (.bool {str(result).lower()}))'
        except (ZeroDivisionError, TypeError) as error:
            outcome = f'.error {{typeName := "{type(error).__name__}", args := []}}'
        items = lambda values: '[' + ', '.join(f'.scalar (.int ({value}))' for value in values) + ']'
        call = f'HeapCalls.call Probe.module "{name}" [.scalar (.int ({n})), .ref 0] [.list {items(initial)}]'
        equations.append(f'example : (match ({call}).execution.observe 1000 with\n'
                         f'  | .done (.ok c) => c.outcome == {outcome} && c.heap[0]? == some (.list {items(events)})\n'
                         '  | _ => false) = true := by native_decide')
    for name in unsupported:
        equations.append(f'example : (HeapCalls.call Probe.module "{name}" [.scalar (.int 2), .ref 0] [.list []]).execution.observe 1000 = .unsupported := by native_decide')
    for expression in ('0 < n in [1, 2]', 'n in [1, 2] == True'):
        module = ast.parse(f'def f(n: int) -> bool:\n    return {expression}\n')
        assert SupportChecker(module).check('f'), expression
    escaped = ast.parse('def f(n: int) -> bool:\n    pair = (1, 2)\n    return n in pair\n')
    assert SupportChecker(escaped).check('f')
    guarded = directory / 'guarded.py'
    guarded.write_text('def guarded(n: int) -> int:\n    """\n'
                       '    @formalsw: Requires(n in (4, 6, 9, 11))\n'
                       '    @formalsw: Returns\n    """\n    return n\n')
    requirements = api['collect_requirements'](guarded, api['source_module'](guarded), 'Guard', 'Guard')
    assert not any(item.unsupported for item in requirements)
    assert any('HeapCalls.Condition' in item.property_type for item in requirements)
    assert any(item.marker == 'precondition model coverage' for item in requirements)
    document = directory / 'source.json'
    document.write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('import lang.py.FormalSW.HeapCalls\n' + api['AstLeanBridgeEmitter'](document, 'Probe', program).emit()
                     + 'open FormalSW.PyAst\nset_option maxRecDepth 8192\n' + '\n'.join(equations) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

print(f'{len(equations)} membership comparisons passed, including effects, aliases, errors, and partial cases')

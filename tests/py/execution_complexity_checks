#!/usr/bin/env python3
"""
Reject runtime claims from unit steps or the structural classifier.
"""

import argparse
import json
from pathlib import Path
import runpy
import sys
from tempfile import TemporaryDirectory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
frontend = runpy.run_path(str(ROOT / "formalsw"))
InvalidRequirement = frontend["InvalidRequirement"]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--lean-output", type=Path, help="write generated obligations for separate Lean type checking")
options = parser.parse_args()
lean_checks = ["import lang.py.FormalSW.HeapRuntimeCostSequences\nimport lang.py.FormalSW.HeapRuntimeInputs\nimport lang.py.FormalSW.IntegerListWork\n"]

with TemporaryDirectory() as directory:

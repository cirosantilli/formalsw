        source = Path(directory) / f"invalid_list_size{index}.py"
        source.write_text(f'''def solve(digits: list[int], k: int) -> int:
    """
    @formalsw: {marker}
    """
    return len(digits)
''')
        module = frontend["source_module"](source)

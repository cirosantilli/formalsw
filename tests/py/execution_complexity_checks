        source = Path(directory) / f"cost{index}.py"
        source.write_text(f'''def solve(n: int) -> int:
    """
    @formalsw: Requires(n >= 0)
    @formalsw: {marker}
    """
    return n + 1
''')
        module = frontend["source_module"](source)
        try:
            frontend["collect_requirements"](source, module, "Cost", "CostAst")
        except InvalidRequirement as error:
            assert "operation-specific costs" in str(error), error
        else:
            raise AssertionError(f"Runtime complexity claim accepted: {marker}")


def audit_functions() -> list[str]:
    documented = []
    for line in (DOCS / "functions.rst").read_text().splitlines():
        match = re.match(
            r"^\.\. (function|awaitablefunction|decorator)::\s*([A-Za-z_][\w.]*)",
            line,
        )
        if match:
            documented.append(match.group(2).split(".")[0])
    modeled = definitions(FUNCTION_FILES)
    return [f"function {name}" for name in dict.fromkeys(documented) if name not in modeled]


def audit_types() -> list[str]:
    documented = []
    for line in (DOCS / "functions.rst").read_text().splitlines():
        match = re.match(r"^\.\. class::\s*([A-Za-z_][\w.]*)", line)
        if match:
            documented.append(match.group(1))
    exclusions = {"float", "complex"}
    return [
        f"type {name}"
        for name in dict.fromkeys(documented)
        if name not in exclusions and name not in TYPE_FILES
    ]


def section_owner(line_number: int) -> str | None:
    ranges = [
        (207, 643, "int"),
        (896, 971, "iterator"),
        (972, 1728, "sequence"),
        (1729, 3241, "str"),
        (3242, 3376, "bytes"),
        (3377, 4521, "bytearray"),
        (4522, 5017, "memoryview"),
        (5018, 5233, "set"),
        (5234, 5635, "dict"),
        (5636, 5710, "contextmanager"),
        (5711, 6097, "special"),
    ]
    return next((owner for start, end, owner in ranges if start <= line_number <= end), None)


def audit_methods() -> list[str]:
    aliases = {"container": "iterator", "frozenset": "set"}
    known_owners = set(METHOD_FILES) | {"container", "frozenset"}
    missing = []
    lines = (DOCS / "stdtypes.rst").read_text().splitlines()
    for line_number, line in enumerate(lines, start=1):
        match = re.match(
            r"\s*\.\. (method|classmethod|staticmethod)::\s*([A-Za-z_][\w.]*)",
            line,
        )
        if not match:
            continue
        owner = section_owner(line_number)
        parts = match.group(2).split(".")
        if len(parts) > 1 and parts[-2] in known_owners:
            owner = aliases.get(parts[-2], parts[-2])
        if owner is None:  # float and complex section, intentionally excluded
            continue
        method = parts[-1]
        symbol = METHOD_NAMES.get(method, method)
        if method == "pop" and owner in {"dict", "set"}:
            symbol = "pop?"
        if method == "index" and owner == "memoryview":
            symbol = "index?"
        if symbol not in definitions(METHOD_FILES[owner]):
            missing.append(f"stdtypes.rst:{line_number} {owner}.{method} -> {symbol}")
    return missing


def audit_prose_operations() -> list[str]:
    missing = []
    for path, required in PROSE_SYMBOLS.items():
        modeled = definitions([path])
        for symbol in sorted(required - modeled):
            missing.append(f"prose/table operation {path}:{symbol}")
    return missing


def audit_prose_types() -> list[str]:
    missing = []
    for path, required in PROSE_TYPES.items():
        text = (MODEL_ROOT / path).read_text()
        declared = set(
            re.findall(r"^(?:structure|inductive|abbrev)\s+([A-Za-z_][\w]*)", text, re.MULTILINE)
        )
        for name in sorted(required - declared):
            missing.append(f"prose-defined type {path}:{name}")
    return missing


def main() -> int:
    if not DOCS.exists():
        print(f"CPython documentation not found: {DOCS}")
        return 2
    missing = (
        audit_functions()
        + audit_types()
        + audit_methods()
        + audit_prose_operations()
        + audit_prose_types()
    )
    if missing:
        print("Missing builtin models:")
        for item in missing:
            print(f"  {item}")
        return 1
    print("All documented non-floating builtin directives and prose operations have model symbols.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

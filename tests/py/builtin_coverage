#!/usr/bin/env python3
"""Audit CPython builtin documentation directives against CleanXY model symbols."""

from __future__ import annotations

import os
import re
from pathlib import Path


REPO = Path(__file__).resolve().parents[2]
CPYTHON = Path(os.environ.get("CPYTHON_ROOT", Path.home() / "git/cpython"))
DOCS = CPYTHON / "Doc/library"
MODEL_ROOT = REPO / "lang/py/builtin/type"


def definitions(paths: list[str]) -> set[str]:
    text = "\n".join((MODEL_ROOT / path).read_text() for path in paths)
    return {
        quoted or ordinary
        for quoted, ordinary in re.findall(
            r"^def\s+(?:(?:[A-Za-z_][\w]*\.)?«([^»]+)»|(?:[A-Za-z_][\w]*\.)?([A-Za-z_][\w?]*))",
            text,
            re.MULTILINE,
        )
    }



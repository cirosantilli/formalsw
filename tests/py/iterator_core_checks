#!/usr/bin/env python3
"""
Prove an allocating custom-iterator call equivalent to direct construction.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
class Allocating:
    def __iter__(self):
        return self

    def __next__(self):
        return [self]

def first(iterator):
    for value in iterator:
        return value

def direct(iterator):
    return [iterator]
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
open IteratorCalls IteratorCalls.Relocation
namespace IteratorCoreExamples
set_option Elab.async false

def classInfo := (Probe.module.findClass "Allocating").getD ("", [])
def methodArgs : List Arg := [{name := "self", annotation := none}]
def iterBody : List Stmt := [.return (.name "self")]
def nextBody : List Stmt := [.return (.list [.name "self"])]
def args : List Arg := [{name := "iterator", annotation := none}]
def loopBody : List Stmt := [.return (.name "value")]
def firstBody : List Stmt := [.forIn (.name "value") (.name "iterator") loopBody []]
def directBody : List Stmt := [.return (.list [.name "iterator"])]
def env (address : Nat) : HeapCalls.Env := HeapCalls.argumentEnv args [.ref address]
def consumer (address : Nat) : Loop := ⟨"value", loopBody, [], [], env address, []⟩
def after (heap : Mutable.Heap) (address : Nat) := heap ++ [.list [.ref address]]
def completion (heap : Mutable.Heap) (address : Nat) : Mutable.Completion :=
  ⟨.ok (.ref heap.length), [], after heap address, heap.length⟩

theorem source_module : ModuleSource Probe.module := by simp [ModuleSource, Probe.module, StmtWithin]
theorem source_class : Probe.module.findClass "Allocating" = some classInfo := rfl
theorem source_iter : findFunctionIn classInfo.2 "__iter__" = some (methodArgs, iterBody) := rfl
theorem source_next : findFunctionIn classInfo.2 "__next__" = some (methodArgs, nextBody) := rfl
theorem source_first : findFunctionIn Probe.module.body "first" = some (args, firstBody) := rfl
theorem source_direct : findFunctionIn Probe.module.body "direct" = some (args, directBody) := rfl

theorem iter_bound (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Allocating" fields)) :
    ProtocolCalls.iterMethod Probe.module (.ref address) heap =
      some (.ok (.method (.ref address) methodArgs iterBody), heap) := by
  have lookup := ProtocolCalls.lookup_instance Probe.module heap address classInfo.1 "Allocating"
    "__iter__" fields classInfo.2 found source_class
  simp only [source_iter, Option.map_some] at lookup
  simp [ProtocolCalls.iterMethod, Mutable.eval_bind, lookup]

theorem next_bound (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Allocating" fields)) :
    ProtocolCalls.nextMethod Probe.module (.ref address) heap =
      some (.ok (some (.method (.ref address) methodArgs nextBody)), heap) := by
  have lookup := ProtocolCalls.lookup_instance Probe.module heap address classInfo.1 "Allocating"
    "__next__" fields classInfo.2 found source_class
  simp only [source_next, Option.map_some] at lookup
  simpa [ProtocolCalls.nextMethod, found] using lookup

theorem iter_returns (heap : Mutable.Heap) (address : Nat) :
    MethodReturns Probe.module (.ref address) methodArgs iterBody [] heap (.ref address) heap := by
  apply MethodReturns.of_body (completed := [.ref address]) (by rfl)
  exact BlockReturns.return_value (Evaluates.lookup (by simp [functionEnv, HeapCalls.argumentEnv, methodArgs]))

theorem next_returns (heap : Mutable.Heap) (address : Nat) :
    MethodReturns Probe.module (.ref address) methodArgs nextBody [] heap (.ref heap.length) (after heap address) := by
  apply MethodReturns.of_body (completed := [.ref address]) (by rfl)
  exact BlockReturns.return_value (Evaluates.list (.cons
    (Evaluates.lookup (by simp [functionEnv, HeapCalls.argumentEnv, methodArgs])) .nil))

theorem first_finishes (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Allocating" fields)) (choices : ChoiceSchedule) :
    ((IteratorCalls.call Probe.module "first" [.ref address] heap).run choices).Finishes (completion heap address) := by
  have instanceFound : isInstance heap (.ref address) = true := by simp [isInstance, found]
  have looked : env address "iterator" = some (.ref address) := by simp [env, HeapCalls.argumentEnv, args]
  obtain ⟨acquiredUsed, acquired⟩ := for_instance (loop := consumer address) (resumes := [])
    (anchors := heap.length) (choices := choices) (used := 0) (globals := [])
    (source := .name "iterator") (by intros; intro impossible; cases impossible)
    (Evaluates.lookup looked) instanceFound (iter_bound heap address fields found)
    (OperationCompletes.of_method (iter_returns heap address)) (next_bound heap address fields found)
  obtain ⟨advancedUsed, advanced⟩ := advance_returns (loop := consumer address) (resumes := [])
    (anchors := heap.length) (choices := choices) (used := acquiredUsed) (globals := []) instanceFound
    (next_bound heap address fields found) (OperationCompletes.of_method (next_returns heap address))
  have returned : BlockReturns Probe.module (setLocal (env address) "value" (.ref heap.length))
      (loopBody ++ [Calls.loopContinuation loopBody (loopCode (consumer address) (.ref address))])
      (after heap address) (.ref heap.length) (after heap address) :=
    BlockReturns.return_value (Evaluates.lookup (by simp [setLocal]))
  have doneBody := IteratorCalls.Reaches.of_heap (choices := choices) (used := advancedUsed)
    (returned heap.length []) []
  have entry : HeapCalls.Reaches Probe.module heap.length
      ⟨.operation (.call "first") [.ref address], [], heap⟩ ⟨.block firstBody (env address), [], heap⟩ :=
    .next (by simp [HeapCalls.step, source_first, completeArguments, args, functionEnv, env, firstBody, executableBody]) .refl
  change Finishes (IteratorCalls.step Probe.module heap.length choices)
    (.running ⟨⟨.operation (.call "first") [.ref address], [], heap⟩, 0⟩ []) (.ok (completion heap address))
  apply (IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) entry []).finishes
  apply acquired.finishes
  apply advanced.finishes
  apply doneBody.finishes
  exact .next (core_done rfl rfl) (.done rfl)

theorem direct_finishes (heap : Mutable.Heap) (address : Nat) (choices : ChoiceSchedule) :
    ((IteratorCalls.call Probe.module "direct" [.ref address] heap).run choices).Finishes (completion heap address) := by
  have returns : ReturnsValue Probe.module "direct" [.ref address] heap (.ref heap.length) (after heap address) := by
    apply BlockReturns.function source_direct (completed := [.ref address]) (by rfl)
    exact BlockReturns.return_value (Evaluates.list (.cons
      (Evaluates.lookup (by simp [functionEnv, HeapCalls.argumentEnv, args])) .nil))
  have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returns heap.length []) []
  exact reached.finishes (.next (core_done rfl rfl) (.done rfl))

theorem first_equiv_direct (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Allocating" fields))
    (leftChoices rightChoices : ChoiceSchedule) :
    ((IteratorCalls.call Probe.module "first" [.ref address] heap).run leftChoices).Equiv
      ((IteratorCalls.call Probe.module "direct" [.ref address] heap).run rightChoices) :=
  Mutable.Call.equiv_of_finishes (first_finishes heap address fields found leftChoices)
    (direct_finishes heap address rightChoices) (Or.inl rfl)

theorem allocation_layout (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (logicalAnchors physicalAnchors used : Nat) (choices : ChoiceSchedule)
    (items : List Mutable.Value) (stack : List HeapCalls.Frame) (resumes : List Resume)
    (globals : Mutable.Globals) (layout : ExecutionLayout logical physical rename)
    (itemsInside : ∀ value ∈ items, value.edge.Within logical.length)
    (stackInside : ∀ frame ∈ stack, FrameWithin logical.length frame)
    (saved : ∀ pending ∈ resumes, ResumeWithin logical.length pending)
    (globalsInside : GlobalsWithin logical.length globals) :
    let nextMap := extendMap rename logical.length physical.length
    let logicalAfter := logical ++ [.list items]
    let physicalAfter := physical ++ [.list (items.map (relocateValue rename))]
    IteratorCalls.step Probe.module physicalAnchors choices
      (IteratorCalls.Relocation.relocateState rename physical physicalAnchors
        (.running ⟨⟨.operation .list items, stack, logical⟩, used⟩ resumes)) (relocateGlobals rename globals) =
      IteratorCalls.Relocation.relocateStep nextMap physicalAfter physicalAnchors
        (.next (.running ⟨⟨.value (.ref logical.length), stack, logicalAfter⟩, used⟩ resumes)) := by
  dsimp only
  let core : HeapCalls.State := ⟨.operation .list items, stack, logical⟩
  have allocated := step_list_relocates Probe.module logical physical rename layout logicalAnchors physicalAnchors
    items stack globals itemsInside stackInside globalsInside
  have heapPair : HeapCalls.step Probe.module physicalAnchors (HeapCalls.Relocation.relocateState rename physical core)
      (relocateGlobals rename globals) =
      HeapCalls.Relocation.relocateStep (extendMap rename logical.length physical.length)
        (physical ++ [.list (items.map (relocateValue rename))]) physicalAnchors
        (HeapCalls.step Probe.module logicalAnchors core globals) := by
    rw [show HeapCalls.step Probe.module logicalAnchors core globals = _ from allocated.1]
    exact allocated.2.1
  have setPair := set_step_relocates Probe.module core physical
    (physical ++ [.list (items.map (relocateValue rename))]) rename (extendMap rename logical.length physical.length)
    logicalAnchors physicalAnchors used choices globals (by rw [allocated.1]; simp) heapPair
  have paired := step_ordinary_relocates Probe.module ⟨core, used⟩ physical
    (physical ++ [.list (items.map (relocateValue rename))]) rename (extendMap rename logical.length physical.length)
    logicalAnchors physicalAnchors choices resumes globals source_module layout.runtime
    ⟨by trivial, itemsInside⟩ saved (extendMap_old rename logical.length physical.length) rfl setPair
  simpa only [IteratorCalls.step, intercept, SetCalls.step, core, allocated.1, SetCalls.liftStep, lift] using paired

theorem allocation_preserves (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (logicalAnchors physicalAnchors used : Nat) (choices : ChoiceSchedule)
    (items : List Mutable.Value) (stack : List HeapCalls.Frame) (resumes : List Resume)
    (globals : Mutable.Globals) (layout : ExecutionLayout logical physical rename)
    (itemsInside : ∀ value ∈ items, value.edge.Within logical.length)
    (stackInside : ∀ frame ∈ stack, FrameWithin logical.length frame)
    (saved : ∀ pending ∈ resumes, ResumeWithin logical.length pending)
    (globalsInside : GlobalsWithin logical.length globals) :
    IteratorCalls.Relocation.Preserves logical physical rename physicalAnchors
      (IteratorCalls.step Probe.module logicalAnchors choices
        (.running ⟨⟨.operation .list items, stack, logical⟩, used⟩ resumes) globals)
      (IteratorCalls.step Probe.module physicalAnchors choices
        (IteratorCalls.Relocation.relocateState rename physical physicalAnchors
          (.running ⟨⟨.operation .list items, stack, logical⟩, used⟩ resumes)) (relocateGlobals rename globals)) := by
  have bounded : HeapCalls.Relocation.StateWithin ⟨.operation .list items, stack, logical⟩ :=
    ⟨⟨by trivial, itemsInside⟩, stackInside⟩
  have raw := step_list_preserves Probe.module logical physical rename logicalAnchors physicalAnchors items stack globals layout bounded globalsInside
  have wrapped := SetCalls.Relocation.step_preserves_of_heap Probe.module choices
    ⟨⟨.operation .list items, stack, logical⟩, used⟩ physical rename
    logicalAnchors physicalAnchors globals layout bounded globalsInside raw
  exact step_ordinary_preserves Probe.module _ physical rename logicalAnchors physicalAnchors choices resumes globals
    source_module layout ⟨bounded.1, bounded.2, saved⟩ rfl wrapped

/-- Allocate the actual __next__ result, complete the method, then resume the source consumer. -/
theorem allocation_then_resume (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (address logicalAnchors physicalAnchors used : Nat) (choices : ChoiceSchedule)
    (globals : Mutable.Globals) (layout : ExecutionLayout logical physical rename)
    (addressInside : address < logical.length) (globalsInside : GlobalsWithin logical.length globals) :
    ∃ logicalAfter physicalAfter nextMap,
      (∀ old < logical.length, nextMap old = rename old) ∧
      ExecutionLayout logicalAfter physicalAfter nextMap ∧
      logicalAfter = after logical address ∧
      IteratorCalls.Relocation.Preserves logical physical rename physicalAnchors
        (IteratorCalls.step Probe.module logicalAnchors choices
          (.completed (.ok ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩)
            used [.advance (consumer address) (.ref address)]) globals)
        (IteratorCalls.step Probe.module physicalAnchors choices
          (IteratorCalls.Relocation.relocateState nextMap physicalAfter physicalAnchors
            (.completed (.ok ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩)
              used [.advance (consumer address) (.ref address)])) (relocateGlobals rename globals)) ∧
      IteratorCalls.Reaches Probe.module physicalAnchors choices (relocateGlobals rename globals)
        (IteratorCalls.Relocation.relocateState rename physical physicalAnchors
          (.running ⟨⟨.operation .list [.ref address], [], logical⟩, used⟩ [.advance (consumer address) (.ref address)]))
        (IteratorCalls.Relocation.relocateState nextMap physicalAfter physicalAnchors
          (.running ⟨⟨.block (loopBody ++ [Calls.loopContinuation loopBody (loopCode (consumer address) (.ref address))])
            (setLocal (env address) "value" (.ref logical.length)), [], after logical address⟩, used⟩ [])) := by
  let saved : List Resume := [.advance (consumer address) (.ref address)]
  have savedInside : ∀ pending ∈ saved, ResumeWithin logical.length pending := by
    intro pending member
    have same : pending = .advance (consumer address) (.ref address) := List.mem_singleton.mp member
    subst pending
    refine ⟨⟨?_, ?_, by simp [consumer], by simp [consumer], by simp [consumer]⟩, addressInside⟩
    · exact argumentEnv_within logical.length args [.ref address] (by simpa using addressInside)
    · simp [consumer, loopBody, StmtWithin]
  have allocated := allocation_preserves logical physical rename logicalAnchors physicalAnchors used choices
    [.ref address] [] saved globals layout (by simpa using addressInside) (by simp) savedInside globalsInside
  have first : IteratorCalls.step Probe.module logicalAnchors choices
      (.running ⟨⟨.operation .list [.ref address], [], logical⟩, used⟩ saved) globals =
      .next (.running ⟨⟨.value (.ref logical.length), [], after logical address⟩, used⟩ saved) := rfl
  rw [first] at allocated
  obtain ⟨logicalAfter, physicalAfter, nextMap, agree, grows, physicalGrows, nextLayout, heap, inside,
    globalsAfter, sameGlobals, moved⟩ := allocated.next globals globalsInside
  have sameHeap : after logical address = logicalAfter := heap
  subst logicalAfter
  have completionInside : CompletionWithin
      ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩ :=
    ⟨globalsAfter, by intro value success; cases success; simp [after, Mutable.Value.edge, Graph.Edge.Within]⟩
  have second : IteratorCalls.step Probe.module logicalAnchors choices
      (.running ⟨⟨.value (.ref logical.length), [], after logical address⟩, used⟩ saved) globals =
      .next (.completed (.ok ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩) used saved) := rfl
  have completionCore : SetCalls.Relocation.Preserves (after logical address) physicalAfter nextMap physicalAnchors
      (SetCalls.step Probe.module logicalAnchors choices ⟨⟨.value (.ref logical.length), [], after logical address⟩, used⟩ globals)
      (SetCalls.step Probe.module physicalAnchors choices
        (relocateCore nextMap physicalAfter ⟨⟨.value (.ref logical.length), [], after logical address⟩, used⟩)
        (relocateGlobals nextMap globals)) := by
    apply SetCalls.Relocation.Preserves.unchanged nextLayout
    · rfl
    · exact completionInside
    · rfl
  have completed := step_ordinary_preserves Probe.module _ physicalAfter nextMap logicalAnchors physicalAnchors choices
    saved globals source_module nextLayout inside rfl completionCore
  rw [second] at completed
  obtain ⟨logicalFinal, physicalFinal, finalMap, nextAgree, nextGrows, physicalNextGrows, finalLayout,
    finalHeap, finalInside, finalGlobals, finalSameGlobals, completedPair⟩ := completed.next globals globalsAfter
  have finalSameHeap : after logical address = logicalFinal := finalHeap
  subst logicalFinal
  have rootAgree : ∀ old < logical.length, finalMap old = rename old := by
    intro old bounded
    exact (nextAgree old (Nat.lt_of_lt_of_le bounded grows)).trans (agree old bounded)
  have fixedGlobals := finalSameGlobals.trans sameGlobals
  have resumePreserved := step_completed_preserves Probe.module choices
    ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩ physicalFinal finalMap
    logicalAnchors physicalAnchors used saved globals finalLayout ⟨finalInside.1, finalInside.2.1⟩ finalInside.2.2
  have resumePair := step_completed_relocates Probe.module choices
    ⟨.ok (.ref logical.length), globals, after logical address, logicalAnchors⟩ physicalFinal finalMap
    logicalAnchors physicalAnchors used saved finalLayout.runtime finalInside.2.1
  refine ⟨after logical address, physicalFinal, finalMap, rootAgree, finalLayout, rfl, ?_, ?_⟩
  · rw [← fixedGlobals]
    exact resumePreserved.rebase rootAgree grows (Nat.le_trans physicalGrows physicalNextGrows)
  · apply IteratorCalls.Reaches.next moved
    apply IteratorCalls.Reaches.next (by simpa only [sameGlobals] using completedPair)
    exact .next resumePair .refl

/-- The first-item call contains acquisition and advancement, then stops above any caller. -/
theorem nested_first_prefix (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Allocating" fields)) (choices : ChoiceSchedule)
    (resumes : List Resume) :
    ∃ used, IteratorCalls.Reaches Probe.module heap.length choices []
      (.running ⟨⟨.operation (.call "first") [.ref address], [], heap⟩, 0⟩ resumes)
      (.completed (.ok (completion heap address)) used resumes) := by
  obtain ⟨used, reached⟩ := completion_of_iterator (first_finishes heap address fields found choices)
  exact ⟨used, by simpa only [appendResumes, List.nil_append] using reached.append_resumes resumes⟩

/-- Derive the allocating advancement under an arbitrary physical consumer from one logical method proof. -/
theorem relocated_next (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (fields : List (String × Mutable.Value))
    (found : logical[address]? = some (.instance classInfo.1 "Allocating" fields))
    (choices : ChoiceSchedule) (anchors used : Nat) (loop : Loop) (resumes : List Resume) :
    ∃ other nextMap finalUsed, ExtendedLayout logical.length physical.length rename (after logical address) other nextMap ∧
      IteratorCalls.Reaches Probe.module anchors choices []
        (.running ⟨⟨.block (loopCode loop (.ref (rename address)) :: loop.following) loop.env,
          loop.stack, physical⟩, used⟩ resumes)
        (.running ⟨⟨.block (loop.body ++ [Calls.loopContinuation loop.body (loopCode loop (.ref (rename address)))]
          ++ loop.following) (setLocal loop.env loop.name (.ref (nextMap logical.length))),
          loop.stack, other⟩, finalUsed⟩ resumes) := by
  have executed : OperationCompletes Probe.module choices used (.method (.ref address) methodArgs nextBody)
      logical (.ok (.ref logical.length)) (after logical address) :=
    OperationCompletes.of_method (next_returns logical address)
  obtain ⟨finalUsed, logicalRun⟩ := executed logical.length []
  obtain ⟨other, nextMap, extended, called⟩ := advance_completion_relocates Probe.module choices logical physical rename
    logical.length anchors used finalUsed (.ref address) (.method (.ref address) methodArgs nextBody)
    (.ok (.ref logical.length)) (after logical address) [] source_module layout
    (List.getElem?_eq_some_iff.mp found).1 (by simp [GlobalsWithin]) (by simp [isInstance, found])
    (next_bound logical address fields found) logicalRun
  refine ⟨other, nextMap, finalUsed, extended, ?_⟩
  have completed : IteratorCalls.Reaches Probe.module anchors choices []
      (.running ⟨⟨.block (loopCode loop (.ref (rename address)) :: loop.following) loop.env,
        loop.stack, physical⟩, used⟩ resumes)
      (.completed (.ok ⟨.ok (.ref (nextMap logical.length)), [], other, anchors⟩) finalUsed
        (.advance loop (.ref (rename address)) :: resumes)) := by
    simpa only [relocateGlobals, List.map_nil, Except.map, relocateValue] using called loop resumes
  exact advanced completed

/-- Finish an allocating method and resume its caller without restricting later caller writes. -/
theorem allocation_prefix_private (heap : Mutable.Heap) (receiver privateAddress anchors used : Nat)
    (privateObject : Mutable.Object) (choices : ChoiceSchedule) (loop : Loop) (resumes : List Resume)
    (saved : SavedCell privateAddress privateObject heap) :
    ∃ final, IteratorCalls.Reaches Probe.module anchors choices []
      (.running ⟨⟨.operation .list [.ref receiver], [], heap⟩, used⟩ (.advance loop (.ref receiver) :: resumes)) final ∧
      IteratorCalls.Framing.StateCell privateAddress privateObject final := by
  let returned : IteratorCalls.State := .running
    ⟨⟨.value (.ref heap.length), [], after heap receiver⟩, used⟩ [.advance loop (.ref receiver)]
  let completed : IteratorCalls.State := .completed
    (.ok ⟨.ok (.ref heap.length), [], after heap receiver, anchors⟩) used [.advance loop (.ref receiver)]
  let final : IteratorCalls.State := .running ⟨⟨.block
    (loop.body ++ [Calls.loopContinuation loop.body (loopCode loop (.ref receiver))] ++ loop.following)
    (setLocal loop.env loop.name (.ref heap.length)), loop.stack, after heap receiver⟩, used⟩ []
  have allocated : IteratorCalls.step Probe.module anchors choices
      (.running ⟨⟨.operation .list [.ref receiver], [], heap⟩, used⟩ [.advance loop (.ref receiver)]) = .next returned := by
    simp [IteratorCalls.step, intercept, SetCalls.step, HeapCalls.step, primitive, result,
      HeapCalls.run, Mutable.allocate, Except.map, SetCalls.liftStep, lift, returned, after]
  have path : IteratorCalls.Framing.SeparatedReaches Probe.module anchors privateAddress choices []
      (.running ⟨⟨.operation .list [.ref receiver], [], heap⟩, used⟩ [.advance loop (.ref receiver)]) final :=
    .next (by simp [IteratorCalls.Framing.StateSeparate, HeapCalls.Framing.StateSeparate,
      HeapCalls.Framing.operationTargets, Heapq.primitiveTargets]) allocated
      (.next (by simp [returned, IteratorCalls.Framing.StateSeparate, HeapCalls.Framing.StateSeparate])
        (show IteratorCalls.step Probe.module anchors choices returned = .next completed from rfl)
        (.next (by trivial) (show IteratorCalls.step Probe.module anchors choices completed = .next final from rfl) .refl))
  have withCaller := path.append_resumes resumes
  refine ⟨appendResumes resumes final, ?_, withCaller.retains_cell privateObject saved⟩
  simpa only [appendResumes, List.cons_append, List.nil_append] using withCaller.reaches

/-- Acquisition rejects a scalar iterator result while retaining the method's final heap. -/
theorem rejected_acquisition_private (heap : Mutable.Heap) (privateAddress anchors used : Nat)
    (privateObject : Mutable.Object) (value : Constant) (choices : ChoiceSchedule)
    (loop : Loop) (resumes : List Resume) (saved : SavedCell privateAddress privateObject heap) :
    IteratorCalls.step Probe.module anchors choices
      (.completed (.ok ⟨.ok (.scalar value), [], heap, anchors⟩) used (.acquire loop :: resumes)) =
      .next (.completed (.ok ⟨.error ⟨"TypeError", []⟩, [], heap, anchors⟩) used resumes) ∧
    IteratorCalls.Framing.RetainsCell privateAddress privateObject (IteratorCalls.step Probe.module anchors choices
      (.completed (.ok ⟨.ok (.scalar value), [], heap, anchors⟩) used (.acquire loop :: resumes))) := by
  constructor
  · simp [IteratorCalls.step, resume, ProtocolCalls.iterFinish, ProtocolCalls.nextMethod,
      propagate, Calls.generatorException]
  · exact IteratorCalls.Framing.step_cell Probe.module privateAddress anchors privateObject _ choices [] (by trivial) saved

/-- Exhaustion and other errors preserve the same cell while selecting different continuation paths. -/
theorem error_resume_private (heap : Mutable.Heap) (privateAddress anchors used : Nat)
    (privateObject : Mutable.Object) (error : ExceptionObject) (iterator : Mutable.Value)
    (choices : ChoiceSchedule) (loop : Loop) (resumes : List Resume)
    (saved : SavedCell privateAddress privateObject heap) :
    IteratorCalls.Framing.RetainsCell privateAddress privateObject (IteratorCalls.step Probe.module anchors choices
      (.completed (.ok ⟨.error error, [], heap, anchors⟩) used (.advance loop iterator :: resumes))) :=
  IteratorCalls.Framing.step_cell Probe.module privateAddress anchors privateObject _ choices [] (by trivial) saved

/-- A later caller write can change the protected object; prefix preservation does not forbid it. -/
theorem later_append_changes_private (heap : Mutable.Heap) (privateAddress anchors used : Nat)
    (items : List Mutable.Value) (value : Mutable.Value) (choices : ChoiceSchedule) (resumes : List Resume)
    (found : heap[privateAddress]? = some (.list items)) :
    ¬ IteratorCalls.Framing.RetainsCell privateAddress (.list items) (IteratorCalls.step Probe.module anchors choices
      (.running ⟨⟨.operation (.append privateAddress) [value], [], heap⟩, used⟩ resumes)) := by
  have valid := (List.getElem?_eq_some_iff.mp found).1
  have transition : IteratorCalls.step Probe.module anchors choices
      (.running ⟨⟨.operation (.append privateAddress) [value], [], heap⟩, used⟩ resumes) =
      .next (.running ⟨⟨.value (.scalar .none), [], heap.set privateAddress (.list (items ++ [value]))⟩, used⟩ resumes) := by
    simp [IteratorCalls.step, intercept, SetCalls.step, HeapCalls.step, primitive, result,
      HeapCalls.run, Mutable.appendItem, found, Except.map, SetCalls.liftStep, lift]
  intro retained
  rw [transition] at retained
  simp [IteratorCalls.Framing.RetainsCell, IteratorCalls.Framing.StateCell, SavedCell, valid] at retained

end IteratorCoreExamples

    "allocateTuple_supported",
    "RuntimeLayout.binary_ref_scalar_unsupported",
    "RuntimeLayout.binary_scalar_ref_unsupported",
    "RuntimeLayout.binary_refs_unsupported",
    "RuntimeLayout.binary_unsupported",
    "inplace_mult_list_supported",
    "inplace_mult_buffer_supported",
    "RuntimeLayout.inplace_add_buffer_unsupported",
    "RuntimeLayout.inplaceBinary_unsupported",
    "RuntimeLayout.inplace_unsupported",
    "RuntimeLayout.binary_operation_unsupported",
    "result_binary_preserves",
    "step_binary_preserves",

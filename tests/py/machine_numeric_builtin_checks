#!/usr/bin/env python3
"""
Check numeric argument effects, scalar conversions, tuple results and saved consumers.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def recorded(log, value, data):
    log.append(value)
    return data


def repr_nested(log, value, data):
    return repr(recorded(log, value, data))


def repr_explicit(log, value, data):
    log.append(value)
    return repr(data)


def power_nested(log, value, base, exponent, modulus):
    return pow(base, exponent, recorded(log, value, modulus))


def power_explicit(log, value, base, exponent, modulus):
    log.append(value)
    return pow(base, exponent, modulus)


def divmod_nested(log, value, dividend, divisor):
    return divmod(dividend, recorded(log, value, divisor))


def divmod_explicit(log, value, dividend, divisor):
    log.append(value)
    return divmod(dividend, divisor)
'''
PROOF = r'''

open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
namespace MachineNumericBuiltinExamples
set_option Elab.async false

def inserted (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) : Mutable.Heap :=
  heap.set address (.list (items ++ [value]))

theorem calls_equiv (left right : String) (arguments : List Mutable.Value) (heap after : Mutable.Heap) (answer : Mutable.Value)
    (leftReturns : ReturnsValue Probe.module left arguments heap answer after)
    (rightReturns : ReturnsValue Probe.module right arguments heap answer after) :
    (IteratorCalls.call Probe.module left arguments heap).Equiv (IteratorCalls.call Probe.module right arguments heap) := by
  have finishes (name : String) (choices : ChoiceSchedule) (returned : ReturnsValue Probe.module name arguments heap answer after) :
      ((IteratorCalls.call Probe.module name arguments heap).run choices).Finishes ⟨.ok answer, [], after, heap.length⟩ := by
    have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returned heap.length []) []
    exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))
  intro leftChoices rightChoices
  exact Mutable.Call.equiv_of_finishes (finishes left leftChoices leftReturns) (finishes right rightChoices rightReturns) (Or.inl rfl)

theorem recorded_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "recorded" [.ref address, value, data] heap (data)
      (inserted heap address items value) := by
  unfold inserted
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  exact BlockReturns.return_value (Evaluates.lookup rfl)

theorem repr_nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (data : Constant)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "repr_nested" [.ref address, value, .scalar data] heap (.scalar (.string (Strings.reprValue data))) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
      (recorded_returns heap address items value (.scalar data) found)) .nil)
  rfl

theorem repr_explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (data : Constant)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "repr_explicit" [.ref address, value, .scalar data] heap (.scalar (.string (Strings.reprValue data))) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  rfl

theorem repr_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (data : Constant)
    (found : heap[address]? = some (.list items)) :
    (IteratorCalls.call Probe.module "repr_nested" [.ref address, value, .scalar data] heap).Equiv
      (IteratorCalls.call Probe.module "repr_explicit" [.ref address, value, .scalar data] heap) :=
  calls_equiv _ _ _ _ _ _ (repr_nested_returns heap address items value data found)
    (repr_explicit_returns heap address items value data found)

theorem power_nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (base : Int) (exponent modulus : Nat)
    (found : heap[address]? = some (.list items)) (positive : 0 < modulus) :
    ReturnsValue Probe.module "power_nested" [.ref address, value, .scalar (.int base), .scalar (.int exponent), .scalar (.int modulus)] heap (.scalar (.int (base ^ exponent % (modulus : Int)))) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
      (recorded_returns heap address items value (.scalar (.int modulus)) found)) .nil)))
  change scalarResult (Calls.modularPower (.int base) (.int exponent) (.int modulus)) _ = _
  simp [Calls.modularPower, scalarNumber, FormalSW.Py.Builtin.Int.powMod_nonnegative base exponent modulus positive, scalarResult] <;> rfl

theorem power_explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (base : Int) (exponent modulus : Nat)
    (found : heap[address]? = some (.list items)) (positive : 0 < modulus) :
    ReturnsValue Probe.module "power_explicit" [.ref address, value, .scalar (.int base), .scalar (.int exponent), .scalar (.int modulus)] heap (.scalar (.int (base ^ exponent % (modulus : Int)))) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
  change scalarResult (Calls.modularPower (.int base) (.int exponent) (.int modulus)) _ = _
  simp [Calls.modularPower, scalarNumber, FormalSW.Py.Builtin.Int.powMod_nonnegative base exponent modulus positive, scalarResult] <;> rfl

theorem power_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (base : Int) (exponent modulus : Nat)
    (found : heap[address]? = some (.list items)) (positive : 0 < modulus) :
    (IteratorCalls.call Probe.module "power_nested" [.ref address, value, .scalar (.int base), .scalar (.int exponent), .scalar (.int modulus)] heap).Equiv
      (IteratorCalls.call Probe.module "power_explicit" [.ref address, value, .scalar (.int base), .scalar (.int exponent), .scalar (.int modulus)] heap) :=
  calls_equiv _ _ _ _ _ _ (power_nested_returns heap address items value base exponent modulus found positive)
    (power_explicit_returns heap address items value base exponent modulus found positive)

theorem divmod_nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (dividend divisor : Int)
    (found : heap[address]? = some (.list items)) (nonzero : divisor ≠ 0) :
    ReturnsValue Probe.module "divmod_nested" [.ref address, value, .scalar (.int dividend), .scalar (.int divisor)] heap (.ref (inserted heap address items value).length) (inserted heap address items value ++ [.tuple [.scalar (.int (dividend.fdiv divisor)), .scalar (.int (dividend - divisor * dividend.fdiv divisor))]]) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) (.cons (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
      (recorded_returns heap address items value (.scalar (.int divisor)) found)) .nil))
  exact Mutable.divmod_ints dividend divisor nonzero _

theorem divmod_explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (dividend divisor : Int)
    (found : heap[address]? = some (.list items)) (nonzero : divisor ≠ 0) :
    ReturnsValue Probe.module "divmod_explicit" [.ref address, value, .scalar (.int dividend), .scalar (.int divisor)] heap (.ref (inserted heap address items value).length) (inserted heap address items value ++ [.tuple [.scalar (.int (dividend.fdiv divisor)), .scalar (.int (dividend - divisor * dividend.fdiv divisor))]]) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil))
  exact Mutable.divmod_ints dividend divisor nonzero _

theorem divmod_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (dividend divisor : Int)
    (found : heap[address]? = some (.list items)) (nonzero : divisor ≠ 0) :
    (IteratorCalls.call Probe.module "divmod_nested" [.ref address, value, .scalar (.int dividend), .scalar (.int divisor)] heap).Equiv
      (IteratorCalls.call Probe.module "divmod_explicit" [.ref address, value, .scalar (.int dividend), .scalar (.int divisor)] heap) :=
  calls_equiv _ _ _ _ _ _ (divmod_nested_returns heap address items value dividend divisor found nonzero)
    (divmod_explicit_returns heap address items value dividend divisor found nonzero)

theorem zero_divisor_retains_mutation (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (dividend : Int) (found : heap[address]? = some (.list items)) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "divmod_nested") [.ref address, value, .scalar (.int dividend), .scalar (.int 0)], [], heap⟩
      (.ok ⟨.error ⟨"ZeroDivisionError", []⟩, [], inserted heap address items value, heap.length⟩) := by
  repeat first
    | apply (Evaluates.arguments_reach (.cons (Evaluates.lookup rfl) (.cons
        (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
          (recorded_returns heap address items value (.scalar (.int 0)) found)) .nil))
        (.builtin .divmod) [] heap.length []).finishes
    | exact .done rfl
    | refine .next rfl ?_

/-- Numeric execution uses the proved output of an earlier mutation, under arbitrary saved consumers. -/
theorem append_then_numeric (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (operation : Operation) (covered : NumericBuiltinOperation operation) (values : List Mutable.Value) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨.operation operation values, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running
          ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running
            ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_numericBuiltin_preserves Probe.module choices _ other nextMap
    logical.length physical.length used operation values stack resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained covered
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end MachineNumericBuiltinExamples
'''
AUDITS = ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "numericProtocol_relocates",
    "numericProtocols_relocates",
    "numericProtocolFailure_result",
    "primitive_power_result",
    "powerResult_relocates",
    "scalarArgumentCall_result",
    "primitive_int_ref",
    "primitive_ord_ref",
    "primitive_bin_ref",
    "scalarBuiltin_pair",
    "result_scalarBuiltin_preserves",
    "result_numericFailure_preserves",
    "result_divmod_preserves",
    "step_numericBuiltin_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation." + name for name in (
    "step_numericBuiltin_preserves",
)] + ["MachineNumericBuiltinExamples." + name for name in (
    "calls_equiv",
    "recorded_returns",
    "repr_nested_returns",
    "repr_explicit_returns",
    "repr_equiv",
    "power_nested_returns",
    "power_explicit_returns",
    "power_equiv",
    "divmod_nested_returns",
    "divmod_explicit_returns",
    "divmod_equiv",
    "zero_divisor_retains_mutation",
    "append_then_numeric",
)]
with project_temporary_directory(prefix="machine-numeric-builtin-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for form in ("nested", "explicit"):
        for data in (None, True, False, -10**100, "quotes'\"\nΩ", b"\x00\xff"):
            log = []
            assert namespace[f"repr_{form}"](log, log, data) == repr(data)
            assert len(log) == 1 and log[0] is log
        for base in (-10**100, -2, 0, 3, 10**100):
            for exponent in (0, 1, 17, 1000):
                for modulus in (1, 2, 13, 10**30 + 3):
                    log = []
                    assert namespace[f"power_{form}"](log, log, base, exponent, modulus) == pow(base, exponent, modulus)
                    assert len(log) == 1 and log[0] is log
        for dividend in (-10**100, -7, 0, 7, 10**100):
            for divisor in (-13, -1, 1, 13):
                log = []
                assert namespace[f"divmod_{form}"](log, log, dividend, divisor) == divmod(dividend, divisor)
                assert len(log) == 1 and log[0] is log
            log = []
            try:
                namespace[f"divmod_{form}"](log, log, dividend, 0)
            except ZeroDivisionError:
                assert len(log) == 1 and log[0] is log
            else:
                raise AssertionError("zero divisor must fail after appending")
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.MachineNumericBuiltins\n"
        "import lang.py.FormalSW.IteratorRules\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"numeric builtins: argument effects, modular powers, signed divmod, errors and saved consumers; {len(AUDITS)} axiom audits passed")

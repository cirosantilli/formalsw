#!/usr/bin/env python3
"""
Prove parsed sequence comparisons preserve outcomes and returned aliases across layouts.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def ordered(left, right):
    answer = left < right
    return [left, right, answer]

def equal(left, right):
    same = left == right
    different = left != right
    return [same, different, left, right]
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation
namespace ComparisonRelocationExamples
set_option Elab.async false

def resultHeap (heap : Mutable.Heap) (left right : Nat) (answer : Bool) : Mutable.Heap :=
  heap ++ [.list [.ref left, .ref right, .scalar (.bool answer)]]

theorem source_returns (heap : Mutable.Heap) (left right : Nat) (answer : Bool)
    (compared : HeapCalls.compare .lt (.ref left) (.ref right) heap = some (.ok (.scalar (.bool answer)), heap)) :
    ReturnsValue Probe.module "ordered" [.ref left, .ref right] heap (.ref heap.length)
      (resultHeap heap left right answer) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.assign (Evaluates.compare (Evaluates.lookup rfl) (Evaluates.lookup rfl) compared)
  exact BlockReturns.return_value
    (Evaluates.list (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl)
      (.cons (Evaluates.lookup rfl) .nil))))

/-- Only the logical comparison is a premise; derive the other execution at its native allowance. -/
theorem paired_returns (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (isTuple : Bool)
    (left right : Nat) (xs ys : List Mutable.Value) (answer : Bool)
    (leftFound : logical[left]? = some (comparisonObject isTuple xs))
    (rightFound : logical[right]? = some (comparisonObject isTuple ys))
    (compared : HeapCalls.compare .lt (.ref left) (.ref right) logical =
      some (.ok (.scalar (.bool answer)), logical)) :
    ∃ nextMap,
      ReturnsValue Probe.module "ordered" [.ref left, .ref right] logical (.ref logical.length)
        (resultHeap logical left right answer) ∧
      ReturnsValue Probe.module "ordered" [.ref (rename left), .ref (rename right)] physical (.ref physical.length)
        (resultHeap physical (rename left) (rename right) answer) ∧
      ExecutionLayout (resultHeap logical left right answer)
        (resultHeap physical (rename left) (rename right) answer) nextMap ∧
      nextMap logical.length = physical.length ∧
      (∀ index < logical.length, nextMap index = rename index) := by
  have other := layout.runtime.compare_order_sequences layout.closed isTuple false left right xs ys
    leftFound rightFound _ _ compared
  have leftInside := (List.getElem?_eq_some_iff.mp leftFound).1
  have rightInside := (List.getElem?_eq_some_iff.mp rightFound).1
  have inside : ∀ value ∈ [Mutable.Value.ref left, .ref right, .scalar (.bool answer)],
      value.edge.Within logical.length := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq,
      Mutable.Value.edge, Graph.Edge.Within]
    exact ⟨leftInside, rightInside, trivial⟩
  have retained := (layout.allocate_list [.ref left, .ref right, .scalar (.bool answer)] inside).2.2
  refine ⟨extendMap rename logical.length physical.length, source_returns logical left right answer compared,
    source_returns physical (rename left) (rename right) answer other, ?_, extendMap_new _ _ _, ?_⟩
  · simpa only [resultHeap, List.map_cons, List.map_nil, relocateValue] using retained
  · exact fun index bound => extendMap_old _ _ _ _ bound

theorem source_failed (heap : Mutable.Heap) (left right : Nat) (exception : ExceptionObject)
    (failed : HeapCalls.compare .lt (.ref left) (.ref right) heap = some (.error exception, heap)) :
    (HeapCalls.call Probe.module "ordered" [.ref left, .ref right] heap).Finishes
      ⟨.error exception, [], heap, heap.length⟩ := by
  change Finishes (HeapCalls.step Probe.module heap.length) _ _
  repeat' apply Finishes.next (step := HeapCalls.step Probe.module heap.length) rfl
  exact .done (by simp [HeapCalls.step, HeapCalls.result, HeapCalls.run, failed, HeapCalls.done,
    HeapCalls.protectGenerator, Frame.inGenerator, Calls.generatorException])

theorem paired_failures (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (isTuple : Bool)
    (left right : Nat) (xs ys : List Mutable.Value) (exception : ExceptionObject)
    (leftFound : logical[left]? = some (comparisonObject isTuple xs))
    (rightFound : logical[right]? = some (comparisonObject isTuple ys))
    (failed : HeapCalls.compare .lt (.ref left) (.ref right) logical = some (.error exception, logical)) :
    (HeapCalls.call Probe.module "ordered" [.ref left, .ref right] logical).Finishes
        ⟨.error exception, [], logical, logical.length⟩ ∧
      (HeapCalls.call Probe.module "ordered" [.ref (rename left), .ref (rename right)] physical).Finishes
        ⟨.error exception, [], physical, physical.length⟩ ∧ ExecutionLayout logical physical rename := by
  have other := layout.runtime.compare_order_sequences layout.closed isTuple false left right xs ys
    leftFound rightFound _ _ failed
  exact ⟨source_failed logical left right exception failed,
    source_failed physical (rename left) (rename right) exception other, layout⟩

/-- The shared prefix may be a cyclic list, tuple, or any other actual heap object. -/
theorem compare_identity (heap : Mutable.Heap) (fuel address : Nat) (object : Mutable.Object)
    (found : heap[address]? = some object) :
    HeapSort.compare (fuel + 1) heap true (.ref address) (.ref address) = some (.ok true) := by
  cases object <;> simp [HeapSort.compare, found]

/-- Derive the comparison for arbitrary integers and caller graphs, without an execution premise. -/
theorem shared_prefix_order (heap : Mutable.Heap) (isTuple : Bool) (left right shared : Nat) (x y : Int)
    (leftFound : heap[left]? = some (comparisonObject isTuple [.ref shared, .scalar (.int x)]))
    (rightFound : heap[right]? = some (comparisonObject isTuple [.ref shared, .scalar (.int y)]))
    (sharedInside : shared < heap.length) :
    HeapCalls.compare .lt (.ref left) (.ref right) heap = some (.ok (.scalar (.bool (decide (x < y)))), heap) := by
  have leftInside := (List.getElem?_eq_some_iff.mp leftFound).1
  obtain ⟨fuel, size⟩ : ∃ fuel, heap.length = fuel + 1 := ⟨heap.length - 1, by omega⟩
  have identity := compare_identity heap fuel shared heap[shared] (List.getElem?_eq_getElem sharedInside)
  have raw : HeapSort.compare (fuel + 2) heap false (.ref left) (.ref right) =
      some (.ok (decide (x < y))) := by
    cases isTuple <;> rw [HeapSort.compare, leftFound, rightFound]
    all_goals
      change HeapSort.lex (HeapSort.compare (fuel + 1) heap true) (HeapSort.compare (fuel + 1) heap false)
        false [.ref shared, .scalar (.int x)] [.ref shared, .scalar (.int y)] = _
      rw [HeapSort.lex, identity]
      change HeapSort.lex (HeapSort.compare (fuel + 1) heap true) (HeapSort.compare (fuel + 1) heap false)
        false [.scalar (.int x)] [.scalar (.int y)] = _
      have equal : HeapSort.compare (fuel + 1) heap true (.scalar (.int x)) (.scalar (.int y)) =
          some (.ok (decide (x = y))) := rfl
      have less : HeapSort.compare (fuel + 1) heap false (.scalar (.int x)) (.scalar (.int y)) =
          some (.ok (decide (x < y))) := rfl
      rw [HeapSort.lex, equal]
      by_cases same : x = y <;> simp [HeapSort.lex, less, same]
  have dispatch := compare_order_sequences heap isTuple false left right _ _ leftFound rightFound
  simp only [Bool.false_eq_true, ↓reduceIte] at dispatch
  rw [dispatch, sequenceCompare_eq]
  have allowance : heap.length + 1 = fuel + 2 := by omega
  rw [allowance, raw]
  rfl

theorem shared_prefix_source (heap : Mutable.Heap) (isTuple : Bool) (left right shared : Nat) (x y : Int)
    (leftFound : heap[left]? = some (comparisonObject isTuple [.ref shared, .scalar (.int x)]))
    (rightFound : heap[right]? = some (comparisonObject isTuple [.ref shared, .scalar (.int y)]))
    (sharedInside : shared < heap.length) :
    ReturnsValue Probe.module "ordered" [.ref left, .ref right] heap (.ref heap.length)
      (resultHeap heap left right (decide (x < y))) :=
  source_returns heap left right _ (shared_prefix_order heap isTuple left right shared x y
    leftFound rightFound sharedInside)

def equalityHeap (heap : Mutable.Heap) (left right : Nat) (same different : Bool) : Mutable.Heap :=
  heap ++ [.list [.scalar (.bool same), .scalar (.bool different), .ref left, .ref right]]

theorem source_equal_returns (heap : Mutable.Heap) (left right : Nat) (same different : Bool)
    (equal : HeapCalls.compare .eq (.ref left) (.ref right) heap = some (.ok (.scalar (.bool same)), heap))
    (unequal : HeapCalls.compare .notEq (.ref left) (.ref right) heap = some (.ok (.scalar (.bool different)), heap)) :
    ReturnsValue Probe.module "equal" [.ref left, .ref right] heap (.ref heap.length)
      (equalityHeap heap left right same different) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.assign (Evaluates.compare (Evaluates.lookup rfl) (Evaluates.lookup rfl) equal)
  apply BlockReturns.assign (Evaluates.compare (Evaluates.lookup rfl) (Evaluates.lookup rfl) unequal)
  exact BlockReturns.return_value
    (Evaluates.list (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl)
      (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))))

theorem paired_equal_returns (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (isTuple : Bool)
    (left right : Nat) (xs ys : List Mutable.Value) (same different : Bool)
    (leftFound : logical[left]? = some (comparisonObject isTuple xs))
    (rightFound : logical[right]? = some (comparisonObject isTuple ys))
    (equal : HeapCalls.compare .eq (.ref left) (.ref right) logical = some (.ok (.scalar (.bool same)), logical))
    (unequal : HeapCalls.compare .notEq (.ref left) (.ref right) logical =
      some (.ok (.scalar (.bool different)), logical)) :
    ∃ nextMap,
      ReturnsValue Probe.module "equal" [.ref left, .ref right] logical (.ref logical.length)
        (equalityHeap logical left right same different) ∧
      ReturnsValue Probe.module "equal" [.ref (rename left), .ref (rename right)] physical (.ref physical.length)
        (equalityHeap physical (rename left) (rename right) same different) ∧
      ExecutionLayout (equalityHeap logical left right same different)
        (equalityHeap physical (rename left) (rename right) same different) nextMap ∧
      nextMap logical.length = physical.length ∧
      (∀ index < logical.length, nextMap index = rename index) := by
  have otherEqual := layout.runtime.compare_equal_sequences layout.closed isTuple false left right xs ys
    leftFound rightFound _ _ equal
  have otherUnequal := layout.runtime.compare_equal_sequences layout.closed isTuple true left right xs ys
    leftFound rightFound _ _ unequal
  have leftInside := (List.getElem?_eq_some_iff.mp leftFound).1
  have rightInside := (List.getElem?_eq_some_iff.mp rightFound).1
  have inside : ∀ value ∈ [Mutable.Value.scalar (.bool same), .scalar (.bool different), .ref left, .ref right],
      value.edge.Within logical.length := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq,
      Mutable.Value.edge, Graph.Edge.Within]
    exact ⟨trivial, trivial, leftInside, rightInside⟩
  have retained := (layout.allocate_list [.scalar (.bool same), .scalar (.bool different), .ref left, .ref right] inside).2.2
  refine ⟨extendMap rename logical.length physical.length,
    source_equal_returns logical left right same different equal unequal,
    source_equal_returns physical (rename left) (rename right) same different otherEqual otherUnequal,
    ?_, extendMap_new _ _ _, ?_⟩
  · simpa only [equalityHeap, List.map_cons, List.map_nil, relocateValue] using retained
  · exact fun index bound => extendMap_old _ _ _ _ bound

#print axioms source_returns
#print axioms paired_returns
#print axioms source_failed
#print axioms paired_failures
#print axioms compare_identity
#print axioms shared_prefix_order
#print axioms shared_prefix_source
#print axioms lex_extends
#print axioms lex_relocates
#print axioms compare_step_extends
#print axioms compare_extends
#print axioms RuntimeLayout.compareFuel
#print axioms injective_below_le
#print axioms RuntimeLayout.length_le
#print axioms RuntimeLayout.compare_result
#print axioms sequenceCompare_eq
#print axioms sequenceCompare_keeps_heap
#print axioms RuntimeLayout.sequenceCompare
#print axioms ExecutionLayout.sequenceCompare
#print axioms comparisonObject_relocates
#print axioms compare_order_sequences
#print axioms RuntimeLayout.compare_order_sequences
#print axioms equalElements_relocates
#print axioms equalLists_relocates
#print axioms compare_equal_sequences
#print axioms RuntimeLayout.compare_equal_sequences
#print axioms source_equal_returns
#print axioms paired_equal_returns
end ComparisonRelocationExamples
'''

with project_temporary_directory(prefix="comparison-relocation-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    ordered = namespace["ordered"]
    equal = namespace["equal"]
    cycle = []
    cycle.append(cycle)
    for shape in (list, tuple):
        for shared in (cycle, (cycle,), {1: cycle}, object()):
            for x, y in ((0, 0), (-1, 2), (2**180, -2**190)):
                left, right = shape((shared, x)), shape((shared, y))
                result = ordered(left, right)
                assert result[0] is left and result[1] is right and result[2] == (x < y)
                result = equal(left, right)
                assert result[:2] == [x == y, x != y] and result[2] is left and result[3] is right
        for left, right, expected in (([], [], False), ([True], [1], False),
                                      ([[]], [[1]], True), ([(1, 2)], [(1, 3)], True),
                                      ([0, object()], [1, object()], True)):
            left, right = shape(left), shape(right)
            result = ordered(left, right)
            assert result[0] is left and result[1] is right and result[2] is expected
        for left, right, expected in (([], [], True), ([True], [1], True),
                                      ([[1, 2]], [[True, 2]], True), ([[1]], [[2]], False),
                                      ([cycle], [cycle], True), ([0, cycle], [1, cycle], False)):
            left, right = shape(left), shape(right)
            result = equal(left, right)
            assert result[:2] == [expected, not expected] and result[2] is left and result[3] is right
        result = equal(cycle, cycle)
        assert result[:2] == [True, False] and result[2] is cycle and result[3] is cycle
        left, right = shape((cycle, None)), shape((cycle, 1))
        try:
            ordered(left, right)
        except TypeError:
            assert left[0] is cycle and right[0] is cycle and cycle[0] is cycle
        else:
            raise AssertionError("nested ordering should reject None versus int")
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    proof = directory / "Checks.lean"
    proof.write_text("import lang.py.FormalSW.ComparisonRelocation\n"
                     + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF)
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(proof)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == 28, checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print("comparison relocation: native allowances, ordering, equality, cyclic aliases, and failures; 28 axiom audits passed")

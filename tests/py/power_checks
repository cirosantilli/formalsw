#!/usr/bin/env python3
"""Check integer powers and prevent partial execution from satisfying contracts."""
import ast
import json
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))
api = runpy.run_path(str(REPO / 'formalsw'))
from lang.py.support import SupportChecker


def constant(value):
    if value is None:
        return '.none'
    if isinstance(value, bool):
        return f'(.bool {str(value).lower()})'
    if isinstance(value, int):
        return f'(.int ({value}))'
    return f'(.string {json.dumps(value)})'


equations = []
for base in (*range(-5, 6), True, False, None, 'bad'):
    for exponent in (*range(9), True, False, None, 'bad'):
        try:
            expected = f'Except.ok {constant(base ** exponent)}'
        except TypeError:
            expected = 'Except.error { typeName := "TypeError", args := [] }'
        equations.append(f'example : scalarBinary .pow {constant(base)} {constant(exponent)} = some ({expected}) := by decide')
        equations.append(f'example : Calls.Primitive.apply (.builtin .pow) [{constant(base)}, {constant(exponent)}] = some ({expected}) := by decide')
equations.extend([
    'example : scalarBinary .pow (.int 2) (.int (-1)) = none := rfl',
    'example : scalarBinary .pow (.int 0) (.int (-1)) = none := rfl',
    'example : Calls.Primitive.apply (.builtin .pow) [.int 2, .int (-1)] = none := rfl',


    'example : HeapCalls.primitive (.builtin .pow) [.scalar (.int 0), .scalar (.int (-1))] [] = none := rfl',
    'example : HeapCalls.primitive (.builtin .pow) [.ref 0, .scalar (.int 2)] [.instance "probe" "Custom" []] = none := rfl',
    'example : HeapCalls.primitive (.builtin .pow) [.scalar (.int 2), .ref 99] [] = none := rfl',
    'example : HeapCalls.primitive (.builtin .pow) [.ref 0, .scalar (.int 2)] [.list []] = some (.error ⟨"TypeError", []⟩, [.list []]) := rfl',
    'example : ¬ (Execution.unsupported : Execution Constant).Supported := by intro h; exact h 1 rfl',
    'private def spin : Execution Constant := ⟨Unit, (), fun state => .next state⟩',
    'example : spin.Supported := Execution.Diverges.supported ⟨fun _ => True, trivial, fun _ _ => ⟨(), rfl, trivial⟩⟩',
])

# Compare scalar and heap calls with Python, including inverse failures, signed
# moduli, Boolean coercions, explicit None and zero-modulus exceptions.
for base in (*range(-3, 4), True, False, None, 'bad'):
    for exponent in (*range(-2, 4), True, False, None, 'bad'):
        for modulus in (-5, -2, -1, 0, 1, 2, 5, True, False, None, 'bad'):
            if (modulus is None and isinstance(base, int)
                    and isinstance(exponent, int) and exponent < 0):
                expected = None  # Two-argument float results remain outside the model.
            else:
                try:
                    expected = f'Except.ok {constant(pow(base, exponent, modulus))}'
                except (TypeError, ValueError) as error:
                    expected = 'Except.error { typeName := "' + type(error).__name__ + '", args := [] }'
            values = ', '.join(constant(value) for value in (base, exponent, modulus))
            heap_values = ', '.join('.scalar ' + constant(value) for value in (base, exponent, modulus))
            scalar_result = 'none' if expected is None else 'some (' + expected + ')'
            heap_result = 'none' if expected is None else 'some (' + expected + ', [])'
            equations.append(f'example : Calls.Primitive.apply (.builtin .pow) [{values}] = {scalar_result} := by decide')
            # Wrap scalar completions for the heap representation.
            if expected is not None:
                heap_outcome = expected.replace('Except.ok ', 'Except.ok (.scalar ', 1) + ')' if expected.startswith('Except.ok ') else expected
                heap_result = 'some (' + heap_outcome + ', [])'
            equations.append(f'example : HeapCalls.primitive (.builtin .pow) [{heap_values}] [] = {heap_result} := by decide')
equations.extend([
    'example : HeapCalls.primitive (.builtin .pow) [.ref 0, .scalar (.int 2), .scalar (.int 3)] [.instance "probe" "Custom" []] = none := rfl',
    'example : HeapCalls.primitive (.builtin .pow) [.ref 0, .scalar (.int 2), .scalar (.int 3)] [.list []] = some (.error ⟨"TypeError", []⟩, [.list []]) := rfl',
])

# Large exponents must remain practical in kernel-checked builtin calls.
# Expected values come from Python pow, independently of the Lean implementation.
for base, exponent, modulus in (
    (2, 1000000007, 688590081),
    (-1000003, 1000000007, 1000000007),
    (1795265022, 172140960, 688590081),
    (9780504, 1208925819614629174706177, 170141183460469231731687303715884105727),
    (0, 340282366920938463463374607431768211456, 97),
    (7, 0, 97),
):
    expected = constant(pow(base, exponent, modulus))
    values = ', '.join(constant(value) for value in (base, exponent, modulus))
    heap_values = ', '.join('.scalar ' + constant(value) for value in (base, exponent, modulus))
    equations.append(f'set_option maxRecDepth 4096 in\nexample : Calls.Primitive.apply (.builtin .pow) [{values}] = some (Except.ok {expected}) := by decide')
    equations.append(f'set_option maxRecDepth 4096 in\nexample : HeapCalls.primitive (.builtin .pow) [{heap_values}] [] = some (Except.ok (.scalar {expected}), []) := by decide')

with project_temporary_directory(prefix='power-check-') as directory:
    directory = Path(directory)
    proof = directory / 'PrimitiveChecks.lean'
    proof.write_text('import FormalSW\nopen FormalSW.PyAst\n' + '\n'.join(equations) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=REPO, check=True)

    source = '''
def touch(events: list[int], n: int) -> int:
    events.append(n)
    return n
def fail(events: list[int]) -> int:
    events.append(1)
    return 1 // 0
def ordered(events: list[int]) -> int:
    return pow(touch(events, 2), touch(events, 3))
def stopped(events: list[int]) -> int:
    return pow(fail(events), touch(events, 3))
def ordered_mod(events: list[int]) -> int:
    return pow(touch(events, 2), touch(events, 3), touch(events, 5))
def stopped_mod(events: list[int]) -> int:
    return pow(fail(events), touch(events, 3), touch(events, 5))
def middle_failure(events: list[int]) -> int:
    return pow(touch(events, 2), fail(events), touch(events, 5))
def zero_mod(events: list[int]) -> int:
    return pow(touch(events, 2), touch(events, 3), touch(events, 0))
def scalar(a: int, b: int) -> int:
    return pow(a, b)
def scalar_mod(a: int, b: int, m: int) -> int:
    return pow(a, b, m)
'''
    module = ast.parse(source)
    for name in ('ordered', 'stopped', 'ordered_mod', 'stopped_mod', 'middle_failure', 'zero_mod', 'scalar', 'scalar_mod'):
        assert not SupportChecker(module).check(name)
    (directory / 'source.json').write_text(api['AstJsonEmitter'](module).emit())
    world = {}
    exec(source, world)
    lines = ['import FormalSW', 'open FormalSW.PyAst',
             'def source : Module := pyast_from_json% (include_str "source.json")']
    for name in ('ordered', 'stopped', 'ordered_mod', 'stopped_mod', 'middle_failure', 'zero_mod'):
        events = []
        try:
            result = world[name](events)
            outcome = f'.ok (.scalar {constant(result)})'
        except (ZeroDivisionError, ValueError) as error:
            outcome = '.error ⟨"' + type(error).__name__ + '", []⟩'
        values = ', '.join(f'.scalar {constant(value)}' for value in events)
        lines.append(f'example : (match (HeapCalls.call source "{name}" [.ref 0] [.list []]).execution.observe 500 with\n'
                     f'  | .done (.ok c) => c.outcome == {outcome} && c.heap[0]? == some (.list [{values}])\n'
                     '  | _ => false) = true := by native_decide')
    lines.extend([
        'example : (Calls.function source "scalar" [.int (-2), .int 3]).observe 100 = .done (.ok (.int (-8))) := by decide',
        'example : (Calls.function source "scalar" [.int 2, .int (-1)]).observe 100 = .unsupported := by decide',
    ])
    proof.write_text('\n'.join(lines) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=REPO, check=True)

    for expression in ('pow(n)', 'pow(n, 2, 3, 4)', 'pow(base=n, exp=2)', 'pow(n, 2, mod=3)'):
        assert SupportChecker(ast.parse(f'def f(n: int):\n    return {expression}\n')).check('f')
    plain = 'def f(n: int):\n    return pow(n, 2)\n'
    for suffix in ('pow = 3\n', 'from other import pow\n'):
        module = ast.parse(plain + suffix)
        assert SupportChecker(module).check('f')
        assert api['AstJsonEmitter'](module).expr(module.body[0].body[0].value)['type'] == 'Call'
    assert SupportChecker(ast.parse(plain.replace('f(n: int)', 'f(n: int, pow: int)'))).check('f')
    for runtime in ('scalarFunction', 'scalarFunctionWithGlobals', 'Mutable.function'):
        assert SupportChecker(ast.parse(plain)).requirement('f',
            f'theorem wrong : Not ({runtime} Probe.module "f" [.int 2]).Returns'), runtime

    def requirements(name, text):
        source = directory / (name + '.py')
        source.write_text(text)
        program = api['source_module'](source)
        return api['collect_requirements'](source, program, 'Probe', 'ProbeAst')

    for marker in ('Returns', 'Not Halts', 'Equiv(f)', 'Not Equiv(f)', 'EquivReturn(f)'):
        text = f'def f(n: int):\n    """\n    @formalsw: {marker}\n    """\n    return 2 ** -1\n'
        obligations = requirements('negative_' + str(len(list(directory.iterdir()))), text)
        coverage = [r for r in obligations if r.marker == 'execution model coverage']
        assert len(coverage) == 1
        assert '.Supported' in coverage[0].property_type
        assert 'Not' not in coverage[0].property_type
        builtin = requirements('builtin_' + str(len(list(directory.iterdir()))), text.replace('2 ** -1', 'pow(2, -1)'))
        builtin_coverage = [r for r in builtin if r.marker == 'execution model coverage']
        assert len(builtin_coverage) == 1 and '.Supported' in builtin_coverage[0].property_type

    # A partial predicate must not silently remove inputs from the domain.
    obligations = requirements('predicate', 'def f(n: int):\n    """\n'
        '    @formalsw: Requires(2 ** -1 > 0)\n    @formalsw: Returns\n    """\n    return n\n')
    coverage = next(r for r in obligations if r.marker == 'precondition model coverage')
    assert '.evaluate ' in coverage.property_type and 'Condition' not in coverage.property_type

    # Equivalence checks both implementations, including a partial counterpart
    # whose parameter spelling differs from the caller's spelling.
    obligations = requirements('counterpart', 'def f(n: int):\n    """\n'
        '    @formalsw: Equiv(g)\n    """\n    return n\n'
        'def g(x: int):\n    return x ** -1\n')
    coverage = next(r for r in obligations if r.marker == 'execution model coverage')
    assert '"f" [.int «n»]' in coverage.property_type
    assert '"g" [.int «n»]' in coverage.property_type
    assert '«x»' not in coverage.property_type

    obligations = requirements('raw_dependency', 'def f(n: int):\n    """\n'
        '    @formalsw: theorem referenced : Not (Calls.function ProbeAst.module "g" [.int 0]).Halts\n'
        '    """\n    return n\n'
        'def g(n: int):\n    return 2 ** -1\n')
    assert any(r.theorem_name == 'Probe.g.«Supported»' for r in obligations)

    # A reflexive equivalence theorem really is provable for unsupported runs,
    # but it must not pass the CLI without the independent coverage obligation.
    source = directory / 'vacuous.py'
    source.write_text('def f(n: int):\n    """\n'
        '    @formalsw: Equiv(f)\n    """\n    return 2 ** -1\n')
    stub = subprocess.run([str(REPO / 'formalsw'), '--stub', str(source)],
                          cwd=REPO, text=True, capture_output=True, check=True).stdout
    before_coverage = stub.split('theorem f.«Supported»')[0]
    namespace = next(line for line in stub.splitlines() if line.startswith('namespace ')).split(' ', 1)[1]
    source.with_suffix('.py.lean').write_text(before_coverage.replace('  sorry', '  intro n outcome\n  rfl')
                                            + f'end {namespace}\n')
    rejected = subprocess.run([str(REPO / 'formalsw'), str(source)], cwd=REPO, text=True, capture_output=True)
    assert rejected.returncode != 0 and 'Supported' in rejected.stdout + rejected.stderr
    assert 'Unknown identifier' in rejected.stdout + rejected.stderr, rejected.stdout + rejected.stderr

subprocess.run([sys.executable, str(REPO / 'tests/py/powers.py')], check=True)
print('Integer operators and builtin pow: Python comparisons, argument effects, and coverage checks passed')

#!/usr/bin/env python3
"""Check conservative coverage of recursive call dependencies."""
import ast
from pathlib import Path
import sys
import textwrap
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from lang.py.support import SupportChecker


def issues(source):
    return SupportChecker(ast.parse(textwrap.dedent(source))).check("f")


base = """
def f(n: int) -> int:
    return g(n)
def g(n: int) -> int:
    return n
"""
assert not issues(base)
for suffix in (
    "import other as g\n",
    "from other import g\n",
    "from other import *\n",
    "class g: pass\n",
    "if True:\n    def g(n: int): return n + 1\n",
    "del g\n",
    "g = 1\n",
):
    assert issues(base + suffix), suffix

for body in (
    'return missing(n)',
    'if False: print(n)\n    return n',
    'global counter\n    counter = n\n    return n',
    'g = n\n    return n',
    'a, b = (n,)\n    return a',
    'a, *b = n, n + 1\n    return a',
    '(a, b), c = (n, n), n\n    return c',
):
    assert issues(base.replace('return n', body)), body
assert issues(base.replace('g(n: int)', 'g(n: int = 0)'))
assert issues(base.replace('g(n: int)', 'g(n: list[int])'))
assert not issues(base.replace('return n', 'return f(n - 1) if n else 0'))
range_source = base.replace('return g(n)', 'for k in range(n, 0, -1):\n        n = g(n)\n    return n')
assert not issues(range_source)
for suffix in ('range = g\n', 'from other import range\n', 'from other import *\n', 'del range\n'):
    assert issues(range_source + suffix), suffix
for replacement in ('range()', 'range(n, 0, -1, 2)', 'range(n, stop=0)', 'iter(n)'):
    assert issues(range_source.replace('range(n, 0, -1)', replacement)), replacement
assert issues(range_source.replace('def f(n: int)', 'def f(n: int, range: int)'))
assert issues(range_source.replace('n = g(n)', 'break'))
assert issues(range_source.replace('n = g(n)', 'continue'))
sqrt_source = 'from math import isqrt as root\ndef f(n: int) -> int:\n    return root(n)\n'
assert not issues(sqrt_source)
for suffix in ('root = f\n', 'from other import root\n', 'del root\n'):
    assert issues(sqrt_source + suffix), suffix
assert issues(sqrt_source.replace('return root(n)', 'root = n\n    return root(n)'))
assert issues(sqrt_source.replace('root(n)', 'root(n, n)'))
assert issues(sqrt_source.replace('root(n)', 'root(n=n)'))
assert issues(sqrt_source.replace('from math ', 'from other '))
with tempfile.TemporaryDirectory(prefix='formalsw-math-shadow-') as directory:
    program = ast.parse(sqrt_source)
    program.formalsw_source = Path(directory) / 'probe.py'
    (Path(directory) / 'math.py').write_text('def isqrt(n): return n\n')
    assert any('shadows the modeled standard library' in issue.reason
               for issue in SupportChecker(program).check('f'))
sum_source = 'def f(n: int) -> int:\n    return sum(x for x in range(n) if x % 2 == 0)\n'
assert not issues(sum_source)
for suffix in ('sum = f\n', 'range = f\n', 'from other import sum\n', 'from other import *\n'):
    assert issues(sum_source + suffix), suffix
for expression in (
    'sum(x for x in range(n) for y in range(n))',
    'sum((x for x in range(n)), 1)',
    'sum(x for x in range(n) if missing(x))',
    'sum(x for x in range(n)) + x',
    'x + sum(x for x in range(n))',
    'sum(f(n) for f in range(n))',
    'sum(x for x in range(n, stop=1))',
):
    source = sum_source.replace('sum(x for x in range(n) if x % 2 == 0)', expression)
    assert issues(source), expression
assert issues(sum_source.replace('def f(n: int)', 'def f(n: int, sum: int)'))
assert not issues(sum_source.replace('sum(x for x in range(n) if x % 2 == 0)',
                                   'sum(n for n in range(n)) + n'))
print("Recursive call coverage passed")

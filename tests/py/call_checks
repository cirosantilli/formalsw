subprocess.run([sys.executable, str(Path(__file__).with_name('assertion_checks'))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name('power_checks'))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("default_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("heap_call_checks"))], check=True)

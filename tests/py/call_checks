subprocess.run([sys.executable, str(Path(__file__).with_name("set_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("tuple_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("sorted_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("raise_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("enumerate_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("comprehension_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("unpack_loop_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("math_gcd_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("math_comb_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("minimum_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("divmod_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("dictionary_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("dictionary_input_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("heap_global_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("global_contract_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("math_module_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("range_sum_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("sequence_sum_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("bit_length_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("int_conversion_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("integer_parsing_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("sequence_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("heap_input_checks"))], check=True)
subprocess.run([sys.executable, str(Path(__file__).with_name("nested_input_checks"))], check=True)
print("Recursive call and loop-control coverage passed")

#!/usr/bin/env python3
"""
Compare class calls with Python, including binding order, aliases, and errors.
"""
import ast
import json
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.object_snapshot import snapshot_roots
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))

source = '''
from dataclasses import dataclass
import dataclasses as dc
@dataclass(frozen=True)
class Frozen:
    value: int
    items: list[int]
    def append(self, n: int) -> int:
        self.items.append(n)
        return self.value
@dataclass
class Record:
    value: int
@dc.dataclass(frozen=True)
class OtherFrozen:
    value: int
    items: list[int]
@dataclass
class EmptyRecord:
    pass
class Box:
    def __init__(self, value: int = 0) -> None:
        self.value: int = value
    def bump(self, n: int) -> int:
        self.value += n
        return self.value
    def append(self, n: int) -> int:
        return self.bump(n)
    def add(self, n: int) -> int:
        return self.bump(n)
    def fail(self, items: list[int], n: int) -> int:
        items.append(n)
        return n // 0
class Empty:
    pass
class BadInit:
    def __init__(self, items: list[int], n: int) -> None:
        items.append(n)
        return n
class RaiseInit:
    def __init__(self, items: list[int], n: int) -> None:
        items.append(n)
        raise ValueError()
def mark(items: list[int], n: int) -> int:
    items.append(n)
    return n
def receiver(items: list[int], box: Box) -> Box:
    items.append(100)
    return box
def shadow(items: list[int], box: Box, n: int) -> int:
    items.append(n)
    box.bump = 0
    return n
def replace(box: Box, n: int) -> int:
    box.value = 999
    return n
'''

variants = {
    'dataclass_init': 'return Frozen(n, items)',
    'dataclass_read': 'return Frozen(n, items).value',
    'dataclass_missing_argument': 'return Frozen(mark(items, n))',
    'dataclass_extra_argument': 'return Frozen(mark(items, n), items, mark(items, 2))',
    'dataclass_empty': 'return EmptyRecord()',
    'dataclass_empty_equality': 'return EmptyRecord() == EmptyRecord()',
    'dataclass_mutable': 'box = Record(n)\nbox.value += 1\nbox.extra = items\nreturn box',
    'dataclass_frozen_write': 'box = Frozen(n, items)\nbox.value = mark(items, 2)\nreturn box',
    'dataclass_frozen_new_field': 'box = Frozen(n, items)\nbox.extra = mark(items, 2)\nreturn box',
    'dataclass_frozen_augmented': 'box = Frozen(n, items)\nbox.value += mark(items, 2)\nreturn box',
    'dataclass_frozen_list': 'box = Frozen(n, items)\nbox.items += [n]\nreturn box',
    'dataclass_method': 'return Frozen(n, items).append(n)',
    'dataclass_equality': 'return Frozen(n, items) == Frozen(n, items)',
    'dataclass_difference': 'return Frozen(n, items) != Frozen(n + 1, items)',
    'dataclass_extra_equality': 'box = Record(n)\nbox.extra = items\nreturn box == Record(n)',
    'dataclass_other_class': 'return Frozen(n, items) == OtherFrozen(n, items)',
    'dataclass_plain_class': 'return Frozen(n, items) == Box(n)',
    'dataclass_ordering': 'return Frozen(n, items) < Frozen(n, items)',
    'dataclass_truth': 'return Frozen(n, items) and n',
    'dataclass_length': 'return len(Frozen(n, items))',
    'dataclass_missing_field': 'return Frozen(n, items).missing',
    'dataclass_missing_method': 'return Frozen(n, items).missing(mark(items, n))',
    'default_init': 'return Box().value',
    'init_arguments': 'return Box(mark(items, n)).value',
    'init_arity': 'return Box(mark(items, n), mark(items, 2))',
    'empty': 'return Empty()',
    'empty_arity': 'return Empty(mark(items, n))',
    'bad_init': 'return BadInit(items, n)',
    'raise_init': 'return RaiseInit(items, n)',
    'shared_alias': 'box = Box(n)\nalias = box\nbox.bump(2)\nreturn alias.value',
    'nested_receiver': 'return Box(n).bump(2)',
    'return_instance': 'return Box(n)',
    'cycle': 'box = Box(n)\nbox.other = box\nreturn box',
    'field_alias': 'box = Box(n)\nbox.items = items\nbox.items.append(n)\nreturn box.items',
    'missing_method': 'return Box(n).missing(mark(items, n))',
    'missing_field': 'return Box(n).missing',
    'method_arity': 'return Box(n).bump(mark(items, n), mark(items, 2))',
    'method_error': 'return Box(n).fail(items, n)',
    'shadowed_method': 'box = Box(n)\nbox.bump = 0\nreturn box.bump(mark(items, n))',
    'bound_before_arguments': 'box = Box(n)\nreturn box.bump(shadow(items, box, n))',
    'assignment_order': 'box = Box(1)\nreceiver(items, box).value = mark(items, n)\nreturn box.value',
    'augmented_order': 'box = Box(1)\nreceiver(items, box).value += mark(items, n)\nreturn box.value',
    'augmented_old_value': 'box = Box(1)\nbox.value += replace(box, n)\nreturn box.value',
    'annotation_only': 'box = Box(n)\nreceiver(items, box).missing: UnknownAnnotation\nreturn box.value',
    'append_method': 'return Box(n).append(mark(items, 2))',
    'add_method': 'return Box(n).add(mark(items, 2))',
    'append_arity': 'return Box(n).append(mark(items, 1), mark(items, 2))',
    'different_instances': 'return Box(n) == Box(n)',
    'same_instance': 'box = Box(n)\nalias = box\nreturn box == alias',
}
partial = {
    'builtin_method_value': 'return items.append',
    'integer_method_value': 'return n.bit_length',
    'instance_method_value': 'return Box(n).bump',
}
unsupported_equality = {'dataclass_nested_equality': 'return Frozen(n, [n]) == Frozen(n, [n])'}
for name, body in (variants | partial | unsupported_equality).items():
    source += f'\ndef {name}(items: list[int], n: int):\n' + ''.join(f'    {line}\n' for line in body.splitlines())


def data(value):
    if type(value) is list:
        return '.list [' + ', '.join(map(data, value)) + ']'
    if value is None:
        return '.scalar .none'
    if type(value) is bool:
        return f'.scalar (.bool {str(value).lower()})'
    if type(value) is int:
        return f'.scalar (.int ({value}))'
    if type(value) is str:
        return f'.scalar (.string {json.dumps(value, ensure_ascii=False)})'
    raise AssertionError(value)


with project_temporary_directory(prefix='class-calls-') as temporary:
    directory = Path(temporary)
    path = directory / 'source.py'
    path.write_text(source)
    module = api['source_module'](path)
    checker = SupportChecker(module)
    namespace = {}
    exec(compile(source, str(path), 'exec'), namespace)
    classes = {id(value): name for name, value in namespace.items() if isinstance(value, type)}
    checks = []
    for name in variants:
        issues = checker.check(name, heap_calls=True)
        assert not issues, (name, issues)
        for n in (-3, 0, 7):
            items = [4]
            try:
                result = namespace[name](items, n)
            except Exception as error:
                expected_outcome = f'outcome matches .error {{typeName := {json.dumps(type(error).__name__)}, args := _}}'
                observed = snapshot_roots([items])
            else:
                expected_outcome = 'outcome matches .ok _'
                observed = snapshot_roots([items, result])
            for node in observed[1]:
                if type(node[0]) is list:
                    node[0] = ['static_object', str(path.resolve()), classes[node[0][1]]]
            checks.append(f'''
-- {name}({n})
example : (match (HeapCalls.call Probe.module {json.dumps(name)} [.ref 0, .scalar (.int ({n}))]
    [.list [.scalar (.int 4)]]).execution.observe 2000 with
  | .done (.ok completion) =>
      let outcome := completion.outcome
      ({expected_outcome}) && (Graph.observedBool
        ((Graph.compare completion.snapshot ({data(observed)})).observe 2000) == some true)
  | _ => false) = true := by native_decide
''')
    for name in partial:
        assert callable(namespace[name]([4], 7))
        checks.append(f'''
example : (HeapCalls.call Probe.module {json.dumps(name)} [.ref 0, .scalar (.int 7)]
    [.list [.scalar (.int 4)]]).execution.observe 200 = .unsupported := by native_decide
''')
    for name in unsupported_equality:
        assert namespace[name]([4], 7) is True
        checks.append(f'''
example : (HeapCalls.call Probe.module "{name}" [.ref 0, .scalar (.int 7)]
    [.list [.scalar (.int 4)]]).execution.observe 200 = .unsupported := by native_decide
''')
    document = directory / 'source.json'
    document.write_text(api['AstJsonEmitter'](module).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('import lang.py.FormalSW.HeapCalls\n' + api['AstLeanBridgeEmitter'](document, 'Probe', module).emit()
                     + 'open FormalSW.PyAst\nset_option maxRecDepth 8192\n' + '\n'.join(checks))
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

    data_helper = directory / 'data_helper.py'
    data_helper.write_text('''
from dataclasses import dataclass as record
@record(frozen=True)
class ImportedDate:
    year: int
    month: int
    day: int
def make_date(n: int) -> int:
    return ImportedDate(n, 1, 1).year
''')
    data_caller = directory / 'data_caller.py'
    data_caller.write_text('''
from data_helper import make_date
def caller(n: int) -> int:
    """
    @formalsw: Returns
    """
    return make_date(n)
''')
    linked_data = api['source_module'](data_caller)
    assert not SupportChecker(linked_data).check('caller', heap_calls=True)
    document = directory / 'imported_data.json'
    document.write_text(api['AstJsonEmitter'](linked_data).emit())
    proof = directory / 'ImportedData.lean'
    proof.write_text('import lang.py.FormalSW.HeapCalls\n' + api['AstLeanBridgeEmitter'](document, 'ImportedData', linked_data).emit() + f'''
open FormalSW.PyAst
set_option maxRecDepth 8192
example : ImportedData.module.classOrigins = [("ImportedDate", {json.dumps(str(data_helper.resolve()))})] := rfl
example (n : Int) : (HeapCalls.scalarFunction ImportedData.module "caller" [.int n]).Returns :=
  ⟨.int n, Execution.finishes_of_observe (fuel := 100) rfl⟩
''')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

    # Shadowed standard-library modules must not be silently reinterpreted.
    (directory / 'dataclasses.py').write_text('def dataclass(cls): return cls\n')
    shadowed = ast.parse(data_helper.read_text())
    shadowed.formalsw_source = data_helper
    assert any('shadows the modeled standard library' in issue.reason
               for issue in SupportChecker(shadowed).check('make_date', heap_calls=True))

    helper = directory / 'helper.py'
    helper.write_text('''
class ImportedBox:
    def __init__(self, n: int) -> None:
        self.value = n
    def read(self) -> int:
        return self.value
def make(n: int) -> int:
    return ImportedBox(n).read()
''')
    caller = directory / 'caller.py'
    caller.write_text('''
from helper import make
def caller(n: int) -> int:
    """
    @formalsw: Returns
    """
    return make(n)
''')
    linked = api['source_module'](caller)
    assert not SupportChecker(linked).check('caller', heap_calls=True)
    imported_class = next(node for node in linked.body if isinstance(node, ast.ClassDef))
    assert imported_class.formalsw_origin == str(helper.resolve())
    document = directory / 'imported.json'
    document.write_text(api['AstJsonEmitter'](linked).emit())
    proof = directory / 'Imported.lean'
    proof.write_text('import lang.py.FormalSW.HeapCalls\n' + api['AstLeanBridgeEmitter'](document, 'Imported', linked).emit() + f'''
open FormalSW.PyAst
set_option maxRecDepth 8192
example : Imported.module.classOrigins = [("ImportedBox", {json.dumps(str(helper.resolve()))})] := rfl
example (n : Int) : (HeapCalls.scalarFunction Imported.module "caller" [.int n]).Returns :=
  ⟨.int n, Execution.finishes_of_observe (fuel := 100) rfl⟩
''')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

rejected = (
    'class Box(object):\n    pass',
    'class Box:\n    value = 0',
    'class Box:\n    def __getattr__(self, name: str): return 0',
    'class Box:\n    def __init__(self): self.__value = 1',
    'class Box:\n    @property\n    def value(self): return 0',
    'class Box:\n    def bump(self): return 0\n    def bump(self): return 1',
    'class Box:\n    def bit_length(self): return 1',
    'class Box:\n    pass\ndef patch():\n    Box.value = 1',
    'class Box:\n    pass\nBox = int',
    'from dataclasses import dataclass\n@dataclass(frozen=1)\nclass Box:\n    value: int',
    'from dataclasses import dataclass\n@dataclass(order=True)\nclass Box:\n    value: int',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    value: int = 0',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    value: int\n    value: str',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    __value: int',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    bit_length: int',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    def __post_init__(self): pass',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    def __init__(self): pass',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    value: int\n    def value(self): return 1',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    def value(self): return 1\n    value: int',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    value: int\n    def int(self): return 1',
    'from dataclasses import dataclass\nfrom typing import ClassVar as int\n@dataclass\nclass Box:\n    value: int',
    'from dataclasses import dataclass\n@dataclass\nclass Box:\n    value: int\ndataclass = int',
    'import dataclasses\n@dataclasses.dataclass\nclass Box:\n    value: int\ndataclasses.dataclass = int',
    'from other import dataclass\n@dataclass\nclass Box:\n    value: int',
)
for snippet in rejected:
    program = ast.parse(snippet + '\ndef run(n: int) -> int:\n    box = Box()\n    return n\n')
    assert SupportChecker(program).check('run', heap_calls=True), snippet

print(f'{len(checks)} class executions, imported class identity, and {len(rejected)} unsupported-class checks passed')

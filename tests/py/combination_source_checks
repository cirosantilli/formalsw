#!/usr/bin/env python3
"""
Compare fresh combination loops with Python, including snapshots and shared elements.
"""
import ast
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))
from lang.py.support import SupportChecker

api = runpy.run_path(str(REPO / 'formalsw'))
source_text = '''
from itertools import combinations as choose
import itertools as it


def trace(n: int) -> str:
    text = ""
    for row in choose([3, 1, 3], n):
        for value in row:
            text += str(value)
        text += ";"
    return text


def keyword(n: int) -> str:
    text = ""
    for first, second in it.combinations([3, 1, 3], r=n):
        text += str(first) + str(second) + ";"
    return text


def mixed() -> str:
    text = ""
    for row in it.combinations([2, 1], 1):
        text += str(row[0])
    for row in it.permutations([2, 1], 2):
        text += str(row[0]) + str(row[1])
    return text


def snapshot() -> str:
    pool = [1, 2, 3]
    text = ""
    for row in choose(pool, 2):
        pool[1] = 9
        pool.append(4)
        text += str(row[0]) + str(row[1])
    return text


def shared() -> str:
    pool = [[1], [2], [3]]
    total = 0
    for row in choose(pool, 2):
        row[0][0] += 1
        total += row[1][0]
    return str(total) + str(pool[0][0]) + str(pool[1][0]) + str(pool[2][0])


def control() -> str:
    text = ""
    for row in choose([1, 2, 3], 2):
        if row[0] == 1:
            continue
        text += str(row[1])
        break
    else:
        text += "else"
    return text


def empty() -> str:
    text = ""
    for row in choose([], 0):
        text += str(len(row))
    for row in choose([], 1):
        text += "unexpected"
    else:
        text += "else"
    return text

def range_rows(start: int, stop: int, step: int, count: int) -> str:
    text = ""
    for row in choose(range(start, stop, step), count):
        for value in row:
            text += str(value) + ","
        text += ";"
    return text


def range_permutations(stop: int) -> str:
    text = ""
    for row in it.permutations(range(stop), r=2):
        text += str(row[0]) + str(row[1]) + ";"
    return text


def touch(log: list[int], value: int) -> int:
    log.append(value)
    return value


def range_order(step: int) -> str:
    log = []
    text = ""
    for row in choose(range(touch(log, 1), touch(log, 4), touch(log, step)), touch(log, 2)):
        text += str(row[0]) + str(row[1]) + ";"
    for value in log:
        text += str(value) + ","
    return text


def range_error_order(step: int) -> str:
    for row in choose(range(0, 3, step), 1 // 0):
        pass
    return "unexpected"


def range_comprehension(stop: int) -> str:
    rows = [row[0] for row in it.permutations(range(stop), 1)]
    return str(len(rows))


def range_next(stop: int) -> str:
    return str(next((row[0] + row[1] for row in choose(range(stop), 2)), 99))


def range_default(stop: int) -> str:
    text = ""
    for row in it.permutations(range(stop)):
        for value in row:
            text += str(value)
        text += ";"
    return text


def copied_rows(count: int) -> str:
    rows = [list(row) for row in choose([3, 1, 3], count)]
    text = ""
    for row in rows:
        for value in row:
            text += str(value)
        text += ";"
    return text


def mutate_pool(pool: list[int], row: tuple[int, ...]) -> bool:
    pool[1] = 9
    pool.append(4)
    return row[0] != 2


def comprehension_snapshot() -> str:
    pool = [1, 2, 3]
    rows = [list(row) for row in choose(pool, 2) if mutate_pool(pool, row)]
    return str(rows[0][0]) + str(rows[0][1]) + str(rows[1][0]) + str(rows[1][1]) + str(len(pool))


def comprehension_shared() -> str:
    pool = [[1], [2], [3]]
    rows = [list(row) for row in choose(pool, 2)]
    rows[0][0][0] += 10
    return str(rows[1][0][0]) + str(pool[0][0]) + str(int(rows[0] is rows[1]))


def comprehension_identity() -> str:
    rows = [row for row in choose([1, 1], 1)]
    first = [row for row in choose([], 0)]
    second = [row for row in choose([], 0)]
    return str(int(rows[0] is rows[1])) + str(int(first[0] is second[0]))


def comprehension_nested() -> str:
    x = 7
    rows = [x + y for x in [1, 2] for y, in choose([x, x + 1], 1) if y > x]
    return str(rows[0]) + str(rows[1]) + str(x)


def comprehension_sets_dicts() -> str:
    values = {x + y for x, y in choose([1, 2, 2], r=2)}
    table = {x: y for x, y in choose([1, 2, 2], 2)}
    return str(len(values)) + str(table[1]) + str(table[2])


def grow(pool: list[int]) -> int:
    pool.append(4)
    return 2


def comprehension_arguments() -> str:
    pool = [1, 2]
    rows = [list(row) for row in choose(pool, grow(pool))]
    return str(len(rows)) + str(rows[2][1])


def consumed(count: int) -> str:
    total = sum(row[0] for row in choose([1, 2, 3], count))
    largest = max((row[0] for row in choose([1, 2, 3], count)), default=99)
    smallest = min((row[0] for row in choose([1, 2, 3], count)), default=99)
    values = list(row[0] for row in choose([1, 2, 3], count))
    packed = tuple(row[0] for row in choose([1, 2, 3], count))
    return str(total) + str(largest) + str(smallest) + str(len(values)) + str(len(packed))


def logged(log: list[int], row: tuple[int, ...]) -> bool:
    log.append(row[0])
    return row[0] != 0


def lazy_truth() -> str:
    log = []
    every = all(logged(log, row) for row in choose([1, 0, 2], 1))
    some = any(logged(log, row) for row in choose([0, 1, 2], 1))
    return str(int(every)) + str(int(some)) + str(len(log))


def sum_error_order(count: int) -> str:
    return str(sum((row[0] for row in choose([1, 2], count)), 1 // 0))


def combination_range_comp(stop: int) -> str:
    rows = [list(row) for row in choose(range(stop), 2)]
    return str(len(rows))


def stop() -> int:
    raise StopIteration


def stopped_pool() -> list[int]:
    raise StopIteration


def comprehension_error() -> str:
    rows = [stop() for row in choose([1], 1)]
    return str(len(rows))


def generator_error() -> str:
    rows = list(stop() for row in choose([1], 1))
    return str(len(rows))


def generator_creation_error() -> str:
    rows = list(row for row in choose(stopped_pool(), 1))
    return str(len(rows))


def generator_inner_error() -> str:
    rows = list(row for n in [1] for row in choose(stopped_pool(), n))
    return str(len(rows))

'''


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    return '.string ' + repr(value).replace("'", '"')


with project_temporary_directory(prefix='combinations-') as temporary:
    directory = Path(temporary)
    source = directory / 'program.py'
    source.write_text(source_text)
    program = api['source_module'](source)
    scope = runpy.run_path(str(source))
    cases = [(name, [length]) for name in ('trace', 'keyword')
             for length in (-1, 0, 1, 2, 3, 4, None, True, '2')]
    cases += [(name, []) for name in ('mixed', 'snapshot', 'shared', 'control', 'empty')]
    cases += [('range_rows', args) for args in
              ([0, 4, 1, 2], [4, -1, -2, 2], [2, 2, 1, 0], [0, 3, 1, 4],
               [0, 3, 1, -1], [0, 3, 0, 2], [0, 3, 1, '2'], [0, '3', 1, 2])]
    cases += [('range_permutations', [stop]) for stop in (-1, 0, 3)]
    cases += [('range_order', [step]) for step in (0, 1)]
    cases += [('range_error_order', [step]) for step in (0, 1, 'bad')]
    cases += [(name, [stop]) for name in ('range_comprehension', 'range_next', 'range_default')
              for stop in (0, 3)]
    cases += [('copied_rows', [count]) for count in (-1, 0, 1, 2, 3, 4, None, True, '2')]
    cases += [(name, []) for name in ('comprehension_snapshot', 'comprehension_shared',
              'comprehension_identity', 'comprehension_nested', 'comprehension_sets_dicts',
              'comprehension_arguments', 'lazy_truth', 'comprehension_error', 'generator_error',
              'generator_creation_error', 'generator_inner_error')]
    cases += [('consumed', [count]) for count in (-1, 0, 1, 2, 4)]
    cases += [('sum_error_order', [count]) for count in (-1, 1, 'bad')]
    cases += [('combination_range_comp', [stop]) for stop in (-1, 0, 4)]
    for name in scope:
        if name in {case[0] for case in cases}:
            issues = SupportChecker(program).check(name)
            assert not issues, issues
    (directory / 'program.json').write_text(api['AstJsonEmitter'](program).emit())
    lines = ['import lang.py.FormalSW.CombinationCalls', 'open FormalSW.PyAst',
             'def program : Module := pyast_from_json% (include_str "program.json")']
    expected = []
    for index, (name, arguments) in enumerate(cases):
        try:
            outcome = 'ok:' + scope[name](*arguments)
        except Exception as error:
            outcome = 'error:' + type(error).__name__
        expected.append(f'case{index}:' + outcome)
        values = ', '.join(constant(value) for value in arguments)
        lines.append(f'''
#eval IO.println ("case{index}:" ++
  match (HeapCalls.scalarFunction program "{name}" [{values}]).observe 20000 with
  | .done (.ok (.string text)) => "ok:" ++ text
  | .done (.error error) => "error:" ++ error.typeName
  | _ => "unfinished or unexpected result")''')
    # A module function named range remains an ordinary function call.
    custom_source = directory / 'custom_range.py'
    custom_source.write_text("""
from itertools import combinations

def range(n: int) -> list[int]:
    return [n, n + 1]

def custom() -> int:
    total = 0
    for row in combinations(range(3), 1):
        total += row[0]
    return total
""")
    custom_program = api['source_module'](custom_source)
    assert not SupportChecker(custom_program).check('custom')
    (directory / 'custom_range.json').write_text(api['AstJsonEmitter'](custom_program).emit())
    index = len(expected)
    expected.append(f'case{index}:ok:' + str(runpy.run_path(str(custom_source))['custom']()))
    lines.append('def customRange : Module := pyast_from_json% (include_str "custom_range.json")')
    lines.append(f'''
#eval IO.println ("case{index}:" ++
  match (HeapCalls.scalarFunction customRange "custom" []).observe 20000 with
  | .done (.ok (.int value)) => "ok:" ++ toString value
  | _ => "unexpected result")''')
    proof = directory / 'Checks.lean'
    proof.write_text('\n'.join(lines) + '\n')
    result = subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)],
                            cwd=REPO, capture_output=True, text=True)
    assert result.returncode == 0, result.stdout + result.stderr
    observed = [line for line in result.stdout.splitlines() if line.startswith('case')]
    assert observed == expected, (observed, expected)

    for extra in ('\nescaped = choose\n', '\nchoose = trace\n', '\nit.combinations = trace\n'):
        altered = ast.parse(source_text + extra)
        altered.formalsw_source = source
        assert SupportChecker(altered).check('trace'), extra
    for imported in ('from itertools import combinations as choose, permutations as choose',
                     'from itertools import permutations as choose, combinations as choose'):
        altered = ast.parse(source_text.replace('from itertools import combinations as choose', imported))
        altered.formalsw_source = source
        assert SupportChecker(altered).check('trace'), 'duplicate constructor alias accepted'
    altered = ast.parse(source_text.replace('import itertools as it', 'import itertools as it, math as it'))
    altered.formalsw_source = source
    assert SupportChecker(altered).check('keyword'), 'duplicate module alias accepted'
    altered = ast.parse(source_text + '\nfrom itertools import permutations as perm\nescaped = perm\n')
    altered.formalsw_source = source
    assert not SupportChecker(altered).check('trace'), 'unrelated constructor alias blocked combinations'
    for body in ('rows = choose([1, 2], 1)\n    return 0',
                 'for row in choose([1, 2]):\n        pass\n    return 0'):
        altered = ast.parse('from itertools import combinations as choose\ndef f():\n    ' + body + '\n')
        altered.formalsw_source = source
        assert SupportChecker(altered).check('f'), body
    for body in (
            'def f(range):\n    for row in choose(range(3), 2):\n        pass\n    return 0',
            'range = lambda n: [n]\ndef f():\n    for row in choose(range(3), 2):\n        pass\n    return 0',
            'def f():\n    for row in choose(range(stop=3), 2):\n        pass\n    return 0'):
        altered = ast.parse('from itertools import combinations as choose\n' + body)
        altered.formalsw_source = source
        assert SupportChecker(altered).check('f'), body
    (directory / 'itertools.py').write_text('')
    altered = ast.parse(source_text)
    altered.formalsw_source = source
    assert SupportChecker(altered).check('trace'), 'shadowed itertools module accepted'

print(f'Combination loops and consumers: {len(expected)} Python execution comparisons and binding/escape checks passed')

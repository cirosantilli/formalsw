from lang.py.tuple_support import unpacked_tuple_displays

api = runpy.run_path(str(ROOT / 'formalsw'))


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    if type(value) is bytes:
        return '.bytes [' + ', '.join(map(str, value)) + ']'
    return '.string ' + json.dumps(value, ensure_ascii=False)


def data(value):
    if type(value) is list:
        return '.list [' + ', '.join(map(data, value)) + ']'
    return '.scalar (' + constant(value) + ')'


source = '''
from itertools import combinations, permutations

class Rows:
    def __init__(self, n: int):
        self.n = n
    def items(self):
        return [[[self.n, 2], 3], [[4, 5], 6]]
    def values(self):
        return self.items()
def touch(xs: list[int], n: int) -> int:
    xs.append(n)
    return n
def fields(xs: list[int], n: int):
    xs.append(n)
    return [[n, 2], 3]

def fail(xs: list[int], n: int) -> int:
    xs.append(n)
    return n // 0
def unsupported(xs: list[int], n: int) -> int:
    for a, b in set():
        xs.append(a)
    return 0
def scalar_annotation(n: int) -> int:
    value: 1 // 0 = n + 1
    value: missing_name
    return value
'''

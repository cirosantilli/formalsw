    'source_failure': 'for a, b in [[touch(xs, n), fail(xs, n + 1)]]:\n    out.append(a)',
    'inline_constants': 'for a, b in [(0, 1), (1, 0), (1, 1), (1, -1)]:\n    out.append(a * n + b)',
    'constant_table': 'table = [(0, 1), (1, 0), (1, 1), (1, -1)]\nfor a, b in table:\n    out.append(a * n + b)',
    'annotated_table': 'table: list[tuple[int, int]] = [(0, 1), (1, 0), (1, 1), (1, -1)]\nfor a, b in table:\n    out.append(a * n + b)',
    'table_repeat': 'table = [(1, 2), (1, 2)]\nfor a, b in table:\n    for c, d in table:\n        out.append(a + b + c + d)',
    'constant_wrong_arity': 'table = [(1, 2, 3)]\nfor a, b in table:\n    out.append(a)',
    'unobserved_table': 'table = [(1, 2), (1, 2)]\nout.append(n)',
    'annotation_effect': 'a: fail(xs, n) = touch(xs, n)\nout.append(a)',
    'annotation_only': 'a = n\na: fail(xs, n)\nout.append(a)',
    'annotation_unbound': 'a: fail(xs, n)\nout.append(a)',

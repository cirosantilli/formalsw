#!/usr/bin/env python3
"""Check proof generation from a project that depends on formalsw by path."""
from pathlib import Path
import subprocess
import tempfile

REPO = Path(__file__).resolve().parents[2]

with tempfile.TemporaryDirectory(prefix="formalsw-project-") as temporary:
    project = Path(temporary)
    subprocess.run(["git", "init", "-q", str(project)], check=True)
    (project / "lean-toolchain").write_text((REPO / "lean-toolchain").read_text())
    (project / "lakefile.toml").write_text(
        f'name = "external_proofs"\n[[require]]\nname = "formalsw"\npath = "{REPO}"\n'
    )
    for directory in ("left", "right"):
        (project / directory).mkdir()
        source = project / directory / "1.py"
        source.write_text(
            'def f(n: int) -> int:\n'
            '    """@formalsw: theorem returns (n : Int) : Returns(this_function(n))"""\n'
            '    return n\n'
        )
        module = f"{directory.capitalize()}.P1Ast"
        imports = f'import «.formalsw».{directory}.«1.py.ast»\nimport FormalSW\n'
        if directory == "right":
            imports += 'import left.«1.py»\n'
        source.with_suffix(".py.lean").write_text(
            imports + f'namespace {directory}.«1»\nopen FormalSW.PyAst\n'
            f'theorem f.returns (n : Int) : (scalarFunction {module}.module "f" [.int n]).Returns := '
            '⟨.int n, .done rfl⟩\n'
            f'end {directory}.«1»\n'
        )
        result = subprocess.run(
            [str(REPO / "formalsw"), str(source)], cwd=project,
            text=True, capture_output=True,
        )
        assert result.returncode == 0, result.stdout + result.stderr
        assert "All 1 checks passed" in result.stdout, result.stdout
print("External projects and colliding numeric filenames passed")

#!/usr/bin/env python3
"""
Check allocating acquisition, returned iterator aliases and preserved private consumers.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
class Source:
    def __iter__(self):
        self.link = [self]
        return self.iterator

    def __next__(self):
        return "123"
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation IteratorCalls
namespace AllocatingAcquisitionExamples
set_option Elab.async false

def classInfo := (Probe.module.findClass "Source").getD ("", [])
def args : List Arg := [{name := "self", annotation := none}]
def writeSelf : List Stmt := [.assign [.attribute (.name "self") "link"] (.list [.name "self"])]
def tail : List Stmt := [.return (.attribute (.name "self") "iterator")]
def iterBody : List Stmt := writeSelf ++ tail
def nextBody : List Stmt := [.return (.constant (.string "123"))]
def after (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value)) : Mutable.Heap :=
  (heap ++ [Mutable.Object.list [.ref address]]).set address
    (.instance classInfo.1 "Source" (Mutable.putField fields "link" (.ref heap.length)))

theorem source : IteratorCalls.Relocation.ModuleSource Probe.module := by
  simp [IteratorCalls.Relocation.ModuleSource, Probe.module, HeapCalls.Relocation.StmtWithin]
theorem source_class : Probe.module.findClass "Source" = some classInfo := rfl
theorem source_iter : findFunctionIn classInfo.2 "__iter__" = some (args, iterBody) := rfl
theorem source_next : findFunctionIn classInfo.2 "__next__" = some (args, nextBody) := rfl

theorem iter_bound (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Source" fields)) :
    ProtocolCalls.iterMethod Probe.module (.ref address) heap =
      some (.ok (.method (.ref address) args iterBody), heap) := by
  have lookup := ProtocolCalls.lookup_instance Probe.module heap address classInfo.1 "Source"
    "__iter__" fields classInfo.2 found source_class
  simp only [source_iter, Option.map_some] at lookup
  simp [ProtocolCalls.iterMethod, Mutable.eval_bind, lookup]

theorem next_bound (heap : Mutable.Heap) (address : Nat) (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Source" fields)) :
    ProtocolCalls.nextMethod Probe.module (.ref address) heap =
      some (.ok (some (.method (.ref address) args nextBody)), heap) := by
  have lookup := ProtocolCalls.lookup_instance Probe.module heap address classInfo.1 "Source"
    "__next__" fields classInfo.2 found source_class
  simp only [source_next, Option.map_some] at lookup
  simpa [ProtocolCalls.nextMethod, found] using lookup

theorem iter_trace (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (address cursor : Nat)
    (fields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Source" fields))
    (field : fields.lookup "iterator" = some (.ref cursor)) :
    AllocatingTrace Probe.module heap.length choices [] heap
      (.running ⟨⟨.operation (.method (.ref address) args iterBody) [], [], heap⟩, used⟩ [])
      (after heap address fields)
      (.completed (.ok ⟨.ok (.ref cursor), [], after heap address fields, heap.length⟩) used []) := by
  let env := functionEnv args iterBody [.ref address] []
  let frame := Frame.assignAttribute (.name "self") "link" tail env
  have self : env "self" = some (.ref address) := rfl
  have entered : HeapCalls.Reaches Probe.module heap.length
      ⟨.operation (.method (.ref address) args iterBody) [], [], heap⟩
      ⟨.operation .list [.ref address], [frame], heap⟩ := by
    exact .next rfl (.next rfl (.next rfl (.next rfl (.next rfl .refl))))
  have retained : (heap ++ [.list [.ref address]])[address]? = some (.instance classInfo.1 "Source" fields) := by
    rw [List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1]
    exact found
  have write := Mutable.writeField_result (name := "link") (value := Mutable.Value.ref heap.length) retained (by simp)
  have assigned : HeapCalls.Reaches Probe.module heap.length
      ⟨.value (.ref heap.length), [frame], heap ++ [.list [.ref address]]⟩
      ⟨.block tail env, [], after heap address fields⟩ := by
    apply HeapCalls.Reaches.next rfl
    apply (Evaluates.arguments_reach (.cons (Evaluates.lookup self) .nil)
      (.setField "link" (.ref heap.length)) [] heap.length _).trans
    exact .next (following := ⟨.value (.scalar .none), [.discard tail env], after heap address fields⟩)
      (by simp [HeapCalls.step, result, run, primitive, write, after]) (.next rfl .refl)
  have read : Evaluates Probe.module env (.attribute (.name "self") "iterator")
      (after heap address fields) (.ref cursor) (after heap address fields) := by
    apply Evaluates.field (Evaluates.lookup self)
    have bounded := (List.getElem?_eq_some_iff.mp found).1
    simp [getAttribute, Mutable.eval_bind, after, show address < heap.length + 1 by omega,
      instanceClass, source_class, Mutable.putField_lookup_other, field]
  have returned : BlockReturns Probe.module env tail (after heap address fields) (.ref cursor) (after heap address fields) :=
    BlockReturns.return_value read
  refine AllocatingTrace.trans (middle := heap)
    (next := .running ⟨⟨.operation .list [.ref address], [frame], heap⟩, used⟩ []) ?_ ?_
  · exact .stable rfl rfl rfl (IteratorCalls.Reaches.of_heap entered [])
  · refine AllocatingTrace.trans (AllocatingTrace.list heap [.ref address] [frame] used []) ?_
    exact .stable rfl rfl (by simp [after])
      ((IteratorCalls.Reaches.of_heap (assigned.trans (returned heap.length [])) []).trans (.next (core_done rfl rfl) .refl))

/-- The return target remains valid whether acquisition returns self or another instance. -/
theorem cursor_retained (heap : Mutable.Heap) (address cursor : Nat)
    (fields cursorFields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Source" fields))
    (cursorFound : heap[cursor]? = some (.instance classInfo.1 "Source" cursorFields)) :
    ∃ currentFields, (after heap address fields)[cursor]? = some (.instance classInfo.1 "Source" currentFields) := by
  by_cases same : address = cursor
  · subst cursor
    refine ⟨Mutable.putField fields "link" (.ref heap.length), ?_⟩
    have bounded := (List.getElem?_eq_some_iff.mp found).1
    simp [after, show address < heap.length + 1 by omega]
  · refine ⟨cursorFields, ?_⟩
    simpa only [after, List.getElem?_set_ne same,
      List.getElem?_append_left (List.getElem?_eq_some_iff.mp cursorFound).1] using cursorFound

theorem acquisition (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (address cursor : Nat)
    (fields cursorFields : List (String × Mutable.Value))
    (found : heap[address]? = some (.instance classInfo.1 "Source" fields))
    (field : fields.lookup "iterator" = some (.ref cursor))
    (cursorFound : heap[cursor]? = some (.instance classInfo.1 "Source" cursorFields)) :
    AllocatingAcquireRun Probe.module choices (.ref address) heap used (.ref cursor) (after heap address fields) used := by
  refine ⟨.method (.ref address) args iterBody, .method (.ref cursor) args nextBody,
    (List.getElem?_eq_some_iff.mp found).1, by simp [isInstance, found], iter_bound heap address fields found,
    iter_trace choices used heap address cursor fields found field, ?_⟩
  obtain ⟨currentFields, retained⟩ := cursor_retained heap address cursor fields cursorFields found cursorFound
  exact next_bound (after heap address fields) cursor currentFields retained

theorem isolated_acquisition (choices : ChoiceSchedule) (used anchors : Nat)
    (logical physical : Mutable.Heap) (rename : Nat → Nat) (address cursor : Nat)
    (fields cursorFields : List (String × Mutable.Value)) (privateAddress : Nat) (object : Mutable.Object)
    (nonempty : object ≠ .tuple []) (layout : PrivateLayout logical physical rename privateAddress object)
    (found : logical[address]? = some (.instance classInfo.1 "Source" fields))
    (field : fields.lookup "iterator" = some (.ref cursor))
    (cursorFound : logical[cursor]? = some (.instance classInfo.1 "Source" cursorFields))
    (loop : Loop) (resumes : List Resume) (inputName : String)
    (getInput : loop.env inputName = some (.ref (rename address))) :
    ∃ other nextMap, PrivateLayout (after logical address fields) other nextMap privateAddress object ∧
      Relocation.ExtendedLayout logical.length physical.length rename (after logical address fields) other nextMap ∧
      IteratorCalls.Reaches Probe.module anchors choices []
        (.running ⟨⟨.block (.forIn (.name loop.name) (.name inputName) loop.body loop.otherwise :: loop.following)
          loop.env, loop.stack, physical⟩, used⟩ resumes)
        (.running ⟨⟨.block (loopCode loop (.ref (nextMap cursor)) :: loop.following)
          loop.env, loop.stack, other⟩, used⟩ resumes) := by
  have ran := acquisition choices used logical address cursor fields cursorFields found field cursorFound
  obtain ⟨other, nextMap, extended, kept, entered⟩ := ran.for_name_isolated source physical rename layout.layout anchors
  exact ⟨other, nextMap, kept privateAddress object nonempty layout, extended, entered loop resumes inputName getInput⟩

end AllocatingAcquisitionExamples
'''
AUDITS = ["FormalSW.PyAst.IteratorCalls." + name for name in (
    "AllocatingAcquireRun.acquireRun", "AcquireRun.allocating_of_noGrowth", "AllocatingAcquireRun.for_name_isolated",
)] + ["AllocatingAcquisitionExamples." + name for name in (
    "source", "source_class", "source_iter", "source_next", "iter_bound", "next_bound", "iter_trace",
    "cursor_retained", "acquisition", "isolated_acquisition",
)]
with project_temporary_directory(prefix="allocating-acquisition-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for same in (True, False):
        receiver = namespace["Source"]()
        cursor = receiver if same else namespace["Source"]()
        receiver.iterator = cursor
        assert iter(receiver) is cursor and receiver.link[0] is receiver
        assert next(cursor) == "123"
        old_link = receiver.link
        assert iter(receiver) is cursor and receiver.link is not old_link
        assert old_link[0] is receiver and receiver.link[0] is receiver
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    proof = directory / "Checks.lean"
    proof.write_text("import lang.py.FormalSW.IteratorAllocatingAcquisition\n"
                     "import lang.py.FormalSW.RuntimeExceptionObservation\n"
                     + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
                     + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n")
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(proof)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {"propext", "Classical.choice", "Quot.sound"}, checked.stdout
print(f"allocating iterator acquisition: self or distinct iterator, retained cycles and private storage; {len(AUDITS)} axiom audits passed")

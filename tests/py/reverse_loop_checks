#!/usr/bin/env python3
"""Compare reverse loops with Python, including mutations and loop transfers."""
import ast
import json
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))
from lang.py.support import SupportChecker
api = runpy.run_path(str(REPO / 'formalsw'))


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is str:
        return '.string ' + json.dumps(value, ensure_ascii=False)
    if type(value) is bytes:
        return '.bytes ' + str(list(value))
    return f'.int ({value})'


def values(items):
    return '[' + ', '.join(f'.scalar ({constant(item)})' for item in items) + ']'


source = '''
def scan(xs: list[int], n: int) -> int:
    result = n
    for x in reversed(xs):
        result = result * 10 + x
    else:
        result += 10000
    return result

def edit(xs: list[int], n: int) -> int:
    result = 0
    for x in reversed(xs):
        result = result * 10 + x
        if n == 0: xs.append(9)
        elif n == 1: xs[1:] = []
        elif n == 2: xs[:] = [4, 5, 6]
        elif n == 3: xs = [9]
        elif n == 4:
            if x == 2: break
        elif n == 5:
            if x == 2: continue
            result += 1
        elif n == 6: xs[:] = []
        elif n == 7: xs[0] = 5
        elif n == 8:
            for y in reversed([1, 2]):
                if y == 1: continue
                result += y
        elif n == 9:
            for y in reversed([]): result += y
            else: break
        elif n == 10:
            result //= 0
    else:
        result += 10000
    return result

def touch(xs: list[int]) -> list[int]:
    xs.append(7)
    return xs

def once(xs: list[int], n: int) -> int:
    result = 0
    for x in reversed(touch(xs)): result = result * 10 + x
    return result

def invalid(xs: list[int], n: int) -> int:
    for x in reversed(touch(xs)[0]): return x
    return 0

def first(xs: list[int], n: int) -> int:
    for x in reversed(xs): return x
    return n

def unbound(xs: list[int], n: int) -> int:
    for x in reversed(xs): pass
    return x

def overwrite(xs: list[int], n: int) -> int:
    result = 0
    for xs in reversed(xs): result = result * 10 + xs
    return result

def text(s: str) -> str:
    result = ''
    for c in reversed(s): result += c
    return result

def tuple_literal(n: int) -> int:
    total = 0
    for x in reversed((1, 2, 3)): total = total * 10 + x
    return total + n
'''
program = ast.parse(source)
world = {}
exec(source, world)
for function in program.body:
    issues = SupportChecker(program).check(function.name)
    assert not issues, (function.name, issues)

lines = ['import FormalSW', 'open FormalSW.PyAst',
         'def program : Module := pyast_from_json% (include_str "source.json")']
count = 0
for initial in ([], [1], [1, 2], [1, 2, 3], [0, -1, 2], [1, 2, 3, 4, 5]):
    for name, modes in (('edit', range(11)), ('once', [0]), ('invalid', [0]),
                        ('first', [-1]), ('unbound', [0]), ('overwrite', [0]), ('scan', [0])):
        for mode in modes:
            items = initial.copy()
            try:
                outcome = '.ok (.scalar (' + constant(world[name](items, mode)) + '))'
            except (TypeError, UnboundLocalError, ZeroDivisionError) as error:
                outcome = f'.error {{ typeName := "{type(error).__name__}", args := [] }}'
            call = f'(HeapCalls.call program "{name}" [.ref 0, .scalar (.int ({mode}))] [.list {values(initial)}]).execution.observe 2000'
            observed = f'result.outcome = {outcome} ∧ result.heap[0]? = some (.list {values(items)}) ∧ result.anchors = 1'
            lines.append(f'example : (match {call} with | .done (.ok result) => decide ({observed}) | _ => false) = true := by native_decide')
            count += 1

# Immutable tuples and mutable bytearrays use the same decreasing cursor.
for initial in ([], [1], [1, 2, 3], [0, 255]):
    for kind, value in (('tuple', tuple(initial)), ('bytearray', bytearray(initial))):
        encoded = '.tuple ' + values(initial) if kind == 'tuple' else '.bytearray ' + str(initial)
        answer = world['scan'](value, 0)
        lines.append(f'example : (HeapCalls.call program "scan" [.ref 0, .scalar (.int 0)] [{encoded}]).execution.observe 2000 = '
                     f'.done (.ok ⟨.ok (.scalar (.int ({answer}))), [], [{encoded}], 1⟩) := by native_decide')
        count += 1
for value in ('', 'é🙂漢', b'', b'\x00\xff', 1, True, None):
    try:
        outcome = '.ok (' + constant(world['text'](value)) + ')'
    except TypeError:
        outcome = '.error { typeName := "TypeError", args := [] }'
    lines.append(f'example : (HeapCalls.scalarFunction program "text" [{constant(value)}]).observe 2000 = .done ({outcome}) := by native_decide')
    count += 1
lines.append('example : (HeapCalls.scalarFunction program "tuple_literal" [.int 7]).observe 2000 = .done (.ok (.int 328)) := by native_decide')
# A valid but unmodeled dictionary reverse iterator must not become an exception.
lines.append('example : Mutable.reversibleSequence (.ref 0) [.dict []] = none := by native_decide')
lines.append('example : Mutable.reversibleSequence (.ref 0) [.instance "origin" "Custom" []] = none := by native_decide')

base = 'def f(xs: list[int]) -> int:\n    for x in reversed(xs): pass\n    return 0\n'
for altered in (
    base.replace('reversed(xs)', 'reversed()'),
    base.replace('reversed(xs)', 'reversed(xs, xs)'),
    base.replace('reversed(xs)', 'reversed(sequence=xs)'),
    base.replace('reversed(xs)', 'reversed(*xs)'),
    base.replace('for x ', 'for x, y '),
    base.replace('xs: list[int]', 'xs: list[int], reversed: int'),
    base.replace('    return 0', '    reversed = 1\n    return 0'),
    base + 'from unknown import reversed\n',
    base.replace('for x in reversed(xs): pass', 'iterator = reversed(xs)'),
):
    assert SupportChecker(ast.parse(altered)).check('f'), altered

with project_temporary_directory(prefix='reverse-loop-check-') as temporary:
    directory = Path(temporary)
    (directory / 'source.json').write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('\n'.join(lines) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=REPO, check=True)
subprocess.run([str(REPO / 'formalsw'), 'tests/py/reverse_loops.py'], cwd=REPO, check=True)
print(f'Reverse loops: {count + 1} Python comparisons, validation and arbitrary-input proofs passed')

#!/usr/bin/env python3
"""
Check set construction after mutation, representative retention and saved consumers.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def touch(source, item):
    source.add(item)
    return source


def nested(source, item):
    return set(touch(source, item))


def explicit(source, item):
    source.add(item)
    return set(source)
'''
PROOF = r'''

open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
namespace MachineSetConstructionExamples
set_option Elab.async false

def inserted (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant) : Mutable.Heap :=
  heap.set address (.set (ScalarSet.insert items item))

def copied (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant) : Mutable.Heap :=
  inserted heap address items item ++ [.set ((ScalarSet.insert items item).foldl ScalarSet.insert [])]

theorem set_from_set (heap : Mutable.Heap) (address : Nat) (items : List Constant)
    (found : heap[address]? = some (.set items)) :
    primitive (.builtin .set) [.ref address] heap =
      some (.ok (.ref heap.length), heap ++ [.set (items.foldl ScalarSet.insert [])]) := by
  simp [primitive, Mutable.setFrom, found, Mutable.allocateSetValues_scalars]

theorem touch_returns (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant)
    (found : heap[address]? = some (.set items)) :
    ReturnsValue Probe.module "touch" [.ref address, .scalar item] heap (.ref address) (inserted heap address items item) := by
  unfold inserted
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.add (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  exact BlockReturns.return_value (Evaluates.lookup rfl)

theorem nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant)
    (found : heap[address]? = some (.set items)) :
    ReturnsValue Probe.module "nested" [.ref address, .scalar item] heap (.ref heap.length) (copied heap address items item) := by
  have inside := (List.getElem?_eq_some_iff.mp found).1
  have retained : (inserted heap address items item)[address]? = some (.set (ScalarSet.insert items item)) := by
    simp [inserted, inside]
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil))
    (touch_returns heap address items item found)) .nil)
  simpa [copied, inserted] using set_from_set (inserted heap address items item) address (ScalarSet.insert items item) retained

theorem explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant)
    (found : heap[address]? = some (.set items)) :
    ReturnsValue Probe.module "explicit" [.ref address, .scalar item] heap (.ref heap.length) (copied heap address items item) := by
  have inside := (List.getElem?_eq_some_iff.mp found).1
  have retained : (inserted heap address items item)[address]? = some (.set (ScalarSet.insert items item)) := by
    simp [inserted, inside]
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.add (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  simpa [copied, inserted] using set_from_set (inserted heap address items item) address (ScalarSet.insert items item) retained

theorem inline_equiv (heap : Mutable.Heap) (address : Nat) (items : List Constant) (item : Constant)
    (found : heap[address]? = some (.set items)) :
    (IteratorCalls.call Probe.module "nested" [.ref address, .scalar item] heap).Equiv
      (IteratorCalls.call Probe.module "explicit" [.ref address, .scalar item] heap) := by
  have finishes (name : String) (choices : ChoiceSchedule)
      (returned : ReturnsValue Probe.module name [.ref address, .scalar item] heap (.ref heap.length) (copied heap address items item)) :
      ((IteratorCalls.call Probe.module name [.ref address, .scalar item] heap).run choices).Finishes
        ⟨.ok (.ref heap.length), [], copied heap address items item, heap.length⟩ := by
    have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returned heap.length []) []
    exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))
  intro leftChoices rightChoices
  exact Mutable.Call.equiv_of_finishes
    (finishes "nested" leftChoices (nested_returns heap address items item found))
    (finishes "explicit" rightChoices (explicit_returns heap address items item found)) (Or.inl rfl)

/-- Set construction uses the proved output of an earlier mutation, under arbitrary saved consumers. -/
theorem append_then_set (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (operation : Operation) (covered : SetConstructionOperation operation) (values : List Mutable.Value) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨.operation operation values, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running
          ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running
            ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_setConstruction_preserves Probe.module choices _ other nextMap
    logical.length physical.length used operation values stack resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained covered
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end MachineSetConstructionExamples
'''
AUDITS = ["FormalSW.PyAst.Mutable.Relocation.HeapGrows." + name for name in (
    "hashKey", "mapM", "addItem", "setKey", "allocateSetValues",
)] + ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "result_addItem_preserves", "result_allocateSetValues_preserves", "result_setFrom_preserves", "step_setConstruction_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation.step_setConstruction_preserves"] + ["MachineSetConstructionExamples." + name for name in (
    "set_from_set", "touch_returns", "nested_returns", "explicit_returns", "inline_equiv", "append_then_set",
)]
with project_temporary_directory(prefix="machine-set-construction-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for name in ("nested", "explicit"):
        for size in (0, 1, 17):
            for item in (0, True, -10**100, "key", (1, (2, 3))):
                source = set(range(size))
                expected = source | {item}
                result = namespace[name](source, item)
                assert source == result == expected and result is not source
        source = {True}
        result = namespace[name](source, 1)
        assert next(iter(source)) is True and next(iter(result)) is True
        representative = tuple([123, 456])
        equal = tuple([123, 456])
        assert representative is not equal
        source = {representative}
        result = namespace[name](source, equal)
        assert next(iter(source)) is representative and next(iter(result)) is representative
        source = {1}
        try:
            namespace[name](source, [])
        except TypeError:
            assert source == {1}
        else:
            raise AssertionError("unhashable insertion must raise")
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.MachineSetConstruction\n"
        "import lang.py.FormalSW.IteratorRules\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"set construction: prior mutations, retained representatives and suspended callers; {len(AUDITS)} axiom audits passed")

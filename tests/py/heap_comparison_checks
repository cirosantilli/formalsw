#!/usr/bin/env python3
"""
Compare chained comparisons with Python, including mutations and skipped errors.
"""
import ast
import itertools
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))
source = '''
def touch(xs: list[int], n: int) -> int:
    xs.append(n)
    return n
def alias(xs: list[int], n: int) -> list[int]:
    xs.append(n)
    return xs
def fail(xs: list[int], n: int) -> int:
    xs.append(n)
    return n // 0
def pair(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) < touch(xs, b)
def chain(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) < touch(xs, b) < touch(xs, c)
def longer(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) <= touch(xs, b) != touch(xs, c) < touch(xs, 3)
def skipped_failure(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) < touch(xs, b) < fail(xs, c)
def middle_failure(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) < fail(xs, b) < touch(xs, c)
def incompatible(xs: list[int], a: int, b: int, c: int) -> bool:
    return touch(xs, a) < None < touch(xs, c)
def shared_middle(xs: list[int], a: int, b: int, c: int) -> bool:
    return alias(xs, a) == alias(xs, b) == alias(xs, c)
'''
program = ast.parse(source)
world = {}
exec(source, world)
for function in program.body:
    issues = SupportChecker(program).check(function.name, heap_calls=True)
    assert not issues, (function.name, issues)

equations = []
for name in ('pair', 'chain', 'longer', 'skipped_failure', 'middle_failure', 'incompatible', 'shared_middle'):
    for a, b, c in itertools.product((-1, 0, 2), repeat=3):
        events = []
        try:
            result = world[name](events, a, b, c)
            outcome = f'.ok (.scalar (.bool {str(result).lower()}))'
        except (ZeroDivisionError, TypeError) as error:
            outcome = f'.error {{typeName := "{type(error).__name__}", args := []}}'
        heap = '[.list [' + ', '.join(f'.scalar (.int ({value}))' for value in events) + ']]'
        call = f'HeapCalls.call Probe.module "{name}" [.ref 0, .scalar (.int ({a})), .scalar (.int ({b})), .scalar (.int ({c}))] [.list []]'
        equations.append(f'example : ({call}).execution.observe 1000 = .done (.ok '
                         f'{{outcome := {outcome}, globals := [], heap := {heap}, anchors := 1}}) := by decide')

with project_temporary_directory(prefix='heap-comparisons-') as temporary:
    directory = Path(temporary)
    document = directory / 'source.json'
    document.write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('import lang.py.FormalSW.HeapCalls\n' + api['AstLeanBridgeEmitter'](document, 'Probe', program).emit()
                     + 'open FormalSW.PyAst\nset_option maxRecDepth 8192\n'
                     + '\n'.join(equations) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

print(f'{len(equations)} chained-comparison checks passed, including effects, aliases, and exceptions')

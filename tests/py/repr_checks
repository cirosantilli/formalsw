#!/usr/bin/env python3
"""
Compare scalar repr, intrinsic f-string fields and exact validation errors with Python.
"""
import ast
import itertools
import json
from pathlib import Path
import runpy
import subprocess
import sys
import unicodedata

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))


def string(value):
    return json.dumps(value, ensure_ascii=False)


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    if type(value) is bytes:
        return '.bytes [' + ', '.join(map(str, value)) + ']'
    return '.string (String.ofList [' + ', '.join(f'Char.ofNat {ord(ch)}' for ch in value) + '])'


source = '''
def representation(text: str):
    return repr(text)
def formatted(text: str):
    repr = 5
    str = 6
    return f"Invalid attempt: {text!r:}"
def debugged(text: str):
    return f"{text=}"
def mixed(text: str):
    return f"{text!r};{text!s};{text}"
def rejected(text: str):
    raise ValueError(f"Invalid attempt: {text!r}")
def touch(log: list[int], value: int, text: str):
    log.append(value)
    return text
def fail(log: list[int]):
    log.append(9)
    raise ValueError("failure")
def ordered(log: list[int]):
    return f"{touch(log, 1, '²')!r}/{touch(log, 2, 'λ')!r}"
def argument_failure(log: list[int]):
    return repr(fail(log))
def field_failure(log: list[int]):
    return f"{touch(log, 1, 'λ')!r}{fail(log)!r}{touch(log, 2, 'x')!r}"
def wrong_arity(log: list[int]):
    return repr(log, touch(log, 1, 'x'))
def no_arguments(n: int):
    return repr()
def extra_arguments(n: int):
    return repr(n, n)
def heap_representation(log: list[int]):
    return repr(log)
def heap_field(log: list[int]):
    return f"{log!r}"
'''
program = ast.parse(source)
checker = SupportChecker(program)
for node in program.body:
    assert not checker.check(node.name), (node.name, checker.check(node.name))
world = {}
exec(source, world)
checks = []
count = 0


def compare(name, value):
    global count
    heap_mode = type(value) is list
    argument = '.ref 0' if heap_mode else '.scalar (' + constant(value) + ')'
    heap = '[.list []]' if heap_mode else '[]'
    try:
        result = world[name](value)
        outcome = '.ok (.scalar (' + constant(result) + '))'
    except (TypeError, ValueError) as error:
        args = error.args if type(error) is ValueError else ()
        outcome = '.error ⟨' + string(type(error).__name__) + ', [' + ', '.join(map(constant, args)) + ']⟩'
    if heap_mode:
        expected_heap = '[.list [' + ', '.join('.scalar (' + constant(x) + ')' for x in value) + ']]'
    else:
        expected_heap = '[]'
    checks.append(f'example : (match (HeapCalls.call source "{name}" [{argument}] {heap}).execution.observe 500 with\n'
                  f'  | .done (.ok c) => c.outcome == {outcome} && c.heap == {expected_heap}\n'
                  '  | _ => false) = true := by native_decide')
    count += 1


texts = ['', 'abc', "'", '"', "'\"", '\\', '\t\n\r\x00\x7f', '\xa0\xad', '\u2028\u2029',
         '²٢', 'λ😀', '\U0001ccf0', '\u0378', '\uffff', '\U0010ffff',
         ''.join(chr(point) for point in range(128))]
for name, text in itertools.product(('representation', 'formatted', 'debugged', 'mixed', 'rejected'), texts):
    compare(name, text)
for value in (None, False, True, 0, -1, 10**100, -(10**100), b'', b"'\"\\\x00\xff", bytes(range(256))):
    for name in ('representation', 'formatted', 'mixed'):
        compare(name, value)
for name in ('ordered', 'argument_failure', 'field_failure', 'wrong_arity'):
    compare(name, [])
for name in ('no_arguments', 'extra_arguments'):
    compare(name, 7)
for width in range(1, 5):
    for characters in itertools.product(("'", '"', chr(92)), repeat=width):
        text = ''.join(characters)
        points = '[' + ', '.join(str(ord(character)) for character in text) + ']'
        checks.append(f'example : Strings.reprCodePoints {points} = {string(repr(text))} := by native_decide')
        count += 1
for name in ('heap_representation', 'heap_field'):
    checks.append(f'example : (HeapCalls.call source "{name}" [.ref 0] [.list []]).execution.observe 100 = .unsupported := by native_decide')

for text in (
    'def f(text: str): return repr(object=text)',
    'def f(text: str, repr: int): return repr(text)',
    'repr = 3\ndef f(text: str): return repr(text)',
    'def f(text: str): return f"{text!a}"',
    'def f(text: str): return f"{text!r:>3}"',
):
    assert SupportChecker(ast.parse(text)).check('f'), text
ordinary = ast.parse('def repr(text: str): return 7\ndef f(text: str): return repr(text)')
assert not SupportChecker(ordinary).check('f')
assert api['AstJsonEmitter'](ordinary).expr(ordinary.body[1].body[0].value)['type'] == 'Call'
shadowed = ast.parse('repr = 3\ndef f(text: str): return f"{text!r}"')
assert not SupportChecker(shadowed).check('f')
encoded = api['AstJsonEmitter'](shadowed).expr(shadowed.body[1].body[0].value)
assert encoded['right']['name'] == 'repr'

prelude = ['import FormalSW', 'open FormalSW.PyAst', 'set_option maxRecDepth 8192',
           'def source : Module := pyast_from_json% (include_str "source.json")']
with project_temporary_directory(prefix='repr-check-') as directory:
    directory = Path(directory)
    (directory / 'source.json').write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    for start in range(0, len(checks), 25):
        proof.write_text('\n'.join(prelude + checks[start:start + 25]) + '\n')
        subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)
    print(f'{count} scalar repr, f-string and exception comparisons passed', flush=True)

    # Fixed-width escaping is also checked for isolated Python surrogate code points.
    # These inputs use the code-point API because Lean Char excludes surrogates.
    assert unicodedata.unidata_version == '16.0.0', unicodedata.unidata_version
    for plane in range(17):
        first = plane * 0x10000
        expected = '\n'.join(repr(chr(point)) for point in range(first, first + 0x10000))
        proof.write_text('\n'.join([
            'import FormalSW',
            'open FormalSW.PyAst',
            'example : String.intercalate "\\n" ((List.range 0x10000).map fun offset =>',
            f'  Strings.reprCodePoints [{first} + offset]) = {string(expected)} := by native_decide',
        ]) + '\n')
        subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)
        print(f'Checked Unicode representation plane {plane}', flush=True)

print('All 1,114,112 single-code-point representations agree with Python')

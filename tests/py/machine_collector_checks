#!/usr/bin/env python3
"""
Check collector allocation, retained aliases, invalid inputs and saved consumers.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def collected(items, value):
    result = [items for _ in range(1)]
    items.append(value)
    return result


def explicit(items, value):
    result = [items]
    items.append(value)
    return result


def invalid(source):
    return [entry for entry in source]


def invalid_values(source):
    return [entry for entry in source.values()]


def set_copy(source):
    return {entry for entry in source}


def dictionary_copy(source):
    return {entry: entry for entry in source}


def values_copy(source):
    return [entry for entry in source.values()]
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
namespace MachineCollectorExamples
set_option Elab.async false

theorem singleton_comprehension (heap : Mutable.Heap) (env : HeapCalls.Env) (value : Mutable.Value)
    (read : env "items" = some value) :
    Evaluates Probe.module env (.listComp (.name "items") [("_", .call (.name "range") [.constant (.int 1)], [])])
      heap (.ref heap.length) (heap ++ [.list [value]]) := by
  apply Evaluates.list_comp_range (finalEnv := setLocal
    (comprehensionEnv env [("_", .call (.name "range") [.constant (.int 1)], [])]) "_" (.scalar (.int 0)))
    (.cons Evaluates.constant .nil) rfl
  apply BlockContinues.range_step rfl
  apply BlockContinues.append (body := [.comprehensionAppend heap.length (.name "items")])
  · exact BlockContinues.comprehension_append (items := [])
      (Evaluates.lookup (by simpa [setLocal, comprehensionEnv] using read)) (by simp)
  · apply BlockContinues.range_done rfl
    simpa using (BlockContinues.nil (module := Probe.module) (env := setLocal
      (comprehensionEnv env [("_", .call (.name "range") [.constant (.int 1)], [])]) "_" (.scalar (.int 0)))
      (heap := (heap ++ [Mutable.Object.list []]).set heap.length (Mutable.Object.list [value])))

def after (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) : Mutable.Heap :=
  (heap ++ [Mutable.Object.list [.ref address]]).set address (.list (items ++ [value]))

theorem collected_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "collected" [.ref address, value] heap (.ref heap.length) (after heap address items value) := by
  have present : (heap ++ [.list [.ref address]])[address]? = some (.list items) := by
    rw [List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1]
    exact found
  apply BlockReturns.function rfl rfl
  apply BlockReturns.assign (singleton_comprehension heap _ (.ref address) rfl)
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) present (Evaluates.lookup rfl) present)
  unfold after
  exact BlockReturns.return_value (Evaluates.lookup rfl)

theorem explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "explicit" [.ref address, value] heap (.ref heap.length) (after heap address items value) := by
  have present : (heap ++ [.list [.ref address]])[address]? = some (.list items) := by
    rw [List.getElem?_append_left (List.getElem?_eq_some_iff.mp found).1]
    exact found
  apply BlockReturns.function rfl rfl
  apply BlockReturns.assign (Evaluates.list (.cons (Evaluates.lookup rfl) .nil))
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) present (Evaluates.lookup rfl) present)
  unfold after
  exact BlockReturns.return_value (Evaluates.lookup rfl)

theorem alias_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    (IteratorCalls.call Probe.module "collected" [.ref address, value] heap).Equiv
      (IteratorCalls.call Probe.module "explicit" [.ref address, value] heap) := by
  have finishes (name : String) (choices : ChoiceSchedule)
      (returned : ReturnsValue Probe.module name [.ref address, value] heap (.ref heap.length) (after heap address items value)) :
      ((IteratorCalls.call Probe.module name [.ref address, value] heap).run choices).Finishes
        ⟨.ok (.ref heap.length), [], after heap address items value, heap.length⟩ := by
    have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returned heap.length []) []
    exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))
  intro leftChoices rightChoices
  exact Mutable.Call.equiv_of_finishes
    (finishes "collected" leftChoices (collected_returns heap address items value found))
    (finishes "explicit" rightChoices (explicit_returns heap address items value found)) (Or.inl rfl)

theorem rejects_before_allocation (heap : Mutable.Heap) (number : Int) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "invalid") [.scalar (.int number)], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], heap, heap.length⟩) := by
  repeat first
    | exact .done rfl
    | refine .next rfl ?_

theorem missing_values_before_allocation (heap : Mutable.Heap) (number : Int) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "invalid_values") [.scalar (.int number)], [], heap⟩
      (.ok ⟨.error ⟨"AttributeError", []⟩, [], heap, heap.length⟩) := by
  repeat first
    | exact .done rfl
    | refine .next rfl ?_

/-- Sequence acquisition uses the proved output of an earlier mutation, under arbitrary saved consumers. -/
theorem append_then_collector (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (operation : Operation) (covered : CollectorOperation operation) (values : List Mutable.Value) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨.operation operation values, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running
          ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running
            ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_collectorOperation_preserves Probe.module choices _ other nextMap
    logical.length physical.length used operation values stack resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained covered
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end MachineCollectorExamples
'''

AUDITS = ["FormalSW.PyAst.Mutable.Relocation.ExecutionLayout.congr"] + ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "generatorAcquire_preserves_at", "Preserves.congr_initial", "collectorObject_relocates",
    "collectorTerminal_relocates", "collectorTerminal_within", "collectorEnter_preserves",
    "collectorAcquireBody_preserves", "collectorAcquire_preserves", "dictionaryValuesAllocated_preserves",
    "collectorBody_within", "collectorBody_relocates", "dictionaryValuesCollectionStart_preserves",
    "comprehensionTargetsStart_acquire", "comprehensionTargetsStart_preserves", "comprehensionStart_acquire",
    "comprehensionStart_preserves", "step_collectorOperation_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation.step_collectorOperation_preserves"] + ["MachineCollectorExamples." + name for name in (
    "singleton_comprehension", "collected_returns", "explicit_returns", "alias_equiv",
    "rejects_before_allocation", "missing_values_before_allocation", "append_then_collector",
)]
with project_temporary_directory(prefix="machine-collector-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for size in (0, 1, 17):
        for name in ("collected", "explicit"):
            items = [object() for _ in range(size)]
            result = namespace[name](items, items)
            assert len(result) == 1 and result[0] is items
            assert len(items) == size + 1 and items[-1] is items
    for number in (-10**100, -1, 0, 1, 10**100):
        for name, error in (("invalid", TypeError), ("invalid_values", AttributeError),
                            ("set_copy", TypeError), ("dictionary_copy", TypeError)):
            try:
                namespace[name](number)
            except error:
                pass
            else:
                raise AssertionError((name, number))
    shared = []
    mapping = {0: shared, 1: shared}
    result = namespace["values_copy"](mapping)
    assert len(result) == 2 and result[0] is result[1] is shared
    class Values:
        def values(self):
            shared.append(self)
            return [shared, shared]
    instance = Values()
    result = namespace["values_copy"](instance)
    assert result[0] is result[1] is shared and shared[-1] is instance
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.MachineCollectorInvariant\n"
        "import lang.py.FormalSW.IteratorRules\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"collector acquisition: fresh addresses, shared mutations and rejection before allocation; {len(AUDITS)} axiom audits passed")

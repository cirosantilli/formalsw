#!/usr/bin/env python3
"""
Compare list construction with Python, including aliases and argument effects.
"""
import ast
import itertools
import json
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.call_support import uses_heap_calls
from lang.py.object_snapshot import snapshot_roots
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    if type(value) is bytes:
        return '.bytes [' + ', '.join(map(str, value)) + ']'
    return '.string ' + json.dumps(value, ensure_ascii=False)


def data(value):
    if type(value) is list:
        return '.list [' + ', '.join(map(data, value)) + ']'
    return '.scalar (' + constant(value) + ')'


source = '''
def copy(xs: list[int]):
    return list(xs)
def independent(xs: list[int]):
    result = list(xs)
    result.append(9)
    xs.append(4)
    return result
def touch(xs: list[int]):
    xs.append(3)
    return xs
def effect(xs: list[int]):
    return list(touch(xs))
def nested(xs: list[int]):
    original = [xs, xs]
    result = list(original)
    result[0].append(7)
    result.append(8)
    return [original, result]
def tuple_copy(xs: list[int]):
    result = list((xs, xs))
    result[0].append(7)
    return result
def cycle(xs: list[int]):
    xs.append(xs)
    return list(xs)
def fresh():
    return list() is list()
def empty():
    return list()
def empty_tuple():
    return list(())
def text():
    return list("λz😀λa")
def bytes_value():
    return list(b"cabac")
def buffer():
    return list(bytearray([9, 1, 7, 1]))
def invalid(xs: list[int]):
    return list(len(touch(xs)))
def fail(xs: list[int]):
    xs.append(3)
    raise ValueError()
def argument_error(xs: list[int]):
    return list(fail(xs))
def set_value():
    return list(set())
def dict_value():
    return list({})
'''
program = ast.parse(source)
checker = SupportChecker(program)
for function in program.body:
    assert not checker.check(function.name, heap_calls=True), function.name
assert uses_heap_calls(program, next(f for f in program.body if f.name == 'fresh'))
world = {}
exec(source, world)
lines = ['import FormalSW', 'open FormalSW.PyAst', 'set_option maxRecDepth 8192',
         'def source : Module := pyast_from_json% (include_str "source.json")']
count = 0


def compare(name, arguments, heap, actual, anchors):
    global count
    try:
        result = world[name](*actual)
        error = None
    except (TypeError, ValueError) as exception:
        result, error = None, type(exception).__name__
    expected = data(snapshot_roots(anchors + ([result] if error is None else [])))
    call = f'HeapCalls.call source "{name}" [{arguments}] {heap}'
    outcome = ('match c.outcome with | .ok _ => true | _ => false' if error is None else
               f'match c.outcome with | .error e => decide (e = ⟨"{error}", []⟩) | _ => false')
    lines.extend([
        f'-- {name}, case {count}',
        f'example : (match ({call}).execution.observe 1000 with',
        f'  | .done (.ok c) => ({outcome}) &&',
        f'      (Graph.observedBool ((Graph.compare c.snapshot ({expected})).observe 5000) == some true)',
        '  | _ => false) = true := by native_decide',
    ])
    count += 1


cases = [[], [None, True, 1, "λ", b"a"]]
cases += [list(values) for values in itertools.product((-2, 0, 1), repeat=2)]
for name, initial in itertools.product(
        ('copy', 'independent', 'effect', 'nested', 'tuple_copy', 'cycle', 'invalid', 'argument_error'), cases):
    value = initial.copy()
    heap = '[.list [' + ', '.join('.scalar (' + constant(x) + ')' for x in initial) + ']]'
    compare(name, '.ref 0', heap, [value], [value])
for name in ('fresh', 'empty', 'empty_tuple', 'text', 'bytes_value', 'buffer'):
    compare(name, '', '[]', [], [])

for name in ('set_value', 'dict_value'):
    lines.append(f'example : (HeapCalls.call source "{name}" [] []).execution.observe 100 = .unsupported := by decide')
for expression in ('list(xs, xs)', 'list(iterable=xs)'):
    module = ast.parse(f'def f(xs: list[int]):\n    return {expression}\n')
    assert SupportChecker(module).check('f'), expression
for binding in ('list = 1\n', 'from somewhere import list\n'):
    module = ast.parse(binding + 'def f(xs: list[int]):\n    return list(xs)\n')
    assert SupportChecker(module).check('f'), binding
module = ast.parse('def f(list: int):\n    return list()\n')
assert SupportChecker(module).check('f')

with project_temporary_directory(prefix='list-checks-') as directory:
    directory = Path(directory)
    (directory / 'source.json').write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('\n'.join(lines) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

print(f'{count} list construction Python comparisons passed, including aliases, cycles, and exceptions')

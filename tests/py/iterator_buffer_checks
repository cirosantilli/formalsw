theorem invalid_element (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (source : Nat)
    (invalid : Int) (outside : invalid < 0 ∨ 256 ≤ invalid)
    (found : heap[source]? = some (.list [.scalar (.int 1), .scalar (.int invalid)])) :
    AllocatingTrace Probe.module heap.length choices [] heap
      (.running ⟨⟨.operation (.call "build") [.ref source], [], heap⟩, used⟩ []) heap
      (.completed (.ok ⟨.error ⟨"ValueError", []⟩, [], heap, heap.length⟩) used []) := by
  apply build_failure
  simp [Mutable.bytearray, Mutable.byteValues, found, List.mapM_cons, Mutable.byte, Mutable.integer,
    Mutable.eval_bind, show ¬ (0 ≤ invalid ∧ invalid < 256) by omega, Mutable.error]

theorem zero_step (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (source : Nat)
    (items : List UInt8) (lower upper : Mutable.Value) (found : heap[source]? = some (.bytearray items)) :
    AllocatingTrace Probe.module heap.length choices [] heap
      (.running ⟨⟨.operation (.call "cut") [.ref source, lower, upper, .scalar (.int 0)], [], heap⟩, used⟩ []) heap
      (.completed (.ok ⟨.error ⟨"ValueError", []⟩, [], heap, heap.length⟩) used []) := by
  have ran : primitive .slice [.ref source, lower, upper, .scalar (.int 0)] heap = some (.error ⟨"ValueError", []⟩, heap) := by
    change Mutable.getSlice (.ref source) lower upper (.scalar (.int 0)) heap = _
    rw [HeapCalls.Relocation.getSlice_ref heap source _ lower upper (.scalar (.int 0)) found]
    simp [sliceBounds_result, sliceCoordinates, sliceCoordinate, Mutable.eval_bind]
  refine .stable rfl rfl rfl ?_
  apply (IteratorCalls.Reaches.of_heap (cut_entry heap (.ref source) lower upper (.scalar (.int 0))) []).trans
  exact .next (core_done rfl (by simp [SetCalls.step, SetCalls.liftStep, HeapCalls.step, HeapCalls.result, run, ran, protectGenerator, done, Calls.generatorException])) .refl

end BufferIteratorExamples
'''
AUDITS = ["FormalSW.PyAst.HeapCalls.Relocation.BufferAllocationInput." + name for name in (
    "relocates", "operation_relocates", "primitive",
)] + ["FormalSW.PyAst.IteratorCalls." + name for name in (
    "bufferAllocation_step", "AllocatingTrace.reaches", "AllocatingTrace.isolated",
)] + ["BufferIteratorExamples." + name for name in (
    "source", "source_class", "source_next", "next_bound", "field_read", "method_trace", "next_run",
    "buffer_slice_input", "buffer_slice_next", "slice_prefix", "isolated_next", "cut_entry", "cut_trace",
    "build_entry", "build_trace", "nonnegative_size", "flag_size", "buffer_copy", "empty_trace",
    "build_failure", "negative_size", "invalid_element", "zero_step",
)]

with project_temporary_directory(prefix="iterator-buffer-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for data in (bytearray(), bytearray(range(256))):
        collector = namespace["Collector"]()
        collector.data = data
        previous = []
        for _ in range(4):
            assert next(collector) == "123"
            assert collector.link == data and collector.link is not data
            assert all(collector.link is not item for item in previous)
            previous.append(collector.link)
        for lower in (None, -1000, -1, 0, True, 1000):
            for upper in (None, -1000, -1, 0, False, 1000):
                for stride in (None, -3, -1, 1, 2, True):
                    result = namespace["cut"](data, lower, upper, stride)
                    assert result == data[lower:upper:stride] and result is not data
                    assert type(result) is bytearray
        for lower, upper in ((None, None), (object(), object())):
            try:
                namespace["cut"](data, lower, upper, 0)
            except ValueError:
                pass
            else:
                raise AssertionError("expected zero step to fail before checking bounds")
    for data in (0, 1, 257, True, False, b"abc", bytearray(b"abc"), [0, True, 255], (1, 2)):
        result = namespace["build"](data)
        assert result == bytearray(data) and result is not data
    for data, error in ((-1, ValueError), ([1, -1], ValueError), ([1, 256], ValueError), ([1, None], TypeError), (None, TypeError)):
        try:
            namespace["build"](data)
        except error:
            pass
        else:
            raise AssertionError("expected invalid bytearray input to fail")
    data = bytearray(b"abc")
    copied = namespace["build"](data)
    copied[0] = 255
    assert data == b"abc"
    assert namespace["empty"]() == bytearray()
    assert namespace["empty"]() is not namespace["empty"]()
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    proof = directory / "Checks.lean"
    proof.write_text("import lang.py.FormalSW.IteratorAllocatingAcquisition\n"
                     + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
                     + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n")
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(proof)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {"propext", "Classical.choice", "Quot.sound"}, checked.stdout
print(f"buffer iterators: generalized construction, slices, repeated fresh copies, conversion failures and private consumers; {len(AUDITS)} axiom audits passed")

theorem build_failure (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (data : Mutable.Value)
    (error : ExceptionObject) (failed : Mutable.bytearray [data] heap = some (.error error, heap)) :
    AllocatingTrace Probe.module heap.length choices [] heap
      (.running ⟨⟨.operation (.call "build") [data], [], heap⟩, used⟩ []) heap
      (.completed (.ok ⟨.error error, [], heap, heap.length⟩) used []) := by
  refine .stable rfl rfl rfl ?_
  apply (IteratorCalls.Reaches.of_heap (build_entry heap data) []).trans
  exact .next (core_done rfl (by simp [SetCalls.step, SetCalls.liftStep, HeapCalls.step, primitive,
    HeapCalls.result, run, failed, protectGenerator, done, Calls.generatorException])) .refl

theorem negative_size (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap) (size : Int) (negative : size < 0) :
    AllocatingTrace Probe.module heap.length choices [] heap
      (.running ⟨⟨.operation (.call "build") [.scalar (.int size)], [], heap⟩, used⟩ []) heap
      (.completed (.ok ⟨.error ⟨"ValueError", []⟩, [], heap, heap.length⟩) used []) := by

    (Evaluates.arguments_reach (.cons (Evaluates.lookup rfl) .nil) (.builtin .bytearray) [] heap.length [])))

theorem build_trace (choices : ChoiceSchedule) (used : Nat) (heap : Mutable.Heap)
    (data : Mutable.Value) (bytes : List UInt8)
    (input : HeapCalls.Relocation.BufferAllocationInput heap (.builtin .bytearray) [data] bytes) :

  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  exact primitive_dict_copy _ source entries retained

theorem dict_equiv (heap : Mutable.Heap) (address source : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (entries : List (Constant × Mutable.Value))
    (found : heap[address]? = some (.list items)) (dataFound : heap[source]? = some (.dict entries)) :
    (IteratorCalls.call Probe.module "nested" [.ref address, value, .ref source] heap).Equiv
      (IteratorCalls.call Probe.module "explicit" [.ref address, value, .ref source] heap) :=
  calls_equiv _ _ _ _ _ _ (dict_nested_returns heap address source items value entries found dataFound)
    (dict_explicit_returns heap address source items value entries found dataFound)


import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def recorded(log, value, data):
    log.append(value)
    return data


def nested(log, value, data):
    return dict(recorded(log, value, data))


def explicit(log, value, data):
    log.append(value)
    return dict(data)


def build(data):
    return dict(data)
'''
PROOF = r'''

open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation

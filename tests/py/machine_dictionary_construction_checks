theorem failure_retains_mutation_and_allocation (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (found : heap[address]? = some (.list items)) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "nested") [.ref address, value, .scalar .none], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], inserted heap address items value ++ [.dict []], heap.length⟩) := by
  repeat first
    | apply (Evaluates.arguments_reach (.cons
        (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
          (recorded_returns heap address items value (.scalar .none) found)) .nil)
        (.builtin .dict) [] heap.length []).finishes
    | exact .done rfl
    | refine .next rfl ?_

theorem partial_insertion (heap : Mutable.Heap) (source row : Nat) (key : Constant) (value : Mutable.Value) (invalid : Int)
    (found : heap[source]? = some (.list [.ref row, .scalar (.int invalid)]))
    (rowFound : heap[row]? = some (.tuple [.scalar key, value])) :
    primitive (.builtin .dict) [.ref source] heap =
      some (.error ⟨"TypeError", []⟩, (heap ++ [Mutable.Object.dict []]).set heap.length (.dict [(key, value)])) := by
  have sourceInside := (List.getElem?_eq_some_iff.mp found).1
  have rowInside := (List.getElem?_eq_some_iff.mp rowFound).1
  have sourceAfter : (heap ++ [.dict []])[source]? = some (.list [.ref row, .scalar (.int invalid)]) := by
    rw [List.getElem?_append_left sourceInside]
    exact found
  have rowAfter : (heap ++ [.dict []])[row]? = some (.tuple [.scalar key, value]) := by
    rw [List.getElem?_append_left rowInside]
    exact rowFound
  rw [primitive_dict_constructor, dictionaryConstruct_ref heap source _ found]
  change DictionaryConstructor.fromIterable (.ref source) heap = _
  apply DictionaryConstructor.fromIterable_result _ _ _ [.ref row, .scalar (.int invalid)] (.error ⟨"TypeError", []⟩)
  · simp [DictionaryConstructor.iterable, sourceAfter, Mutable.sequence]
  · simp [DictionaryConstructor.insertRows, DictionaryConstructor.insertRow, DictionaryConstructor.iterable,
      rowAfter, Mutable.sequence, Mutable.setItem, ScalarDict.insert, Mutable.eval_bind, Mutable.error, Except.map]

theorem partial_failure_source (heap : Mutable.Heap) (source row : Nat) (key : Constant) (value : Mutable.Value) (invalid : Int)
    (found : heap[source]? = some (.list [.ref row, .scalar (.int invalid)]))
    (rowFound : heap[row]? = some (.tuple [.scalar key, value])) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "build") [.ref source], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], (heap ++ [Mutable.Object.dict []]).set heap.length (.dict [(key, value)]), heap.length⟩) := by
  repeat (refine .next rfl ?_)
  apply Finishes.done
  change protectGenerator [] (result heap.length heap (primitive (.builtin .dict) [.ref source]) []) = _
  simp [result, run, partial_insertion heap source row key value invalid found rowFound]
  rfl

/-- A failed constructor retains the partially filled new dictionary and every original cell. -/
theorem partial_failure_private_cell (heap : Mutable.Heap) (source row privateAddress : Nat)
    (key : Constant) (value : Mutable.Value) (invalid : Int) (privateObject : Mutable.Object)
    (found : heap[source]? = some (.list [.ref row, .scalar (.int invalid)]))
    (rowFound : heap[row]? = some (.tuple [.scalar key, value]))
    (saved : SavedCell privateAddress privateObject heap) :
    SavedCell privateAddress privateObject ((heap ++ [Mutable.Object.dict []]).set heap.length (.dict [(key, value)])) ∧
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "build") [.ref source], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], (heap ++ [Mutable.Object.dict []]).set heap.length (.dict [(key, value)]), heap.length⟩) := by
  exact ⟨Heapq.preserves_dictionaryConstruct _ (SavedCell.allocates privateAddress privateObject) [.ref source]
    heap _ _ saved (partial_insertion heap source row key value invalid found rowFound),
    partial_failure_source heap source row key value invalid found rowFound⟩

theorem mutation_failure_private_cell (heap : Mutable.Heap) (address privateAddress : Nat)
    (items : List Mutable.Value) (value : Mutable.Value) (privateObject : Mutable.Object)
    (found : heap[address]? = some (.list items)) (saved : SavedCell privateAddress privateObject heap)
    (separate : address ≠ privateAddress) :
    SavedCell privateAddress privateObject (inserted heap address items value ++ [.dict []]) ∧
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "nested") [.ref address, value, .scalar .none], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], inserted heap address items value ++ [.dict []], heap.length⟩) := by
  have kept := appendItem_preserves_cell privateAddress address privateObject value separate
    heap (.ok (.scalar .none)) (inserted heap address items value) saved
    (by simp [Mutable.appendItem, found, inserted, Except.map])
  exact ⟨Heapq.preserves_dictionaryConstruct _ (SavedCell.allocates privateAddress privateObject) [.scalar .none]
    (inserted heap address items value) (.error ⟨"TypeError", []⟩) _ kept (by rfl),
    failure_retains_mutation_and_allocation heap address items value found⟩

/-- Dictionary construction uses the proved output of an earlier mutation, under arbitrary saved consumers. -/
theorem append_then_dictionary (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (values : List Mutable.Value) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨.operation (.builtin .dict) values, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running
          ⟨⟨.operation (.builtin .dict) values, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running
            ⟨⟨.operation (.builtin .dict) values, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_dictionaryConstruct_preserves Probe.module choices _ other nextMap
    logical.length physical.length used values stack resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end MachineDictionaryConstructionExamples
'''
AUDITS = ["FormalSW.PyAst.Mutable.Relocation." + name for name in (
    "RuntimeLayout.dictionaryIterable",
    "dictionaryIterable_heap",
    "dictionaryIterable_bounded",
    "ExecutionLayout.dictionaryInsertRow",
    "ExecutionLayout.dictionaryInsertRows",
    "dictionaryFromIterable_eq",
    "ExecutionLayout.dictionaryFromIterable",
)] + ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "result_appendObject_preserves",
    "result_dictionaryFromIterable_preserves",
    "dictionaryConstruct_ref",
    "result_dictionaryConstruct_preserves",
    "step_dictionaryConstruct_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation." + name for name in (
    "step_dictionaryConstruct_preserves",
)] + ["MachineDictionaryConstructionExamples." + name for name in (
    "calls_equiv",
    "recorded_returns",
    "dict_nested_returns",
    "dict_explicit_returns",
    "dict_equiv",
    "keyDict_nested_returns",
    "keyDict_explicit_returns",
    "keyDict_equiv",
    "failure_retains_mutation_and_allocation",
    "partial_insertion",
    "partial_failure_source",
    "partial_failure_private_cell",
    "mutation_failure_private_cell",
    "append_then_dictionary",
)]
with project_temporary_directory(prefix="machine-dictionary-construction-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for form in ("nested", "explicit"):
        run = namespace[form]
        for key in (None, True, -10**100, "shared", (1, "tuple")):
            log = []
            data = {key: log}
            result = run(log, data, data)
            assert result is not data and result[key] is log and log[0] is data
            assert next(iter(result)) is next(iter(data))
            data["later"] = data
            assert "later" not in result
        log = []
        result = run(log, log, [("a", log), ("b", log), ("a", 9)])
        assert list(result) == ["a", "b"] and result["a"] == 9 and result["b"] is log
        assert log[0] is log
        for data, expected in ((None, TypeError), ([(1, 2), 3], TypeError), ([(1, 2), ()], ValueError), ([(1, 2), ([], 3)], TypeError)):
            log = []
            try:
                run(log, log, data)
            except expected:
                assert len(log) == 1 and log[0] is log
            else:
                raise AssertionError((form, data))
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.MachineDictionaryConstruction\n"
        "import lang.py.FormalSW.ConstructionMachineFrame\n"
        "import lang.py.FormalSW.IteratorRules\n"
        "import lang.py.FormalSW.DictionaryConstructorCalls\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"dictionary construction: shallow aliases, allocation before failure, partial insertion and saved consumers; {len(AUDITS)} axiom audits passed")

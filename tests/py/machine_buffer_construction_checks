#!/usr/bin/env python3
"""
Check buffer allocation, argument mutations, conversion failures and saved consumers.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def recorded(log, value, data):
    log.append(value)
    return data


def bytes_nested(log, value, data):
    return bytes(recorded(log, value, data))


def bytes_explicit(log, value, data):
    log.append(value)
    return bytes(data)


def bytes_copy(data):
    return bytes(data)


def bytearray_nested(log, value, data):
    return bytearray(recorded(log, value, data))


def bytearray_explicit(log, value, data):
    log.append(value)
    return bytearray(data)


def bytearray_copy(data):
    return bytearray(data)
'''
PROOF = r'''

open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
namespace MachineBufferConstructionExamples
set_option Elab.async false

def inserted (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) : Mutable.Heap :=
  heap.set address (.list (items ++ [value]))

theorem calls_equiv (left right : String) (arguments : List Mutable.Value) (heap after : Mutable.Heap) (answer : Mutable.Value)
    (leftReturns : ReturnsValue Probe.module left arguments heap answer after)
    (rightReturns : ReturnsValue Probe.module right arguments heap answer after) :
    (IteratorCalls.call Probe.module left arguments heap).Equiv (IteratorCalls.call Probe.module right arguments heap) := by
  have finishes (name : String) (choices : ChoiceSchedule) (returned : ReturnsValue Probe.module name arguments heap answer after) :
      ((IteratorCalls.call Probe.module name arguments heap).run choices).Finishes ⟨.ok answer, [], after, heap.length⟩ := by
    have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0) (returned heap.length []) []
    exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))
  intro leftChoices rightChoices
  exact Mutable.Call.equiv_of_finishes (finishes left leftChoices leftReturns) (finishes right rightChoices rightReturns) (Or.inl rfl)

theorem recorded_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "recorded" [.ref address, value, data] heap (data)
      (inserted heap address items value) := by
  unfold inserted
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  exact BlockReturns.return_value (Evaluates.lookup rfl)

theorem bytes_nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "bytes_nested" [.ref address, value, .scalar (.bytes data)] heap
      (.scalar (.bytes data)) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons
    (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
      (recorded_returns heap address items value (.scalar (.bytes data)) found)) .nil)
  rfl

theorem bytes_explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "bytes_explicit" [.ref address, value, .scalar (.bytes data)] heap
      (.scalar (.bytes data)) (inserted heap address items value) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  rfl

theorem bytes_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    (IteratorCalls.call Probe.module "bytes_nested" [.ref address, value, .scalar (.bytes data)] heap).Equiv
      (IteratorCalls.call Probe.module "bytes_explicit" [.ref address, value, .scalar (.bytes data)] heap) :=
  calls_equiv _ _ _ _ _ _ (bytes_nested_returns heap address items value data found) (bytes_explicit_returns heap address items value data found)

theorem bytes_copy_returns (heap : Mutable.Heap) (address : Nat) (data : List UInt8)
    (found : heap[address]? = some (.bytearray data)) :
    ReturnsValue Probe.module "bytes_copy" [.ref address] heap (.scalar (.bytes data)) (heap) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  simp [primitive, Mutable.bytes, Mutable.byteValues, found, Mutable.eval_bind, Mutable.eval_map]
  rfl

theorem bytes_failed_conversion (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (text : String) :
    primitive (.builtin .bytes) [.scalar (.string text)] (inserted heap address items value) =
      some (.error ⟨"TypeError", []⟩, inserted heap address items value) := by
  rfl

theorem bytearray_nested_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "bytearray_nested" [.ref address, value, .scalar (.bytes data)] heap
      (.ref (inserted heap address items value).length) (inserted heap address items value ++ [.bytearray data]) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons
    (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
      (recorded_returns heap address items value (.scalar (.bytes data)) found)) .nil)
  rfl

theorem bytearray_explicit_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "bytearray_explicit" [.ref address, value, .scalar (.bytes data)] heap
      (.ref (inserted heap address items value).length) (inserted heap address items value ++ [.bytearray data]) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  rfl

theorem bytearray_equiv (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) (data : List UInt8)
    (found : heap[address]? = some (.list items)) :
    (IteratorCalls.call Probe.module "bytearray_nested" [.ref address, value, .scalar (.bytes data)] heap).Equiv
      (IteratorCalls.call Probe.module "bytearray_explicit" [.ref address, value, .scalar (.bytes data)] heap) :=
  calls_equiv _ _ _ _ _ _ (bytearray_nested_returns heap address items value data found) (bytearray_explicit_returns heap address items value data found)

theorem bytearray_copy_returns (heap : Mutable.Heap) (address : Nat) (data : List UInt8)
    (found : heap[address]? = some (.bytearray data)) :
    ReturnsValue Probe.module "bytearray_copy" [.ref address] heap (.ref heap.length) (heap ++ [.bytearray data]) := by
  apply BlockReturns.function rfl rfl
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  simp [primitive, Mutable.bytearray, Mutable.byteValues, found, Mutable.eval_bind, Mutable.eval_map, Mutable.allocateBuffer]
  rfl

theorem bytearray_failed_conversion (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (text : String) :
    primitive (.builtin .bytearray) [.scalar (.string text)] (inserted heap address items value) =
      some (.error ⟨"TypeError", []⟩, inserted heap address items value) := by
  rfl

theorem bytes_failure_retains_mutation (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (text : String) (found : heap[address]? = some (.list items)) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "bytes_nested") [.ref address, value, .scalar (.string text)], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], inserted heap address items value, heap.length⟩) := by
  repeat first
    | apply (Evaluates.arguments_reach (.cons
        (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
          (recorded_returns heap address items value (.scalar (.string text)) found)) .nil)
        (.builtin .bytes) [] heap.length []).finishes
    | exact .done rfl
    | refine .next rfl ?_

theorem bytearray_failure_retains_mutation (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value)
    (value : Mutable.Value) (text : String) (found : heap[address]? = some (.list items)) :
    Finishes (HeapCalls.step Probe.module heap.length)
      ⟨.operation (.call "bytearray_nested") [.ref address, value, .scalar (.string text)], [], heap⟩
      (.ok ⟨.error ⟨"TypeError", []⟩, [], inserted heap address items value, heap.length⟩) := by
  repeat first
    | apply (Evaluates.arguments_reach (.cons
        (Evaluates.call (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) (.cons (Evaluates.lookup rfl) .nil)))
          (recorded_returns heap address items value (.scalar (.string text)) found)) .nil)
        (.builtin .bytearray) [] heap.length []).finishes
    | exact .done rfl
    | refine .next rfl ?_

/-- Buffer construction uses the proved output of an earlier mutation, under arbitrary saved consumers. -/
theorem append_then_buffer (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (operation : Operation) (covered : BufferConstructionOperation operation) (values : List Mutable.Value) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨.operation operation values, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running
          ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running
            ⟨⟨.operation operation values, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_bufferConstruction_preserves Probe.module choices _ other nextMap
    logical.length physical.length used operation values stack resumes []
    (by simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]) retained covered
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end MachineBufferConstructionExamples
'''
AUDITS = ["FormalSW.PyAst.Mutable.Relocation." + name for name in (
    "RuntimeLayout.bytesElement",
    "bytesElement_heap",
    "RuntimeLayout.bytesElements_pair",
    "RuntimeLayout.bytesElements",
    "bytesElements_heap",
)] + ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "result_bytesEncode_preserves",
    "result_byteValuesEncode_preserves",
    "bytes_ref",
    "bytes_many",
    "result_bytes_preserves",
    "result_bytearrayCopy_preserves",
    "result_bytearray_preserves",
    "step_bufferConstruction_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation." + name for name in (
    "step_bufferConstruction_preserves",
)] + ["MachineBufferConstructionExamples." + name for name in (
    "bytearray_failure_retains_mutation",
    "bytes_failure_retains_mutation",
    "calls_equiv",
    "recorded_returns",
    "bytes_nested_returns",
    "bytes_explicit_returns",
    "bytes_equiv",
    "bytes_copy_returns",
    "bytes_failed_conversion",
    "bytearray_nested_returns",
    "bytearray_explicit_returns",
    "bytearray_equiv",
    "bytearray_copy_returns",
    "bytearray_failed_conversion",
    "append_then_buffer",
)]
with project_temporary_directory(prefix="machine-buffer-construction-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    for kind in ("bytes", "bytearray"):
        for form in ("nested", "explicit"):
            run = namespace[f"{kind}_{form}"]
            for data in (b"", b"\x00\xff", bytes(range(256)), bytearray(range(256)), [], [0, True, 255]):
                log = []
                result = run(log, log, data)
                assert len(log) == 1 and log[0] is log
                assert type(result).__name__ == kind and result == bytes(data)
                if isinstance(data, bytearray):
                    assert result is not data
                    data[0] = 99
                    assert result[0] == 0
            for data, expected in (("text", TypeError), ([0, 256], ValueError), ([0, -1], ValueError), ([0, "bad"], TypeError)):
                log = []
                try:
                    run(log, log, data)
                except expected:
                    assert len(log) == 1 and log[0] is log
                else:
                    raise AssertionError((kind, form, data))
        data = bytearray(b"ab")
        result = namespace[f"{kind}_copy"](data)
        assert result is not data
        data[0] = 99
        assert result == b"ab"
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.MachineBufferConstruction\n"
        "import lang.py.FormalSW.IteratorRules\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"buffer construction: argument effects, fresh copies, conversion failures and saved consumers; {len(AUDITS)} axiom audits passed")

#!/usr/bin/env python3
"""
Compare list and bytearray pop with Python, retaining aliases and argument effects.
"""
import ast
import itertools
import json
from pathlib import Path
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
from lang.py.call_support import uses_heap_calls
from lang.py.object_snapshot import snapshot_roots
from lang.py.support import SupportChecker

api = runpy.run_path(str(ROOT / 'formalsw'))


def constant(value):
    if value is None:
        return '.none'
    if type(value) is bool:
        return '.bool ' + str(value).lower()
    if type(value) is int:
        return f'.int ({value})'
    if type(value) is bytes:
        return '.bytes [' + ', '.join(map(str, value)) + ']'
    return '.string ' + json.dumps(value, ensure_ascii=False)


def data(value):
    if type(value) is list:
        return '.list [' + ', '.join(map(data, value)) + ']'
    return '.scalar (' + constant(value) + ')'


source = '''
def take(xs: list[int], index: int):
    return xs.pop(index)
def last(xs: list[int]):
    return xs.pop()
def touch(xs: list[int]):
    xs.append(9)
    return -1
def effect(xs: list[int]):
    return xs.pop(touch(xs))
def shrink(xs: list[int]):
    xs.pop()
    return 0
def shrinking(xs: list[int]):
    return xs.pop(shrink(xs))
def bad_index(xs: list[int]):
    xs.append(3)
    return "bad index"
def invalid(xs: list[int]):
    return xs.pop(bad_index(xs))
def fail(xs: list[int]):
    xs.append(3)
    raise ValueError()
def argument_error(xs: list[int]):
    return xs.pop(fail(xs))
def excess(xs: list[int]):
    return xs.pop(touch(xs), touch(xs))
def missing(xs: list[int]):
    n = 3
    return n.pop(touch(xs))
def nested(xs: list[int]):
    both = [xs, xs]
    result = both.pop(0)
    result.append(7)
    return [both, result]
def cycle(xs: list[int]):
    xs.append(xs)
    return xs.pop()
def replace(holder: list[list[int]]):
    holder[0] = [99]
    return 0
def captured(xs: list[int]):
    holder = [xs]
    result = holder[0].pop(replace(holder))
    return [result, holder]
def tuple_missing(xs: list[int]):
    return (xs, xs).pop(touch(xs))
def byte_take(xs: bytearray, index: int):
    return xs.pop(index)
def byte_last(xs: bytearray):
    return xs.pop()
def byte_effect(xs: bytearray):
    return xs.pop(touch(xs))
'''
program = ast.parse(source)
checker = SupportChecker(program)
for function in program.body:
    assert not checker.check(function.name, heap_calls=True), function.name
probe = ast.parse('def f(n: int):\n    return n.pop()\n')
assert uses_heap_calls(probe, probe.body[0])
world = {}
exec(source, world)
lines = ['import FormalSW', 'open FormalSW.PyAst', 'set_option maxRecDepth 8192',
         'def source : Module := pyast_from_json% (include_str "source.json")']
count = 0


def compare(name, arguments, heap, actual, anchors):
    global count
    try:
        result = world[name](*actual)
        error = None
    except (TypeError, ValueError, IndexError, AttributeError) as exception:
        result, error = None, type(exception).__name__
    expected = data(snapshot_roots(anchors + ([result] if error is None else [])))
    call = f'HeapCalls.call source "{name}" [{arguments}] {heap}'
    outcome = ('match c.outcome with | .ok _ => true | _ => false' if error is None else
               f'match c.outcome with | .error e => decide (e = ⟨"{error}", []⟩) | _ => false')
    lines.extend([
        f'-- {name}, case {count}',
        f'example : (match ({call}).execution.observe 1000 with',
        f'  | .done (.ok c) => ({outcome}) &&',
        f'      (Graph.observedBool ((Graph.compare c.snapshot ({expected})).observe 5000) == some true)',
        '  | _ => false) = true := by native_decide',
    ])
    count += 1


cases = [[], [None, True, 1, "λ", b"a"], [2]]
cases += [list(values) for values in itertools.product((-2, 0, 1), repeat=2)]
for initial in cases:
    heap = '[.list [' + ', '.join('.scalar (' + constant(x) + ')' for x in initial) + ']]'
    for index in (-8, -len(initial), -1, 0, 1, len(initial), 8, True, False, None, "x"):
        value = initial.copy()
        compare('take', '.ref 0, .scalar (' + constant(index) + ')', heap, [value, index], [value])
    for name in ('last', 'effect', 'shrinking', 'invalid', 'argument_error', 'excess',
                 'missing', 'nested', 'cycle', 'captured', 'tuple_missing'):
        value = initial.copy()
        compare(name, '.ref 0', heap, [value], [value])
for initial in ([], [3], [0, 1, 255]):
    heap = '[.bytearray [' + ', '.join(map(str, initial)) + ']]'
    for index in (-8, -1, 0, 1, 8, True, False, None):
        value = bytearray(initial)
        compare('byte_take', '.ref 0, .scalar (' + constant(index) + ')', heap, [value, index], [value])
    for name in ('byte_last', 'byte_effect'):
        value = bytearray(initial)
        compare(name, '.ref 0', heap, [value], [value])

module = ast.parse('def f(xs: list[int]):\n    return xs.pop(index=0)\n')
assert SupportChecker(module).check('f')
lines.append('example : Mutable.popItem 0 (.ref 1) [.list [], .instance "source" "Index" []] = none := by decide')
with project_temporary_directory(prefix='pop-checks-') as directory:
    directory = Path(directory)
    (directory / 'source.json').write_text(api['AstJsonEmitter'](program).emit())
    proof = directory / 'Checks.lean'
    proof.write_text('\n'.join(lines) + '\n')
    subprocess.run(['lake', 'env', 'lean', '-DwarningAsError=true', str(proof)], cwd=ROOT, check=True)

print(f'{count} pop Python comparisons passed, including receiver binding, aliases, and exceptions')

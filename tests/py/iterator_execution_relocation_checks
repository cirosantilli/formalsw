#!/usr/bin/env python3
"""
Check complete execution transport, growing layouts and saved iterator states.
"""
from pathlib import Path
import re
import runpy
import subprocess
import sys

from test_support import project_temporary_directory

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))
api = runpy.run_path(str(ROOT / "formalsw"))
SOURCE = '''
def attach(items, value):
    items.append(value)
    return list(items)


def countdown(n, value):
    while n:
        n -= 1
    return value
'''
PROOF = r'''
open FormalSW.PyAst HeapCalls Mutable.Relocation HeapCalls.Relocation
namespace IteratorExecutionExamples
set_option Elab.async false

theorem source : IteratorCalls.Relocation.ModuleSource Probe.module := by
  simp [IteratorCalls.Relocation.ModuleSource, Probe.module, StmtWithin]

def appended (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) : Mutable.Heap :=
  heap.set address (.list (items ++ [value]))
def copied (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value) : Mutable.Heap :=
  appended heap address items value ++ [.list (items ++ [value])]

theorem attach_returns (heap : Mutable.Heap) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value)
    (found : heap[address]? = some (.list items)) :
    ReturnsValue Probe.module "attach" [.ref address, value] heap (.ref heap.length) (copied heap address items value) := by
  have valid := (List.getElem?_eq_some_iff.mp found).1
  have updated : (appended heap address items value)[address]? = some (.list (items ++ [value])) := by
    simp [appended, valid]
  apply BlockReturns.function rfl rfl
  apply BlockReturns.discard (Evaluates.append (Evaluates.lookup rfl) found (Evaluates.lookup rfl) found)
  apply BlockReturns.return_value
  apply Evaluates.builtin (.cons (Evaluates.lookup rfl) .nil)
  simpa [copied, appended] using primitive_list_list (appended heap address items value) address (items ++ [value]) updated

theorem attach_finishes (choices : ChoiceSchedule) (heap : Mutable.Heap) (address : Nat)
    (items : List Mutable.Value) (value : Mutable.Value) (found : heap[address]? = some (.list items)) :
    ((IteratorCalls.call Probe.module "attach" [.ref address, value] heap).run choices).Finishes
      ⟨.ok (.ref heap.length), [], copied heap address items value, heap.length⟩ := by
  have reached := IteratorCalls.Reaches.of_heap (choices := choices) (used := 0)
    (attach_returns heap address items value found heap.length []) []
  exact reached.finishes (.next (IteratorCalls.core_done rfl rfl) (.done rfl))

/-- The physical execution is derived from the logical run, even with private objects between shared ones. -/
theorem relocated_attach (choices : ChoiceSchedule) (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value) (value : Mutable.Value)
    (found : logical[address]? = some (.list items)) (valueInside : value.edge.Within logical.length) :
    ∃ other nextMap,
      IteratorCalls.Relocation.ExtendedLayout logical.length physical.length rename
        (copied logical address items value) other nextMap ∧
      ((IteratorCalls.call Probe.module "attach" [.ref (rename address), relocateValue rename value] physical).run choices).Finishes
        (relocateCompletion nextMap other physical.length
          ⟨.ok (.ref logical.length), [], copied logical address items value, logical.length⟩) := by
  have argumentsInside : ∀ argument ∈ [.ref address, value], argument.edge.Within logical.length := by
    intro argument member
    rcases List.mem_cons.mp member with rfl | member
    · exact (List.getElem?_eq_some_iff.mp found).1
    · simpa only [List.mem_singleton.mp member] using valueInside
  have paired := IteratorCalls.Relocation.call_bisimulation Probe.module choices "attach" [.ref address, value]
    logical physical rename [] source layout argumentsInside (by simp [GlobalsWithin])
  obtain ⟨outcome, related, finished⟩ := paired.finishes (attach_finishes choices logical address items value found)
  obtain ⟨after, other, nextMap, extended, heap, _, same⟩ := related
  have equal : copied logical address items value = after := heap
  subst after
  exact ⟨other, nextMap, extended, by simpa only [same, Except.map] using finished⟩

/-- Signed countdown arguments include terminating and divergent runs; neither is assumed to finish. -/
theorem countdown_modes (choices : ChoiceSchedule) (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (n : Int) (value : Mutable.Value)
    (valueInside : value.edge.Within logical.length) :
    let left := ((IteratorCalls.call Probe.module "countdown" [.scalar (.int n), value] logical).run choices).execution
    let right := ((IteratorCalls.call Probe.module "countdown" [.scalar (.int n), relocateValue rename value] physical).run choices).execution
    (left.Halts ↔ right.Halts) ∧ (left.Diverges ↔ right.Diverges) ∧ (left.Supported ↔ right.Supported) := by
  have inside : ∀ argument ∈ [.scalar (.int n), value], argument.edge.Within logical.length := by
    intro argument member
    rcases List.mem_cons.mp member with rfl | member
    · trivial
    · simpa only [List.mem_singleton.mp member] using valueInside
  have paired := IteratorCalls.Relocation.call_bisimulation Probe.module choices "countdown" [.scalar (.int n), value]
    logical physical rename [] source layout inside (by simp [GlobalsWithin])
  exact ⟨paired.halts_iff, paired.diverges_iff, paired.supported_iff⟩

/-- A preceding mutation composes with every following work state and saved iterator consumer. -/
theorem append_then_state (logical physical : Mutable.Heap) (rename : Nat → Nat)
    (layout : ExecutionLayout logical physical rename) (address : Nat) (items : List Mutable.Value)
    (item : Mutable.Value) (work : Work) (stack : List Frame)
    (used : Nat) (choices : ChoiceSchedule) (resumes : List IteratorCalls.Resume)
    (found : logical[address]? = some (.list items)) (itemInside : item.edge.Within logical.length)
    (inside : StateWithin ⟨work, stack, logical⟩)
    (saved : ∀ pending ∈ resumes, IteratorCalls.Relocation.ResumeWithin logical.length pending) :
    let updated := logical.set address (.list (items ++ [item]))
    ∃ other nextMap,
      (∀ previous < logical.length, nextMap previous = rename previous) ∧
      ExecutionLayout updated other nextMap ∧
      HeapCalls.step Probe.module physical.length
        (relocateState rename physical ⟨.operation (.append address) [item], [], logical⟩) =
        .next (relocateState nextMap other ⟨.value (.scalar .none), [], updated⟩) ∧
      IteratorCalls.Relocation.Preserves updated other nextMap physical.length
        (IteratorCalls.step Probe.module logical.length choices (.running ⟨⟨work, stack, updated⟩, used⟩ resumes))
        (IteratorCalls.step Probe.module physical.length choices
          (IteratorCalls.Relocation.relocateState nextMap other physical.length (.running ⟨⟨work, stack, updated⟩, used⟩ resumes))) := by
  dsimp only
  have globalsInside : GlobalsWithin logical.length [] := by simp [GlobalsWithin]
  have preserved := step_append_list_preserves Probe.module logical physical rename logical.length physical.length
    address items item [] [] layout found itemInside (by simp) globalsInside
  have stepped : HeapCalls.step Probe.module logical.length ⟨.operation (.append address) [item], [], logical⟩ =
      .next ⟨.value (.scalar .none), [], logical.set address (.list (items ++ [item]))⟩ := by
    change protectGenerator [] (result logical.length logical (Mutable.appendItem address item) []) = _
    simp [result, HeapCalls.run, Mutable.appendItem, found, Except.map]
  rw [stepped] at preserved
  obtain ⟨other, nextMap, agree, larger, _, retained, _, nextGlobals, _, paired⟩ := preserved.next [] globalsInside
  refine ⟨other, nextMap, agree, retained, paired, ?_⟩
  exact IteratorCalls.Relocation.step_complete_preserves Probe.module choices
    (.running ⟨⟨work, stack, _⟩, used⟩ resumes) _ other nextMap logical.length physical.length [] source retained rfl
    ⟨inside.1.mono larger, (fun frame member => (inside.2 frame member).mono larger),
      fun pending member => IteratorCalls.Relocation.ResumeWithin.mono (saved pending member) larger⟩ nextGlobals

end IteratorExecutionExamples
'''
AUDITS = ["FormalSW.PyAst.HeapCalls.Relocation." + name for name in (
    "step_identity_arguments_preserves", "step_builtin_preserves", "step_operation_preserves", "step_complete_preserves",
)] + ["FormalSW.PyAst.IteratorCalls.Relocation." + name for name in (
    "step_builtin_preserves", "step_operation_preserves", "step_complete_preserves",
    "execution_transition", "execution_bisimulation", "call_bisimulation", "reaches_relocates",
)] + ["IteratorExecutionExamples." + name for name in (
    "source", "attach_returns", "attach_finishes", "relocated_attach", "countdown_modes", "append_then_state",
)]
with project_temporary_directory(prefix="iterator-execution-relocation-") as temporary:
    directory = Path(temporary)
    path = directory / "source.py"
    path.write_text(SOURCE)
    module = api["source_module"](path)
    namespace = {}
    exec(compile(SOURCE, str(path), "exec"), namespace)
    items = []
    copied = namespace["attach"](items, items)
    assert copied is not items and copied[0] is items and items[0] is items
    token = object()
    for n in (0, 1, 50):
        assert namespace["countdown"](n, token) is token
    document = directory / "source.json"
    document.write_text(api["AstJsonEmitter"](module).emit())
    checked_source = directory / "Checks.lean"
    checked_source.write_text(
        "import lang.py.FormalSW.IteratorExecutionRelocation\n"
        "import lang.py.FormalSW.IteratorRules\n"
        + api["AstLeanBridgeEmitter"](document, "Probe", module).emit() + PROOF
        + "\n".join(f"#print axioms {name}" for name in AUDITS) + "\n"
    )
    checked = subprocess.run(
        ["lake", "env", "lean", "-M4096", "-j1", "-DElab.async=false",
         "-DwarningAsError=true", "-DrelaxedAutoImplicit=false", str(checked_source)],
        cwd=ROOT, capture_output=True, text=True,
    )
    assert checked.returncode == 0, checked.stdout + checked.stderr
    audits = re.findall(r"depends on axioms:\s*\[([^\]]*)\]", checked.stdout)
    independent = checked.stdout.count("does not depend on any axioms")
    assert len(audits) + independent == len(AUDITS), checked.stdout
    for audit in audits:
        assert {name.strip() for name in audit.split(",")} <= {
            "propext", "Classical.choice", "Quot.sound"
        }, checked.stdout
print(f"whole execution relocation: mutations, allocation, saved states and all termination modes; {len(AUDITS)} axiom audits passed")
